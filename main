 bar - finish this station yourself",6)end end else j.trainSince=nil end end)end if j.NoClip and n-B.clip>=.25 then B.clip=n pcall(function()local n=W.Character if not n then return end local k=n:GetChildren()for n=1,#k,1 do local E=k[n]if((E.ClassName=="Part"or E.ClassName=="MeshPart"))and E.Name~="HumanoidRootPart"then E.CanCollide=false end end end)end if j.Mode~="off"and(n-((B.survey or 0)))>10 then B.survey=n pcall(function()C.scan(nil,nil)end)end pcall(C.seenSave,n)if j.AntiAFK and n-B.afk>=120 then B.afk=n pcall(function()mousemoverel(2,0)mousemoverel(-2,0)end)end end function C.busy()return j.Mode~="off"or j.collect~=nil or j.lootPhase~=nil or j.AutoLoot or j.AutoTrain or j.NoClip or j.AntiAFK or C.espOn()end function C.sync()C.espSync()pcall(C.fishSync)pcall(C.syncSkills)if C.busy()then if not j.tickConn then j.tickConn=E.Heartbeat:Connect(V)end elseif j.tickConn then pcall(function()j.tickConn:Disconnect()end)j.tickConn=nil C.aimRelease()pcall(C.skillsRelease)j.cur=nil C.dropCache()end end pcall(C.seenLoad)pcall(function()D:LoadSettings()end)C.sync()C.notify("loaded - rshift for the menu",4)print("[Slayers 2] loaded")
