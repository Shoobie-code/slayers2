,"..math.floor(e))))))))T.notify("crow: taking "..Z.boss,3)elseif r>=((C.deadline or 0))then C.phase="idle"C.nextAt=r+2 T.notify("crow: no boss offer found, retrying",4)end return nil end if C.phase=="quest"then local Z=s and s.Name~=C.prevQuest if s and(not s.Complete and((Z or(C.target and T.questMatchesEntry(s.Name,C.target)))))then p.crowAim=C.aim or 1 C.quest=s.Name C.phase="fight"C.lastAlive=r if#T.crowChoices()>0 then T.crowClose(r)end T.notify("crow: hunting "..tostring(C.target),3)elseif r>=((C.deadline or 0))then if#T.crowChoices()>0 and((C.aim or 1))<5 then pcall(T.crowDump)C.aim=((C.aim or 1))+1 C.phase="menu"C.menuAt=r+.4 C.deadline=r+8 return nil end T.crowClose(r)C.aim=nil C.target=nil C.phase="idle"C.nextAt=r+3 end return nil end if not s or(s.Name==C.quest and s.Complete)then C.target,C.quest,C.phase,C.nextAt=nil,nil,"idle",r+1 T.notify("crow: boss quest done, next one",3)return nil end return C.target end function T.scrOffset(r)if p.scrOffX then return true end local C=n:GetMouse()if not p.scrCalT then p.scrMx,p.scrMy=C.X,C.Y pcall(function()mousemoveabs(700,450)end)p.scrCalT=r return false end if r-p.scrCalT<.12 then return false end p.scrOffX,p.scrOffY=700-C.X,450-C.Y pcall(function()mousemoveabs(p.scrMx+p.scrOffX,p.scrMy+p.scrOffY)end)return true end function T.dlgRoot()local r=n:FindFirstChild("PlayerGui")local C=r and r:FindFirstChild("ComponentsHolder")return C and C:FindFirstChild("DialogueFrame")or nil end local function Y(r,C)C=C or 0 if C>6 then return nil end for r,s in ipairs(r:GetChildren())do local Z,n pcall(function()Z=s.Text end)pcall(function()n=s.AbsolutePosition end)if Z and(Z~=""and n)then return Z,n end local e,p=Y(s,C+1)if e then return e,p end end return nil end function T.dlgAnswers(r)local C={}local s=r and r:FindFirstChild("ButtonHolder",true)if not s then local function C(r,s)if s>5 then return nil end for r,Z in ipairs(r:GetChildren())do if Z.Name=="ButtonHolder"then return Z end local n=C(Z,s+1)if n then return n end en