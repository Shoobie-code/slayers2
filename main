target*3 then f.guard=L local N=x.wantSpawn(z)if N then x.tpTo(N,3)elseif L-((f.nodest or 0))>12 then f.nodest=L local N=(type(z)=="table")and x.bossLabel()or tostring(z)x.notify("no known spot for "..(N.." - find it once and it is remembered"),6)end end return end local P=x.nearest(h,Y.Position)if not P then return end P.want=z P.wantKey=j P.t=L i.cur=P x.attack(L)end local function g()if not i.Running then return end local L=os.clock()if i.route then local N,Y=pcall(x.routeStep,L)if N and Y then return end if not N then x.routeStop()end end if i.collect then if pcall(x.collectStep,L)then return end end if i.AutoLoot and(not i.collect and(not i.lootPhase and(not i.route and(L-((f.loot or 0)))>2.0)))then f.loot=L local N,Y=x.char()if Y then local L=x.lootNear(Y.Position,i.LootRange)if#L>0 then x.collectStart(L,"loot")end end end if i.pendingLoot and(L-i.pendingLoot.t)>1.0 then i.lootPhase={pos=i.pendingLoot.pos;t0=L;last=L}i.pendingLoot=nil x.notify("boss down, collecting drops",3)end if i.lootPhase then local N=i.lootPhase local Y=x.lootNear(N.pos,90)local S,z={},{}for L=1,#Y,1 do if Y[L].tap then S[#S+1]=Y[L]else z[#z+1]=Y[L]end end if#S>0 then N.last=L x.collectStart(S,"boss chest")return end if#z>0 and((N.passes or 0))<4 then N.last=L N.passes=((N.passes or 0))+1 if x.routeStart(z)then return end end if(L-N.last)>i.LootWait or(L-N.t0)>45 then i.lootPhase=nil x.notify("drops done, next boss",2)else x.travelTo(N.pos,L)return end end if L-f.key>=.1 then f.key=L if iskeypressed and iskeypressed(i.PanicVK)then if i.Mode~="off"or i.AutoTrain or i.collect then x.panic()end end end if i.follow and not i.cur then pcall(x.followStep,L)end if i.Mode~="off"and i.cur then pcall(x.steer)local N pcall(function()local L=i.cur.Model and i.cur.Model:FindFirstChild("Head")N=(L and L.Position)or i.cur.Root.Position end)pcall(x.aimStep,N)local Y,S=x.char()if S and N then local Y=((N-S.Position)).Magnitude pcall(x.skillStep,L,Y)end else x.aimRelease()pcall(x.skillsRelease)end if L-f.farm>=i.AttackDelay then f.farm=L pcall(E,L)end if x.espOn()and L-f.esp>=.35 then f.esp=L pcall(x.espBuild)end if i.AutoTrain and(not i.AutoFish and(not i.collect and L-f.train>=1.5))then f.train=L pcall(function()local Y=N:FindFirstChild("Player_Service")local S=Y and Y:FindFirstChild("Values")local G=S and S:FindFirstChild(z.Name)if not G then return end if G:FindFirstChild("Training")then if x.remote then x.remote:FireServer("training_signaler","Stop",true)else i.trainSince=i.trainSince or L local N=i.bar if not((N and N.active))and(L-i.trainSince>5 and L-((i.trainWarn or 0))>30)then i.trainWarn=L x.notify("click mode only plays the Squat bar - finish this station yourself",6)end end else i.trainSince=nil end end)end if i.NoClip and L-f.clip>=.25 then f.clip=L pcall(function()local L=z.Character if not L then return end local N=L:GetChildren()for L=1,#N,1 do local Y=N[L]if((Y.ClassName=="Part"or Y.ClassName=="MeshPart"))and Y.Name~="HumanoidRootPart"then Y.CanCollide=false end end end)end if i.Mode~="off"and(L-((f.survey or 0)))>10 then f.survey=L pcall(function()x.scan(nil,nil)end)end pcall(x.seenSave,L)if i.AntiAFK and L-f.afk>=120 then f.afk=L pcall(function()mousemoverel(2,0)mousemoverel(-2,0)end)end end function x.busy()return i.Mode~="off"or i.collect~=nil or i.route~=nil or i.lootPhase~=nil or i.AutoLoot or i.AutoTrain or i.NoClip or i.AntiAFK or x.espOn()end function x.sync()x.espSync()pcall(x.fishSync)pcall(x.syncSkills)if x.busy()then if not i.tickConn then i.tickConn=Y.Heartbeat:Connect(g)end elseif i.tickConn then pcall(function()i.tickConn:Disconnect()end)i.tickConn=nil x.aimRelease()pcall(x.skillsRelease)i.cur=nil x.dropCache()end end pcall(x.seenLoad)pcall(function()V:LoadSettings()end)x.sync()x.notify("loaded - rshift for the menu",4)print("[Slayers 2] loaded")
