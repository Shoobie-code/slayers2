keyrelease(84)end)M.i=M.i+1 M.phase="move"M.t=I M.settle=nil end end return true end function z.lootNear(I,M)local y={}local N=os.clock()local R=m:FindFirstChild("LootDrops")if R then for m,N in ipairs(R:GetChildren())do local R=N:FindFirstChildWhichIsA("BasePart")if N.ClassName=="Part"or N.ClassName=="MeshPart"then R=N end if R then local m if pcall(function()m=((R.Position-I)).Magnitude end)and(m and m<=M)then y[#y+1]={get=function()return R.Position end}end end end end for m,R in ipairs(z.openChests())do local v if pcall(function()v=((R.Root.Position-I)).Magnitude end)and(v and v<=M)then local I=R.Root.Position local M=R.Name..("@"..(math.floor(I.X)..(","..math.floor(I.Z))))local m=C.chestTap[M]if not m or(N-m)>45 then C.chestTap[M]=N local I=R.Root table.insert(y,1,{get=function()return I.Position end,tap=true;side=true})end end end return y end function z.acoPath(I,M)local y=#M if y==0 then return{}end if y==1 then return{1}end local m={[0]=I}for I=1,y,1 do m[I]=M[I]end local N={}for I=0,y,1 do N[I]={}for M=0,y,1 do local y,R=m[I],m[M]local C,v,z=y.X-R.X,y.Y-R.Y,y.Z-R.Z N[I][M]=math.max(math.sqrt((C*C+v*v)+z*z),.01)end end local function R(I)local M,y=0,0 for m=1,#I,1 do M=M+N[y][I[m]]y=I[m]end return M end local C,v,z={},{},0 for I=1,y,1 do local M,m=nil,math.huge for I=1,y,1 do if not v[I]and N[z][I]<m then m=N[z][I]M=I end end v[M]=true C[#C+1]=M z=M end local q=R(C)local j=1/((y*q))local V={}for I=0,y,1 do V[I]={}for M=0,y,1 do V[I][M]=j end end local d,O,F,J=1,3,.2,.9 local k=math.min(20,y+5)local E=y<=8 and 40 or(y<=20 and 30 or 15)for I=1,E,1 do for I=1,k,1 do local M,m,v={},{},0 for I=1,y,1 do local R if math.random()<J then local I=-1 for y=1,y,1 do if not M[y]then local M=V[v][y]^d*((1/N[v][y]))^O if M>I then I=M R=y end end end else local I,m=0,{}for y=1,y,1 do if not M[y]then m[y]=V[v][y]^d*((1/N[v][y]))^O I=I+m[y]end end local C=math.random()*I for I=1,y,1 do if m[I]then C=C-m[I]if C<=0 then R=I break end end end if not R then for I=1,y,1 do if not M[I]then R=I break end end end end V[v][R]=((1-F))*V[v][R]+F*j M[R]=true m[#m+1]=R v=R end local z=R(m)if z<q then q=z C=m end end local M=0 for I=1,#C,1 do local y=C[I]V[M][y]=((1-F))*V[M][y]+F/q M=y end end return C,q end function z.routeStart(I)local M,y=z.char()if not y or not I or#I==0 then return false end local m,N={},{}for M=1,#I,1 do local y,R=pcall(I[M].get)if y and R then m[#m+1]=R N[#N+1]=I[M]end end if#m==0 then return false end local R,v=z.acoPath(y.Position,m)local q={}for I=1,#R,1 do q[I]=N[R[I]]end C.route={list=q,i=1,t=os.clock();tDown=false;nextT=0}z.notify(string.format("boss drops: %d, path %.0f studs",#q,v or 0),3)return true end function z.routeStop()local I=C.route C.route=nil if I and I.tDown then pcall(function()keyrelease(84)end)end end function z.routeStep(I)local M=C.route if not M then return false end local y,m=z.char()if not m then return true end if z.focused(I)and I>=M.nextT then M.nextT=I+C.RouteTap M.tDown=not M.tDown pcall(function()if M.tDown then keypress(84)else keyrelease(84)end end)end local N=M.list[M.i]if not N then z.routeStop()return false end local R if not pcall(function()R=N.get()end)or not R then M.i=M.i+1 M.t=I M.arrive=nil return true end local v=m.Position local q,j,V=R.X-v.X,((R.Y+2.5))-v.Y,R.Z-v.Z local d=math.sqrt((q*q+j*j)+V*V)if d<=3 then M.i=M.i+1 M.t=I if not M.list[M.i]then pcall(function()m.AssemblyLinearVelocity=Vector3.new(0,0,0)end)end return true end if d>C.WarpAbove then pcall(function()m.CFrame=CFrame.new(R.X,R.Y+3,R.Z)m.AssemblyLinearVelocity=Vector3.new(0,0,0)end)else local I=C.MoveSpeed if not M.list[M.i+1]then I=math.min(d*5.0,C.MoveSpeed)end local y=I/d pcall(function()m.AssemblyLinearVelocity=Vector3.new(q*y,j*y,V*y)end)end if I-M.t>5 then M.i=M.i+1 M.t=I end return true end function z.activeQuest()local I=M:FindFirstChild("Player_Service")local y=I and I:FindFirstChild("Data")local m=y and y:FindFirstChild(N.Name)if not m then return nil end local R=m:FindFirstChild("slotEquipped")R=R and R.