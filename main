-m.Position)).Magnitude pcall(z.skillStep,I,y)end else z.aimRelease()pcall(z.skillsRelease)end if I-b.farm>=C.AttackDelay then b.farm=I pcall(o,I)end if z.espOn()and I-b.esp>=.35 then b.esp=I pcall(z.espBuild)end if C.AutoTrain and(not C.AutoFish and(not C.collect and I-b.train>=1.5))then b.train=I pcall(function()local y=M:FindFirstChild("Player_Service")local m=y and y:FindFirstChild("Values")local R=m and m:FindFirstChild(N.Name)if not R then return end if R:FindFirstChild("Training")then if z.remote then z.remote:FireServer("training_signaler","Stop",true)else C.trainSince=C.trainSince or I local M=C.bar if not((M and M.active))and(I-C.trainSince>5 and I-((C.trainWarn or 0))>30)then C.trainWarn=I z.notify("click mode only plays the Squat bar - finish this station yourself",6)end end else C.trainSince=nil end end)end if C.NoClip and I-b.clip>=.25 then b.clip=I pcall(function()local I=N.Character if not I then return end local M=I:GetChildren()for I=1,#M,1 do local y=M[I]if((y.ClassName=="Part"or y.ClassName=="MeshPart"))and y.Name~="HumanoidRootPart"then y.CanCollide=false end end end)end if C.Mode~="off"and(I-((b.survey or 0)))>10 then b.survey=I pcall(function()z.scan(nil,nil)end)end pcall(z.seenSave,I)if C.AntiAFK and I-b.afk>=120 then b.afk=I pcall(function()mousemoverel(2,0)mousemoverel(-2,0)end)end end function z.busy()return C.Mode~="off"or C.collect~=nil or C.route~=nil or C.lootPhase~=nil or C.AutoLoot or C.AutoTrain or C.NoClip or C.AntiAFK or z.espOn()end function z.sync()z.espSync()pcall(z.fishSync)pcall(z.syncSkills)if z.busy()then if not C.tickConn then C.tickConn=y.Heartbeat:Connect(D)end elseif C.tickConn then pcall(function()C.tickConn:Disconnect()end)C.tickConn=nil z.aimRelease()pcall(z.skillsRelease)C.cur=nil z.dropCache()end end pcall(z.seenLoad)pcall(function()t:LoadSettings()end)z.sync()z.notify("loaded - rshift for the menu",4)print("[Slayers 2] loaded")
