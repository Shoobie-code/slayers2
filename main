cal Y=e.lootPhase local H=o.lootNear(Y.pos,90)if#H>0 then Y.last=N o.collectStart(H,"boss drops")return end if(N-Y.last)>e.LootWait or(N-Y.t0)>45 then e.lootPhase=nil o.notify("drops done, next boss",2)else o.travelTo(Y.pos,N)return end end if N-l.key>=.1 then l.key=N if iskeypressed and iskeypressed(e.PanicVK)then if e.Mode~="off"or e.AutoTrain or e.collect then o.panic()end end end if e.Mode~="off"and e.cur then pcall(o.steer)local Y pcall(function()local N=e.cur.Model and e.cur.Model:FindFirstChild("Head")Y=(N and N.Position)or e.cur.Root.Position end)pcall(o.aimStep,Y)local H,U=o.char()if U and Y then local H=((Y-U.Position)).Magnitude pcall(o.skillStep,N,H)end else o.aimRelease()pcall(o.skillsRelease)end if N-l.farm>=e.AttackDelay then l.farm=N pcall(y,N)end if o.espOn()and N-l.esp>=.35 then l.esp=N pcall(o.espBuild)end if e.AutoTrain and(not e.AutoFish and(not e.collect and N-l.train>=1.5))then l.train=N pcall(function()local N=Y:FindFirstChild("Player_Service")local H=N and N:FindFirstChild("Values")local U=H and H:FindFirstChild(M.Name)if not U then return end if U:FindFirstChild("Training")then if o.remote then o.remote:FireServer("training_signaler","Stop",true)end else if setrobloxinput then setrobloxinput(true)end keypress(84)keyrelease(84)end end)end if e.NoClip and N-l.clip>=.25 then l.clip=N pcall(function()local N=M.Character if not N then return end local Y=N:GetChildren()for N=1,#Y,1 do local H=Y[N]if((H.ClassName=="Part"or H.ClassName=="MeshPart"))and H.Name~="HumanoidRootPart"then H.CanCollide=false end end end)end if(N-((l.survey or 0)))>10 then l.survey=N pcall(function()o.scan(nil,nil)end)end pcall(o.seenSave,N)if e.AntiAFK and N-l.afk>=120 then l.afk=N pcall(function()mousemoverel(2,0)mousemoverel(-2,0)end)end end function o.busy()return e.Mode~="off"or e.collect~=nil or e.lootPhase~=nil or e.AutoLoot or e.AutoTrain or e.NoClip or e.AntiAFK or o.espOn()end function o.sync()o.espSync()pcall(o.syncSkills)if o.busy()then if not e.tickConn then e.tickConn=H.Heartbeat:Connect(q)end elseif e.tickConn then pcall(function()e.tickConn:Disconnect()end)e.tickConn=nil o.aimRelease()pcall(o.skillsRelease)e.cur=nil o.dropCache()end end pcall(o.seenLoad)pcall(function()L:LoadSettings()end)o.sync()o.notify("loaded - rshift for the menu",4)print("[Slayers 2] loaded")
