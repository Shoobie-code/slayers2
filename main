ame)if not H then return end if H:FindFirstChild("Training")then if y.remote then y.remote:FireServer("training_signaler","Stop",true)else f.trainSince=f.trainSince or S local X=f.bar if not((X and X.active))and(S-f.trainSince>5 and S-((f.trainWarn or 0))>30)then f.trainWarn=S y.notify("click mode only plays the Squat bar - finish this station yourself",6)end end else f.trainSince=nil end end)end if f.NoClip and S-Y.clip>=.25 then Y.clip=S pcall(function()local S=E.Character if not S then return end local X=S:GetChildren()for S=1,#X,1 do local V=X[S]if((V.ClassName=="Part"or V.ClassName=="MeshPart"))and V.Name~="HumanoidRootPart"then V.CanCollide=false end end end)end if f.Mode~="off"and(S-((Y.survey or 0)))>10 then Y.survey=S pcall(function()y.scan(nil,nil)end)end pcall(y.seenSave,S)if f.AntiAFK and S-Y.afk>=120 then Y.afk=S pcall(function()mousemoverel(2,0)mousemoverel(-2,0)end)end end function y.busy()return f.Mode~="off"or f.collect~=nil or f.route~=nil or f.lootPhase~=nil or f.AutoLoot or f.AutoTrain or f.NoClip or f.AntiAFK or y.espOn()end function y.sync()y.espSync()pcall(y.fishSync)pcall(y.syncSkills)if y.busy()then if not f.tickConn then f.tickConn=V.Heartbeat:Connect(O)end elseif f.tickConn then pcall(function()f.tickConn:Disconnect()end)f.tickConn=nil y.aimRelease()pcall(y.skillsRelease)f.cur=nil y.dropCache()end end pcall(y.seenLoad)pcall(function()G:LoadSettings()end)y.sync()y.notify("loaded - rshift for the menu",4)print("[Slayers 2] loaded")
