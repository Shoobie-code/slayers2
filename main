D[k][W]^S*((1/u[k][W]))^Y if p>V then V=p a=W end end end else local V,M=0,{}for W=1,W,1 do if not p[W]then M[W]=D[k][W]^S*((1/u[k][W]))^Y V=V+M[W]end end local U=math.random()*V for V=1,W,1 do if M[V]then U=U-M[V]if U<=0 then a=V break end end end if not a then for V=1,W,1 do if not p[V]then a=V break end end end end D[k][a]=((1-O))*D[k][a]+O*G p[a]=true M[#M+1]=a k=a end local q=a(M)if q<c then c=q U=M end end local p=0 for V=1,#U,1 do local W=U[V]D[p][W]=((1-O))*D[p][W]+O/c p=W end end return U,c end function q.routeStart(V)local p,W=q.char()if not W or not V or#V==0 then return false end local M,u={},{}for p=1,#V,1 do local W,a=pcall(V[p].get)if W and a then M[#M+1]=a u[#u+1]=V[p]end end if#M==0 then return false end local a,k=q.acoPath(W.Position,M)local c={}for V=1,#a,1 do c[V]=u[a[V]]end U.route={list=c,i=1;t=os.clock(),tDown=false,nextT=0}q.notify(string.format("boss drops: %d, path %.0f studs",#c,k or 0),3)return true end function q.routeStop()local V=U.route U.route=nil if V and V.tDown then pcall(function()keyrelease(84)end)end end function q.routeStep(V)local p=U.route if not p then return false end local W,M=q.char()if not M then return true end if q.focused(V)and V>=p.nextT then p.nextT=V+U.RouteTap p.tDown=not p.tDown pcall(function()if p.tDown then keypress(84)else keyrelease(84)end end)end local u=p.list[p.i]if not u then q.routeStop()return false end local a if not pcall(function()a=u.get()end)or not a then p.i=p.i+1 p.t=V p.arrive=nil return true end local k=M.Position local c,G,D=a.X-k.X,((a.Y+2.5))-k.Y,a.Z-k.Z local S=math.sqrt((c*c+G*G)+D*D)if S<=3 then p.i=p.i+1 p.t=V if not p.list[p.i]then pcall(function()M.AssemblyLinearVelocity=Vector3.new(0,0,0)end)end return true end if S>U.WarpAbove then pcall(function()M.CFrame=CFrame.new(a.X,a.Y+3,a.Z)M.AssemblyLinearVelocity=Vector3.new(0,0,0)end)else local V=U.MoveSpeed if not p.list[p.i+1]then V=math.min(S*5.0,U.MoveSpeed)end local W=V/S pcall(function()M.AssemblyLinearVelocity=Vector3.new(c*W,G*W,D*W)end)end if V-p.t>5 then p.i=p.i+1 p.t=V end return true end function q.activeQuest()local V=p:FindFirstChild("Player_Service")local W=V and V:FindFirstChild("Data")local M=W and W:FindFirstChild(u.Name)if not M then return nil end local a=M:FindFirstChild("slotEquipped")a=a and a.Value or 1 local U=M:FindFirstChild("slots")local k=U and U:FindFirstChild("Slot"..tostring(math.floor(a)))local q=k and k:FindFirstChild("Quests")local c=q and q:FindFirstChild("Holder")if not c then return nil end local G=nil local D=c:GetChildren()for V=1,#D,1 do local p=D[V]:FindFirstChild("Tasks")if p then local W,M={},true local u=p:GetChildren()for V=1,#u,1 do local p=u[V]:FindFirstChild("Value")local a=u[V]:FindFirstChild("Max")local U local k=u[V]:FindFirstChild("Code")if k then local V=k.Value if type(V)=="string"and string.match(V,"^[%w ]+$")then U=V end end W[#W+1]={Name=u[V].Name,Value=p and p.Value or 0,Max=a and a.Value or 1;Code=U}if((p and p.Value or 0))<((a and a.Value or 1))then M=false end end local a=D[V]:FindFirstChild("QuestString")local U=nil if a then local V=a.Value if type(V)=="string"and#V>0 then local p=true for W=1,#V,1 do local M=string.byte(V,W)if M<32 or M>126 then p=false break end end if p then U=V end end end local k={Name=D[V].Name,Desc=U;Id=D[V].Name,Tasks=W;Complete=M}if not M then return k end if not G then G=k end end end return G end local w={"guard";"guards";"subordinate","subordinates","minion";"minions","underling";"underlings","escort"}function q.questPickups()local V={}for p,W in ipairs(M:GetChildren())do if string.match(W.Name,"%d+$")then local p if W.ClassName=="Part"or W.ClassName=="MeshPart"then p=W else p=W:FindFirstChildWhichIsA("BasePart")end if p then local M=false for V,p in ipairs(W:GetDescendants())do if p.ClassName=="ProximityPrompt"then M=true break end end if M then V[#V+1]={Name=W.Name,Root=p}end end end end return V end local C={"defeated";"remaining","slain";"killed","eliminated","defeat","hunted";"fell "}local Z={"found";"c