[#R+1]=Y[n]end end if#z>0 then v.last=n f.collectStart(z,"boss chest")return end if#R>0 and((v.passes or 0))<4 then v.last=n v.passes=((v.passes or 0))+1 if f.routeStart(R)then return end end if(n-v.last)>c.LootWait or(n-v.t0)>45 then c.lootPhase=nil f.notify("drops done, next boss",2)else f.travelTo(v.pos,n)return end end if n-V.key>=.1 then V.key=n if iskeypressed and iskeypressed(c.PanicVK)then if c.Mode~="off"or c.AutoTrain or c.collect then f.panic()end end end if c.follow and not c.cur then pcall(f.followStep,n)end if c.Mode~="off"and c.cur then pcall(f.steer)local v pcall(function()local n=c.cur.Model and c.cur.Model:FindFirstChild("Head")v=(n and n.Position)or c.cur.Root.Position end)pcall(f.aimStep,v)local Y,z=f.char()if z and v then local Y=((v-z.Position)).Magnitude pcall(f.skillStep,n,Y)end else f.aimRelease()pcall(f.skillsRelease)end if n-V.farm>=c.AttackDelay then V.farm=n pcall(d,n)end if f.espOn()and n-V.esp>=.35 then V.esp=n pcall(f.espBuild)end if c.AutoTrain and(not c.AutoFish and(not c.collect and n-V.train>=1.5))then V.train=n pcall(function()local Y=v:FindFirstChild("Player_Service")local z=Y and Y:FindFirstChild("Values")local p=z and z:FindFirstChild(R.Name)if not p then return end if p:FindFirstChild("Training")then if f.remote then f.remote:FireServer("training_signaler","Stop",true)else c.trainSince=c.trainSince or n local v=c.bar if not((v and v.active))and(n-c.trainSince>5 and n-((c.trainWarn or 0))>30)then c.trainWarn=n f.notify("click mode only plays the Squat bar - finish this station yourself",6)end end else c.trainSince=nil end end)end if c.NoClip and n-V.clip>=.25 then V.clip=n pcall(function()local n=R.Character if not n then return end local v=n:GetChildren()for n=1,#v,1 do local Y=v[n]if((Y.ClassName=="Part"or Y.ClassName=="MeshPart"))and Y.Name~="HumanoidRootPart"then Y.CanCollide=false end end end)end if c.Mode~="off"and(n-((V.survey or 0)))>10 then V.survey=n pcall(function()f.scan(nil,nil)end)end pcall(f.seenSave,n)if c.AntiAFK and n-V.afk>=120 then V.afk=n pcall(function()mousemoverel(2,0)mousemoverel(-2,0)end)end end function f.busy()return c.Mode~="off"or c.collect~=nil or c.route~=nil or c.lootPhase~=nil or c.AutoLoot or c.AutoTrain or c.NoClip or c.AntiAFK or f.espOn()end function f.sync()f.espSync()pcall(f.fishSync)pcall(f.syncSkills)if f.busy()then if not c.tickConn then c.tickConn=Y.Heartbeat:Connect(F)end elseif c.tickConn then pcall(function()c.tickConn:Disconnect()end)c.tickConn=nil f.aimRelease()pcall(f.skillsRelease)c.cur=nil f.dropCache()end end pcall(f.seenLoad)pcall(function()j:LoadSettings()end)f.sync()f.notify("loaded - rshift for the menu",4)print("[Slayers 2] loaded")
