.Position)).Magnitude pcall(c.skillStep,x,q)end else c.aimRelease()pcall(c.skillsRelease)end if x-C.farm>=H.AttackDelay then C.farm=x pcall(W,x)end if c.espOn()and x-C.esp>=.35 then C.esp=x pcall(c.espBuild)end if H.AutoTrain and(not H.AutoFish and(not H.collect and x-C.train>=1.5))then C.train=x pcall(function()local q=T:FindFirstChild("Player_Service")local K=q and q:FindFirstChild("Values")local G=K and K:FindFirstChild(w.Name)if not G then return end if G:FindFirstChild("Training")then if c.remote then c.remote:FireServer("training_signaler","Stop",true)else H.trainSince=H.trainSince or x local T=H.bar if not((T and T.active))and(x-H.trainSince>5 and x-((H.trainWarn or 0))>30)then H.trainWarn=x c.notify("click mode only plays the Squat bar - finish this station yourself",6)end end else H.trainSince=nil end end)end if H.NoClip and x-C.clip>=.25 then C.clip=x pcall(function()local x=w.Character if not x then return end local T=x:GetChildren()for x=1,#T,1 do local q=T[x]if((q.ClassName=="Part"or q.ClassName=="MeshPart"))and q.Name~="HumanoidRootPart"then q.CanCollide=false end end end)end if H.Mode~="off"and(x-((C.survey or 0)))>10 then C.survey=x pcall(function()c.scan(nil,nil)end)end pcall(c.seenSave,x)if H.AntiAFK and x-C.afk>=120 then C.afk=x pcall(function()mousemoverel(2,0)mousemoverel(-2,0)end)end end function c.busy()return H.Mode~="off"or H.collect~=nil or H.route~=nil or H.lootPhase~=nil or H.AutoLoot or H.AutoTrain or H.NoClip or H.AntiAFK or c.espOn()end function c.sync()c.espSync()pcall(c.fishSync)pcall(c.syncSkills)if c.busy()then if not H.tickConn then H.tickConn=q.Heartbeat:Connect(X)end elseif H.tickConn then pcall(function()H.tickConn:Disconnect()end)H.tickConn=nil c.aimRelease()pcall(c.skillsRelease)H.cur=nil c.dropCache()end end pcall(c.seenLoad)pcall(function()A:LoadSettings()end)c.sync()c.notify("loaded - rshift for the menu",4)print("[Slayers 2] loaded")
