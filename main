 m[J][l]=D end end local S,o,r,K=1,3,.2,.9 local d=math.min(20,a+5)local I=a<=8 and 40 or(a<=20 and 30 or 15)for J=1,I,1 do for J=1,d,1 do local l,s,p={},{},0 for J=1,a,1 do local i if math.random()<K then local J=-1 for a=1,a,1 do if not l[a]then local l=m[p][a]^S*((1/f[p][a]))^o if l>J then J=l i=a end end end else local J,s=0,{}for a=1,a,1 do if not l[a]then s[a]=m[p][a]^S*((1/f[p][a]))^o J=J+s[a]end end local k=math.random()*J for J=1,a,1 do if s[J]then k=k-s[J]if k<=0 then i=J break end end end if not i then for J=1,a,1 do if not l[J]then i=J break end end end end m[p][i]=((1-r))*m[p][i]+r*D l[i]=true s[#s+1]=i p=i end local W=i(s)if W<e then e=W k=s end end local l=0 for J=1,#k,1 do local a=k[J]m[l][a]=((1-r))*m[l][a]+r/e l=a end end return k,e end function W.routeStart(J)local l,a=W.char()if not a or not J or#J==0 then return false end local s,f={},{}for l=1,#J,1 do local a,i=pcall(J[l].get)if a and i then s[#s+1]=i f[#f+1]=J[l]end end if#s==0 then return false end local i,p=W.acoPath(a.Position,s)local e={}for J=1,#i,1 do e[J]=f[i[J]]end k.route={list=e;i=1;t=os.clock(),tDown=false,nextT=0}W.notify(string.format("boss drops: %d, path %.0f studs",#e,p or 0),3)return true end function W.routeStop()local J=k.route k.route=nil if J and J.tDown then pcall(function()keyrelease(84)end)end end function W.routeStep(J)local l=k.route if not l then return false end local a,s=W.char()if not s then return true end if W.focused(J)and J>=l.nextT then l.nextT=J+k.RouteTap l.tDown=not l.tDown pcall(function()if l.tDown then keypress(84)else keyrelease(84)end end)end local f=l.list[l.i]if not f then W.routeStop()return false end local i if not pcall(function()i=f.get()end)or not i then l.i=l.i+1 l.t=J l.arrive=nil return true end local p=s.Position local e,D,m=i.X-p.X,((i.Y+2.5))-p.Y,i.Z-p.Z local S=math.sqrt((e*e+D*D)+m*m)if S<=3 then l.i=l.i+1 l.t=J if not l.list[l.i]then pcall(function()s.AssemblyLinearVelocity=Vector3.new(0,0,0)end)end return true end if S>k.WarpAbove the