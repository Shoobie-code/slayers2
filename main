((L and L._inputSent==false))end function T.fishRod(m)local C=i.fishRodC if m and(C and m-C.t<.5)then return C.v end local A=T.fishRodScan()if m then i.fishRodC={t=m,v=A}end return A end function T.fishRodScan()local m=v.Character local C=m and m:FindFirstChild("Tool_Accessories")if not C then return nil end for m,C in ipairs(C:GetChildren())do if string.find(C.Name,"Fishing Rod",1,true)then return C end end return nil end function T.fishRodKey()local m=nil if not m then local A=C:FindFirstChild("Player_Service")local O=A and A:FindFirstChild("Data")m=O and O:FindFirstChild(v.Name)local L=m and m:FindFirstChild("slotEquipped")local i=m and m:FindFirstChild("slots")m=i and i:FindFirstChild("Slot"..tostring(math.floor(L and L.Value or 1)))end local A=m and m:FindFirstChild("Inventory")local O=A and A:FindFirstChild("Toolbar")local L=A and A:FindFirstChild("Inventory")if not O or not L then return nil end local i={}for m,C in ipairs(L:GetChildren())do if string.find(C.Name,"Fishing Rod",1,true)then local m=C:FindFirstChild("Id")if m then i[m.Value]=true end end end for m,C in ipairs(O:GetChildren())do if i[C.Value]and o[C.Name]then return o[C.Name]end end return nil end function T.fishGame(m)local C=v:FindFirstChild("PlayerGui")local A=C and C:FindFirstChild("Misc")if not A then return nil end local O=A:GetChildren()if#O==0 then return nil end for m,C in ipairs(O)do for m,C in ipairs(C:GetChildren())do local A=C:FindFirstChild("tracker")if A then local m=C:FindFirstChild("Bar")if m then return A,m,C end end end end return nil end function T.barMouse(m)local C=i.bar if not C or C.lmb==m then return end C.lmb=m pcall(function()if m then mouse1press()else mouse1release()end end)end function T.barStep(m,C)local A=i.bar if not A then A={lmb=false}i.bar=A end local O,v,s if A.active or m-((A.chk or 0))>=.1 then A.chk=m O,v,s=T.fishGame(m)end if not O then if A.active then A.active=false T.barMouse(false)end return false end if not A.active then A.active=true A.prevBy=nil A.g