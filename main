keyrelease(84)end)T.i=T.i+1 T.phase="move"T.t=x T.settle=nil end end return true end function c.lootNear(x,T)local q={}local w=os.clock()local G=K:FindFirstChild("LootDrops")if G then for K,w in ipairs(G:GetChildren())do local G=w:FindFirstChildWhichIsA("BasePart")if w.ClassName=="Part"or w.ClassName=="MeshPart"then G=w end if G then local K if pcall(function()K=((G.Position-x)).Magnitude end)and(K and K<=T)then q[#q+1]={get=function()return G.Position end}end end end end for K,G in ipairs(c.openChests())do local r if pcall(function()r=((G.Root.Position-x)).Magnitude end)and(r and r<=T)then local x=G.Root.Position local T=G.Name..("@"..(math.floor(x.X)..(","..math.floor(x.Z))))local K=H.chestTap[T]if not K or(w-K)>45 then H.chestTap[T]=w local x=G.Root table.insert(q,1,{get=function()return x.Position end,tap=true,side=true})end end end return q end function c.acoPath(x,T)local q=#T if q==0 then return{}end if q==1 then return{1}end local K={[0]=x}for x=1,q,1 do K[x]=T[x]end local w={}for x=0,q,1 do w[x]={}for T=0,q,1 do local q,G=K[x],K[T]local H,r,c=q.X-G.X,q.Y-G.Y,q.Z-G.Z w[x][T]=math.max(math.sqrt((H*H+r*r)+c*c),.01)end end local function G(x)local T,q=0,0 for K=1,#x,1 do T=T+w[q][x[K]]q=x[K]end return T end local H,r,c={},{},0 for x=1,q,1 do local T,K=nil,math.huge for x=1,q,1 do if not r[x]and w[c][x]<K then K=w[c][x]T=x end end r[T]=true H[#H+1]=T c=T end local N=G(H)local i=1/((q*N))local B={}for x=0,q,1 do B[x]={}for T=0,q,1 do B[x][T]=i end end local h,e,d,n=1,3,.2,.9 local g=math.min(20,q+5)local D=q<=8 and 40 or(q<=20 and 30 or 15)for x=1,D,1 do for x=1,g,1 do local T,K,r={},{},0 for x=1,q,1 do local G if math.random()<n then local x=-1 for q=1,q,1 do if not T[q]then local T=B[r][q]^h*((1/w[r][q]))^e if T>x then x=T G=q end end end else local x,K=0,{}for q=1,q,1 do if not T[q]then K[q]=B[r][q]^h*((1/w[r][q]))^e x=x+K[q]end end local H=math.random()*x for x=1,q,1 do if K[x]then H=H-K[x]if H<=0 then G=x break end end end if not G then for x=1,q,1 do if not T[x]then G=x break end end end end B[r][G]=((1-d))*B[r][G]+d*i T[G]=true K[#K+1]=G r=G end local c=G(K)if c<N then N=c H=K end end local T=0 for x=1,#H,1 do local q=H[x]B[T][q]=((1-d))*B[T][q]+d/N T=q end end return H,N end function c.routeStart(x)local T,q=c.char()if not q or not x or#x==0 then return false end local K,w={},{}for T=1,#x,1 do local q,G=pcall(x[T].get)if q and G then K[#K+1]=G w[#w+1]=x[T]end end if#K==0 then return false end local G,r=c.acoPath(q.Position,K)local N={}for x=1,#G,1 do N[x]=w[G[x]]end H.route={list=N,i=1,t=os.clock();tDown=false,nextT=0}c.notify(string.format("boss drops: %d, path %.0f studs",#N,r or 0),3)return true end function c.routeStop()local x=H.route H.route=nil if x and x.tDown then pcall(function()keyrelease(84)end)end end function c.routeStep(x)local T=H.route if not T then return false end local q,K=c.char()if not K then return true end if c.focused(x)and x>=T.nextT then T.nextT=x+H.RouteTap T.tDown=not T.tDown pcall(function()if T.tDown then keypress(84)else keyrelease(84)end end)end local w=T.list[T.i]if not w then c.routeStop()return false end local G if not pcall(function()G=w.get()end)or not G then T.i=T.i+1 T.t=x T.arrive=nil return true end local r=K.Position local N,i,B=G.X-r.X,((G.Y+2.5))-r.Y,G.Z-r.Z local h=math.sqrt((N*N+i*i)+B*B)if h<=3 then T.i=T.i+1 T.t=x if not T.list[T.i]then pcall(function()K.AssemblyLinearVelocity=Vector3.new(0,0,0)end)end return true end if h>H.WarpAbove then pcall(function()K.CFrame=CFrame.new(G.X,G.Y+3,G.Z)K.AssemblyLinearVelocity=Vector3.new(0,0,0)end)else local x=H.MoveSpeed if not T.list[T.i+1]then x=math.min(h*5.0,H.MoveSpeed)end local q=x/h pcall(function()K.AssemblyLinearVelocity=Vector3.new(N*q,i*q,B*q)end)end if x-T.t>5 then T.i=T.i+1 T.t=x end return true end function c.activeQuest()local x=T:FindFirstChild("Player_Service")local q=x and x:FindFirstChild("Data")local K=q and q:FindFirstChild(w.Name)if not K then return nil end local G=K:FindFirstChild("slotEquipped")G=G and G.