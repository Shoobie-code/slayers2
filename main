ctiveNpcs");S:FindFirstChild("StationaryNpcs")})do for L,S in ipairs(S and S:GetChildren()or{})do local z=string.lower(S.Name)local G=(z==N)if G or(not Y and string.find(z,N,1,true))then local L=S:FindFirstChildOfClass("Model")or S local N=L:FindFirstChild("HumanoidRootPart")or L:FindFirstChildWhichIsA("BasePart")if N then if G then return N.Position end Y=N.Position end end end end end end end return Y end function x.npcPos(L,N,Y)local S=i.npcPosCache[L]if S and(N-S.t)<((Y or 2.0))then return S.pos end local z=x.findNamed(L)i.npcPosCache[L]={pos=z,t=N}return z end function x.followNpc(L,N,Y)local S,z=x.char()local G=x.npcPos(L,Y,.1)or N local k=i.follow if k and k.name==L then k.t=Y k.fb=N else i.follow={name=L;fb=N,t=Y}end if not z or not G then return math.huge end local j=z.Position local n,h=j.X-G.X,j.Z-G.Z local P=math.sqrt(n*n+h*h)if math.abs(j.Y-G.Y)>15 then return math.max(P,99)end return P end function x.followStep(L)local N=i.follow if not N then return end if L-N.t>.6 then i.follow=nil return end local Y,S=x.char()local z=x.npcPos(N.name,L,.1)or N.fb if not S or not z then return end if N.lastPos and N.lastPos~=z then local Y=L-((N.lastT or L))if Y>.02 then local S,G=((z.X-N.lastPos.X))/Y,((z.Z-N.lastPos.Z))/Y if S*S+G*G<900 then N.vx,N.vz=S,G end N.lastPos,N.lastT=z,L end elseif not N.lastPos then N.lastPos,N.lastT=z,L end local G,k=N.vx or 0,N.vz or 0 local j=S.Position local n,h=j.X-z.X,j.Z-z.Z local P=math.sqrt(n*n+h*h)local c,e=1,0 if P>.5 then c,e=n/P,h/P end local w=(z.X+c*2.5)+G*.2 local r=(z.Z+e*2.5)+k*.2 local b,q,C=w-j.X,z.Y-j.Y,r-j.Z local X=math.sqrt((b*b+q*q)+C*C)if X>i.WarpAbove then x.travelTo(Vector3.new(w,z.Y-3,r),L)return end local t,p,O=G+b*6,q*6,k+C*6 local K=math.sqrt((t*t+p*p)+O*O)if K>i.MoveSpeed then local L=i.MoveSpeed/K t,p,O=t*L,p*L,O*L end if X<.6 and G*G+k*k<1 then t,p,O=0,0,0 end pcall(function()S.AssemblyLinearVelocity=Vector3.new(t,p,O)end)end k.BlackMarketer={Vector3.new(-132.68,804,101.24);Vector3.new(2161.96,823.46,-90