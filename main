eshPart"then H=E end if H then local D if pcall(function()D=((H.Position-S)).Magnitude end)and(D and D<=X)then V[#V+1]={get=function()return H.Position end}end end end end for D,H in ipairs(y.openChests())do local r if pcall(function()r=((H.Root.Position-S)).Magnitude end)and(r and r<=X)then local S=H.Root.Position local X=H.Name..("@"..(math.floor(S.X)..(","..math.floor(S.Z))))local D=f.chestTap[X]if not D or(E-D)>45 then f.chestTap[X]=E local S=H.Root table.insert(V,1,{get=function()return S.Position end,tap=true,side=true})end end end return V end function y.acoPath(S,X)local V=#X if V==0 then return{}end if V==1 then return{1}end local D={[0]=S}for S=1,V,1 do D[S]=X[S]end local E={}for S=0,V,1 do E[S]={}for X=0,V,1 do local V,H=D[S],D[X]local f,r,y=V.X-H.X,V.Y-H.Y,V.Z-H.Z E[S][X]=math.max(math.sqrt((f*f+r*r)+y*y),.01)end end local function H(S)local X,V=0,0 for D=1,#S,1 do X=X+E[V][S[D]]V=S[D]end return X end local f,r,y={},{},0 for S=1,V,1 do local X,D=nil,math.huge for S=1,V,1 do if not r[S]and E[y][S]<D then D=E[y][S]X=S end end r[X]=true f[#f+1]=X y=X end local J=H(f)local q=1/((V*J))local Z={}for S=0,V,1 do Z[S]={}for X=0,V,1 do Z[S][X]=q end end local g,u,i,t=1,3,.2,.9 local B=math.min(20,V+5)local c=V<=8 and 40 or(V<=20 and 30 or 15)for S=1,c,1 do for S=1,B,1 do local X,D,r={},{},0 for S=1,V,1 do local H if math.random()<t then local S=-1 for V=1,V,1 do if not X[V]then local X=Z[r][V]^g*((1/E[r][V]))^u if X>S then S=X H=V end end end else local S,D=0,{}for V=1,V,1 do if not X[V]then D[V]=Z[r][V]^g*((1/E[r][V]))^u S=S+D[V]end end local f=math.random()*S for S=1,V,1 do if D[S]then f=f-D[S]if f<=0 then H=S break end end end if not H then for S=1,V,1 do if not X[S]then H=S break end end end end Z[r][H]=((1-i))*Z[r][H]+i*q X[H]=true D[#D+1]=H r=H end local y=H(D)if y<J then J=y f=D end end local X=0 for S=1,#f,1 do local V=f[S]Z[X][V]=((1-i))*Z[X][V]+i/J X=V end end return f,J end function y.routeStart(S)local X,V=y.char()if not V or not S or#S==0 then return false end local D,E={},{}for X=1,#S,1 do local V,H=pcall(S[X].get)if V and H then D[#D+1]=H E[#E+1]=S[X]end end if#D==0 then return false end local H,r=y.acoPath(V.Position,D)local J={}for S=1,#H,1 do J[S]=E[H[S]]end f.route={list=J;i=1,t=os.clock(),tDown=false,nextT=0}y.notify(string.format("boss drops: %d, path %.0f studs",#J,r or 0),3)return true end function y.routeStop()local S=f.route f.route=nil if S and S.tDown then pcall(function()keyrelease(84)end)end end function y.routeStep(S)local X=f.route if not X then return false end local V,D=y.char()if not D then return true end if y.focused(S)and S>=X.nextT then X.nextT=S+f.RouteTap X.tDown=not X.tDown pcall(function()if X.tDown then keypress(84)else keyrelease(84)end end)end local E=X.list[X.i]if not E then y.routeStop()return false end local H if not pcall(function()H=E.get()end)or not H then X.i=X.i+1 X.t=S X.arrive=nil return true end local r=D.Position local J,q,Z=H.X-r.X,((H.Y+2.5))-r.Y,H.Z-r.Z local g=math.sqrt((J*J+q*q)+Z*Z)if g<=3 then X.i=X.i+1 X.t=S if not X.list[X.i]then pcall(function()D.AssemblyLinearVelocity=Vector3.new(0,0,0)end)end return true end if g>f.WarpAbove then pcall(function()D.CFrame=CFrame.new(H.X,H.Y+3,H.Z)D.AssemblyLinearVelocity=Vector3.new(0,0,0)end)else local S=f.MoveSpeed if not X.list[X.i+1]then S=math.min(g*5.0,f.MoveSpeed)end local V=S/g pcall(function()D.AssemblyLinearVelocity=Vector3.new(J*V,q*V,Z*V)end)end if S-X.t>5 then X.i=X.i+1 X.t=S end return true end function y.activeQuest()local S=X:FindFirstChild("Player_Service")local V=S and S:FindFirstChild("Data")local D=V and V:FindFirstChild(E.Name)if not D then return nil end local H=D:FindFirstChild("slotEquipped")H=H and H.Value or 1 local f=D:FindFirstChild("slots")local r=f and f:FindFirstChild("Slot"..tostring(math.floor(H)))local y=r and r:FindFirstChild("Quests")local J=y and y:FindFirstChild("Holder")if not J then return nil end local q=nil local Z=J:GetChildren()for S=1,#Z,1 do local X=Z[S]:FindFirstChild("Tasks")if