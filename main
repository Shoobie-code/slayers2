aining_signaler","Stop",true)else U.trainSince=U.trainSince or V local p=U.bar if not((p and p.active))and(V-U.trainSince>5 and V-((U.trainWarn or 0))>30)then U.trainWarn=V q.notify("click mode only plays the Squat bar - finish this station yourself",6)end end else U.trainSince=nil end end)end if U.NoClip and V-Vh.clip>=.25 then Vh.clip=V pcall(function()local V=u.Character if not V then return end local p=V:GetChildren()for V=1,#p,1 do local W=p[V]if((W.ClassName=="Part"or W.ClassName=="MeshPart"))and W.Name~="HumanoidRootPart"then W.CanCollide=false end end end)end if U.Mode~="off"and(V-((Vh.survey or 0)))>10 then Vh.survey=V pcall(function()q.scan(nil,nil)end)end pcall(q.seenSave,V)if U.AntiAFK and V-Vh.afk>=120 then Vh.afk=V pcall(function()mousemoverel(2,0)mousemoverel(-2,0)end)end end function q.busy()return U.Mode~="off"or U.collect~=nil or U.route~=nil or U.lootPhase~=nil or U.AutoLoot or U.AutoSouls or U.AutoTrain or U.NoClip or U.AntiAFK or q.espOn()end function q.sync()q.espSync()pcall(q.fishSync)pcall(q.syncSkills)if q.busy()then if not U.tickConn then U.tickConn=W.Heartbeat:Connect(function()local V,p=pcall(Wh)if not V then q.logErr("tick",p)end end)end elseif U.tickConn then pcall(function()U.tickConn:Disconnect()end)U.tickConn=nil q.aimRelease()pcall(q.skillsRelease)U.cur=nil q.dropCache()end end pcall(q.seenLoad)pcall(function()J:LoadSettings()end)q.sync()q.notify("loaded - rshift for the menu",4)print("[Slayers 2] loaded")
