 F=1/((w*E))local k={}for Q=0,w,1 do k[Q]={}for n=0,w,1 do k[Q][n]=F end end local X,p,N,b=1,3,.2,.9 local C=math.min(20,w+5)local m=w<=8 and 40 or(w<=20 and 30 or 15)for Q=1,m,1 do for Q=1,C,1 do local n,T,A={},{},0 for Q=1,w,1 do local G if math.random()<b then local Q=-1 for w=1,w,1 do if not n[w]then local n=k[A][w]^X*((1/l[A][w]))^p if n>Q then Q=n G=w end end end else local Q,T=0,{}for w=1,w,1 do if not n[w]then T[w]=k[A][w]^X*((1/l[A][w]))^p Q=Q+T[w]end end local g=math.random()*Q for Q=1,w,1 do if T[Q]then g=g-T[Q]if g<=0 then G=Q break end end end if not G then for Q=1,w,1 do if not n[Q]then G=Q break end end end end k[A][G]=((1-N))*k[A][G]+N*F n[G]=true T[#T+1]=G A=G end local y=G(T)if y<E then E=y g=T end end local n=0 for Q=1,#g,1 do local w=g[Q]k[n][w]=((1-N))*k[n][w]+N/E n=w end end return g,E end function y.routeStart(Q)local n,w=y.char()if not w or not Q or#Q==0 then return false end local T,l={},{}for n=1,#Q,1 do local w,G=pcall(Q[n].get)if w and G then T[#T+1]=G l[#l+1]=Q[n]end end if#T==0 then return false end local G,A=y.acoPath(w.Position,T)local E={}for Q=1,#G,1 do E[Q]=l[G[Q]]end g.route={list=E;i=1;t=os.clock(),tDown=false,nextT=0}y.notify(string.format("boss drops: %d, path %.0f studs",#E,A or 0),3)return true end function y.routeStop()local Q=g.route g.route=nil if Q and Q.tDown then pcall(function()keyrelease(84)end)end end function y.routeStep(Q)local n=g.route if not n then return false end local w,T=y.char()if not T then return true end if y.focused(Q)and Q>=n.nextT then n.nextT=Q+g.RouteTap n.tDown=not n.tDown pcall(function()if n.tDown then keypress(84)else keyrelease(84)end end)end local l=n.list[n.i]if not l then y.routeStop()return false end local G if not pcall(function()G=l.get()end)or not G then n.i=n.i+1 n.t=Q n.arrive=nil return true end local A=T.Position local E,F,k=G.X-A.X,((G.Y+2.5))-A.Y,G.Z-A.Z local X=math.sqrt((E*E+F*F)+k*k)if X<=3 then n.i=n.i+1 n.t=Q if not n.list[n.i]then pcall(function()T.AssemblyLinearVelocity=Vect