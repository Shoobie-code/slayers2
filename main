==0 then return{}end if s==1 then return{1}end local Z={[0]=r}for r=1,s,1 do Z[r]=C[r]end local n={}for r=0,s,1 do n[r]={}for C=0,s,1 do local s,e=Z[r],Z[C]local p,K,T=s.X-e.X,s.Y-e.Y,s.Z-e.Z n[r][C]=math.max(math.sqrt((p*p+K*K)+T*T),.01)end end local function e(r)local C,s=0,0 for Z=1,#r,1 do C=C+n[s][r[Z]]s=r[Z]end return C end local p,K,T={},{},0 for r=1,s,1 do local C,Z=nil,math.huge for r=1,s,1 do if not K[r]and n[T][r]<Z then Z=n[T][r]C=r end end K[C]=true p[#p+1]=C T=C end local N=e(p)local J=1/((s*N))local o={}for r=0,s,1 do o[r]={}for C=0,s,1 do o[r][C]=J end end local b,a,c,W=1,3,.2,.9 local H=math.min(20,s+5)local g=s<=8 and 40 or(s<=20 and 30 or 15)for r=1,g,1 do for r=1,H,1 do local C,Z,K={},{},0 for r=1,s,1 do local e if math.random()<W then local r=-1 for s=1,s,1 do if not C[s]then local C=o[K][s]^b*((1/n[K][s]))^a if C>r then r=C e=s end end end else local r,Z=0,{}for s=1,s,1 do if not C[s]then Z[s]=o[K][s]^b*((1/n[K][s]))^a r=r+Z[s]end end local p=math.random()*r for r=1,s,1 do if Z[r]then p=p-Z[r]if p<=0 then e=r break end end end if not e then for r=1,s,1 do if not C[r]then e=r break end end end end o[K][e]=((1-c))*o[K][e]+c*J C[e]=true Z[#Z+1]=e K=e end local T=e(Z)if T<N then N=T p=Z end end local C=0 for r=1,#p,1 do local s=p[r]o[C][s]=((1-c))*o[C][s]+c/N C=s end end return p,N end function T.routeStart(r)local C,s=T.char()if not s or not r or#r==0 then return false end local Z,n={},{}for C=1,#r,1 do local s,e=pcall(r[C].get)if s and e then Z[#Z+1]=e n[#n+1]=r[C]end end if#Z==0 then return false end local e,K=T.acoPath(s.Position,Z)local N={}for r=1,#e,1 do N[r]=n[e[r]]end p.route={list=N,i=1;t=os.clock(),tDown=false;nextT=0}T.notify(string.format("boss drops: %d, path %.0f studs",#N,K or 0),3)return true end function T.routeStop()local r=p.route p.route=nil if r and r.tDown then pcall(function()keyrelease(84)end)end end function T.routeStep(r)local C=p.route if not C then return false end local s,Z=T.char()if not Z then return true end if T.fo