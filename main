qwarn or 0))>8 then wC.qwarn=Q y.notify("nothing to farm or pick up in: "..tostring(n.Name),5)end return end end local E=(type(l)=="table")and y.setKey(l)or tostring(l)local F=g.cur if F and F.wantKey==E then local n=nil local w=pcall(function()n=F.Hum.Health end)if((not w or not n or n<=0))and(g.LootBoss and(F.Boss and F.lastPos))then g.pendingLoot={pos=F.lastPos,t=Q}end if n and n>0 then if F.lastHp==nil or n<F.lastHp then F.lastHp=n F.t=Q end pcall(function()F.lastPos=F.Root.Position end)if(Q-F.t)<8.0 then y.attack(Q)return end y.notify("target stuck, re-picking",2)end g.cur=nil y.dropCache()end local k=y.scanCached(l,G,Q,.75,g.Mode=="boss"or g.Mode=="crow")if#k==0 and g.Mode=="quest"then local Q=g.questInfo local n=Q and(Q.BossOption and g.questDesc==Q.BossOption)if Q and(Q.Alt and not n)then k=y.scan(Q.Alt,false)end end if#k==0 then if Q-wC.guard>g.Retarget*3 then wC.guard=Q local n=y.wantSpawn(l)if n then y.tpTo(n,3)elseif Q-((wC.nodest or 0))>12 then wC.nodest=Q local n=(type(l)=="table")and y.bossLabel()or tostring(l)y.notify("no known spot for "..(n.." - find it once and it is remembered"),6)end end return end local X=y.nearest(k,w.Position)if not X then return end X.want=l X.wantKey=E X.t=Q g.cur=X y.attack(Q)end local function lC()if not g.Running then return end local Q=os.clock()y.mark("tick")y.markWrite(Q)if g.AutoSouls and not g.route then y.mark("souls")local n,w=pcall(y.soulStep,Q)if n and w then return end end if g.route then y.mark("route")local n,w=pcall(y.routeStep,Q)if n and w then return end if not n then y.routeStop()end end if g.collect then y.mark("collect")if pcall(y.collectStep,Q)then return end end if((g.AutoLoot or g.AutoSouls))and(not g.collect and(not g.lootPhase and(not g.route and(Q-((wC.loot or 0)))>2.0)))then wC.loot=Q local n,w=y.char()if w then if g.AutoLoot then local Q=y.lootNear(w.Position,g.LootRange)if#Q>0 then y.collectStart(Q,"loot")end end end end if g.pendingLoot and(Q-g.pendingLoot.t)>1.0 then g.lootPhase={pos=g.pendingLoot.pos,t0=Q;last=Q}g.pendingLoot=nil y.notify("boss down, collecting drops",3)end if g.lootPhase then y.mark("bossloot")local n=g.lootPhase local w=y.lootNear(n.pos,90)local T,l={},{}for Q=1,#w,1 do if w[Q].tap then T[#T+1]=w[Q]else l[#l+1]=w[Q]end end if#T>0 or#l>0 then n.sawChest=true end if#T>0 then n.last=Q y.collectStart(T,"boss chest")return end if#l>0 and((n.passes or 0))<4 then n.last=Q n.passes=((n.passes or 0))+1 if y.routeStart(l)then return end end local G=(Q-n.last)>g.LootWait if not n.sawChest then G=(Q-n.t0)>25 end if(Q-n.t0)>60 then G=true end if G then if not n.sawChest then y.notify("no boss chest appeared, moving on",4)end g.lootPhase=nil y.notify("drops done, next boss",2)else y.travelTo(n.pos,Q)return end end if Q-wC.key>=.1 then wC.key=Q if iskeypressed and iskeypressed(g.PanicVK)then if g.Mode~="off"or g.AutoTrain or g.collect then y.panic()end end end pcall(y.dlgRelease,Q)if g.follow and not g.cur then pcall(y.followStep,Q)end if g.Mode~="off"and g.cur then pcall(y.steer)local n pcall(function()local Q=g.cur.Model and g.cur.Model:FindFirstChild("Head")n=(Q and Q.Position)or g.cur.Root.Position end)pcall(y.aimStep,n)local w,T=y.char()if T and n then local w=((n-T.Position)).Magnitude pcall(y.skillStep,Q,w)end else y.aimRelease()pcall(y.skillsRelease)end if Q-wC.farm>=g.AttackDelay then wC.farm=Q y.mark("farm/"..tostring(g.Mode))pcall(TC,Q)end if y.espOn()and Q-wC.esp>=.35 then wC.esp=Q y.mark("espbuild")pcall(y.espBuild)end if g.AutoTrain and(not g.AutoFish and(not g.collect and Q-wC.train>=1.5))then wC.train=Q pcall(function()local w=n:FindFirstChild("Player_Service")local T=w and w:FindFirstChild("Values")local G=T and T:FindFirstChild(l.Name)if not G then return end if G:FindFirstChild("Training")then if y.remote then y.remote:FireServer("training_signaler","Stop",true)else g.trainSince=g.trainSince or Q local n=g.bar if not((n and n.active))and(Q-g.trainSince>5 and Q-((g.trainWarn or 0))>30)then g.trainWarn=Q y.notify("click mode only plays the Squat bar - finish this station yourself",6)end end else g.trainSince=nil end end)end if g.NoClip and Q-wC.clip>=.25 then wC.clip=Q pcall(function()local Q=l.Character if not Q then return end local n=Q:GetChildren()for Q=1,#n,1 do local w=n[Q]if((w.ClassName=="Part"or w.ClassName=="MeshPart"))and w.Name~="HumanoidRootPart"then w.CanCollide=false end end end)end if g.Mode~="off"and(Q-((wC.survey or 0)))>10 then wC.survey=Q pcall(function()y.scan(nil,nil)end)end pcall(y.seenSave,Q)if g.AntiAFK and Q-wC.afk>=120 then wC.afk=Q pcall(function()mousemoverel(2,0)mousemoverel(-2,0)end)end end function y.busy()return g.Mode~="off"or g.collect~=nil or g.route~=nil or g.lootPhase~=nil or g.AutoLoot or g.AutoSouls or g.AutoTrain or g.NoClip or g.AntiAFK or y.espOn()end function y.sync()y.espSync()pcall(y.fishSync)pcall(y.syncSkills)if y.busy()then if not g.tickConn then g.tickConn=w.Heartbeat:Connect(function()local Q,n=pcall(lC)if not Q then y.logErr("tick",n)end end)end elseif g.tickConn then pcall(function()g.tickConn:Disconnect()end)g.tickConn=nil y.aimRelease()pcall(y.skillsRelease)g.cur=nil y.dropCache()end end pcall(y.markPrev)pcall(y.seenLoad)pcall(function()e:LoadSettings()end)y.sync()y.notify("loaded - rshift for the menu",4)print("[Slayers 2] loaded")
