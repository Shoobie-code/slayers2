nd s.Position)or r.Root.Position end)pcall(T.aimStep,C)local s,Z=T.char()if Z and C then local s=((C-Z.Position)).Magnitude pcall(T.skillStep,r,s)end else T.aimRelease()pcall(T.skillsRelease)end if r-eN.farm>=p.AttackDelay then eN.farm=r T.mark("farm/"..tostring(p.Mode))pcall(pN,r)end if T.espOn()and r-eN.esp>=.35 then eN.esp=r T.mark("espbuild")pcall(T.espBuild)end if p.AutoTrain and(not p.AutoFish and(not p.collect and r-eN.train>=1.5))then eN.train=r pcall(function()local s=C:FindFirstChild("Player_Service")local Z=s and s:FindFirstChild("Values")local e=Z and Z:FindFirstChild(n.Name)if not e then return end if e:FindFirstChild("Training")then if T.remote then T.remote:FireServer("training_signaler","Stop",true)else p.trainSince=p.trainSince or r local C=p.bar if not((C and C.active))and(r-p.trainSince>5 and r-((p.trainWarn or 0))>30)then p.trainWarn=r T.notify("click mode only plays the Squat bar - finish this station yourself",6)end end else p.trainSince=nil end end)end if p.NoClip and r-eN.clip>=.25 then eN.clip=r pcall(function()local r=n.Character if not r then return end local C=r:GetChildren()for r=1,#C,1 do local s=C[r]if((s.ClassName=="Part"or s.ClassName=="MeshPart"))and s.Name~="HumanoidRootPart"then s.CanCollide=false end end end)end if p.Mode~="off"and(r-((eN.survey or 0)))>10 then eN.survey=r pcall(function()T.scan(nil,nil)end)end pcall(T.seenSave,r)if p.AntiAFK and r-eN.afk>=120 then eN.afk=r pcall(function()mousemoverel(2,0)mousemoverel(-2,0)end)end end function T.busy()return p.Mode~="off"or p.collect~=nil or p.route~=nil or p.lootPhase~=nil or p.AutoLoot or p.AutoSouls or p.AutoTrain or p.NoClip or p.AntiAFK or T.espOn()end function T.sync()T.espSync()pcall(T.fishSync)pcall(T.syncSkills)if T.busy()then if not p.tickConn then p.tickConn=s.Heartbeat:Connect(function()local r,C=pcall(KN)if not r then T.logErr("tick",C)end end)end elseif p.tickConn then pcall(function()p.tickConn:Disconnect()end)p.tickConn=nil T.aimRelease()pcall(T.skillsRelease)p.c