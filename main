end if o==1 then return{1}end local X={[0]=L}for L=1,o,1 do X[L]=G[L]end local O={}for L=0,o,1 do O[L]={}for G=0,o,1 do local o,W=X[L],X[G]local h,m,v=o.X-W.X,o.Y-W.Y,o.Z-W.Z O[L][G]=math.max(math.sqrt((h*h+m*m)+v*v),.01)end end local function W(L)local G,o=0,0 for X=1,#L,1 do G=G+O[o][L[X]]o=L[X]end return G end local h,m,v={},{},0 for L=1,o,1 do local G,X=nil,math.huge for L=1,o,1 do if not m[L]and O[v][L]<X then X=O[v][L]G=L end end m[G]=true h[#h+1]=G v=G end local Y=W(h)local b=1/((o*Y))local s={}for L=0,o,1 do s[L]={}for G=0,o,1 do s[L][G]=b end end local d,k,c,f=1,3,.2,.9 local p=math.min(20,o+5)local r=o<=8 and 40 or(o<=20 and 30 or 15)for L=1,r,1 do for L=1,p,1 do local G,X,m={},{},0 for L=1,o,1 do local W if math.random()<f then local L=-1 for o=1,o,1 do if not G[o]then local G=s[m][o]^d*((1/O[m][o]))^k if G>L then L=G W=o end end end else local L,X=0,{}for o=1,o,1 do if not G[o]then X[o]=s[m][o]^d*((1/O[m][o]))^k L=L+X[o]end end local h=math.random()*L for L=1,o,1 do if X[L]then h=h-X[L]if h<=0 then W=L break end end end if not W then for L=1,o,1 do if not G[L]then W=L break end end end end s[m][W]=((1-c))*s[m][W]+c*b G[W]=true X[#X+1]=W m=W end local v=W(X)if v<Y then Y=v h=X end end local G=0 for L=1,#h,1 do local o=h[L]s[G][o]=((1-c))*s[G][o]+c/Y G=o end end return h,Y end function v.routeStart(L)local G,o=v.char()if not o or not L or#L==0 then return false end local X,O={},{}for G=1,#L,1 do local o,W=pcall(L[G].get)if o and W then X[#X+1]=W O[#O+1]=L[G]end end if#X==0 then return false end local W,m=v.acoPath(o.Position,X)local Y={}for L=1,#W,1 do Y[L]=O[W[L]]end h.route={list=Y,i=1;t=os.clock();tDown=false,nextT=0}v.notify(string.format("boss drops: %d, path %.0f studs",#Y,m or 0),3)return true end function v.routeStop()local L=h.route h.route=nil if L and L.tDown then pcall(function()keyrelease(84)end)end end function v.routeStep(L)local G=h.route if not G then return false end local o,X=v.char()if not X then return true end if v.focused(L)and L>=G.