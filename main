ng")then if x.remote then x.remote:FireServer("training_signaler","Stop",true)else o.trainSince=o.trainSince or A local V=o.bar if not((V and V.active))and(A-o.trainSince>5 and A-((o.trainWarn or 0))>30)then o.trainWarn=A x.notify("click mode only plays the Squat bar - finish this station yourself",6)end end else o.trainSince=nil end end)end if o.NoClip and A-AI.clip>=.25 then AI.clip=A pcall(function()local A=p.Character if not A then return end local V=A:GetChildren()for A=1,#V,1 do local g=V[A]if((g.ClassName=="Part"or g.ClassName=="MeshPart"))and g.Name~="HumanoidRootPart"then g.CanCollide=false end end end)end if o.Mode~="off"and(A-((AI.survey or 0)))>10 then AI.survey=A pcall(function()x.scan(nil,nil)end)end pcall(x.seenSave,A)if o.AntiAFK and A-AI.afk>=120 then AI.afk=A pcall(function()mousemoverel(2,0)mousemoverel(-2,0)end)end end function x.busy()return o.Mode~="off"or o.collect~=nil or o.route~=nil or o.lootPhase~=nil or o.AutoLoot or o.AutoSouls or o.AutoTrain or o.NoClip or o.AntiAFK or x.espOn()end function x.sync()x.espSync()pcall(x.fishSync)pcall(x.syncSkills)if x.busy()then if not o.tickConn then o.tickConn=g.Heartbeat:Connect(function()local A,V=pcall(gI)if not A then x.logErr("tick",V)end end)end elseif o.tickConn then pcall(function()o.tickConn:Disconnect()end)o.tickConn=nil x.aimRelease()pcall(x.skillsRelease)o.cur=nil x.dropCache()end end pcall(x.seenLoad)pcall(function()h:LoadSettings()end)x.sync()x.notify("loaded - rshift for the menu",4)print("[Slayers 2] loaded")
