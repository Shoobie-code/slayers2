e for L=1,Y,1 do if not k[L]and z[x][L]<S then S=z[x][L]N=L end end k[N]=true i[#i+1]=N x=N end local j=G(i)local n=1/((Y*j))local h={}for L=0,Y,1 do h[L]={}for N=0,Y,1 do h[L][N]=n end end local P,c,e,w=1,3,.2,.9 local r=math.min(20,Y+5)local b=Y<=8 and 40 or(Y<=20 and 30 or 15)for L=1,b,1 do for L=1,r,1 do local N,S,k={},{},0 for L=1,Y,1 do local G if math.random()<w then local L=-1 for Y=1,Y,1 do if not N[Y]then local N=h[k][Y]^P*((1/z[k][Y]))^c if N>L then L=N G=Y end end end else local L,S=0,{}for Y=1,Y,1 do if not N[Y]then S[Y]=h[k][Y]^P*((1/z[k][Y]))^c L=L+S[Y]end end local i=math.random()*L for L=1,Y,1 do if S[L]then i=i-S[L]if i<=0 then G=L break end end end if not G then for L=1,Y,1 do if not N[L]then G=L break end end end end h[k][G]=((1-e))*h[k][G]+e*n N[G]=true S[#S+1]=G k=G end local x=G(S)if x<j then j=x i=S end end local N=0 for L=1,#i,1 do local Y=i[L]h[N][Y]=((1-e))*h[N][Y]+e/j N=Y end end return i,j end function x.routeStart(L)local N,Y=x.char()if not Y or not L or#L==0 then return false end local S,z={},{}for N=1,#L,1 do local Y,G=pcall(L[N].get)if Y and G then S[#S+1]=G z[#z+1]=L[N]end end if#S==0 then return false end local G,k=x.acoPath(Y.Position,S)local j={}for L=1,#G,1 do j[L]=z[G[L]]end i.route={list=j;i=1,t=os.clock();tDown=false,nextT=0}x.notify(string.format("boss drops: %d, path %.0f studs",#j,k or 0),3)return true end function x.routeStop()local L=i.route i.route=nil if L and L.tDown then pcall(function()keyrelease(84)end)end end function x.routeStep(L)local N=i.route if not N then return false end local Y,S=x.char()if not S then return true end if x.focused(L)and L>=N.nextT then N.nextT=L+i.RouteTap N.tDown=not N.tDown pcall(function()if N.tDown then keypress(84)else keyrelease(84)end end)end local z=N.list[N.i]if not z then x.routeStop()return false end local G if not pcall(function()G=z.get()end)or not G then N.i=N.i+1 N.t=L N.arrive=nil return true end local k=S.Position local j,n,h=G.X-k.X,((G.Y+2.5))-k.Y,G.Z-k.Z local P=math.sqr