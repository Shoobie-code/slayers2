end if A==1 then return{1}end local O={[0]=m}for m=1,A,1 do O[m]=C[m]end local v={}for m=0,A,1 do v[m]={}for C=0,A,1 do local A,L=O[m],O[C]local i,s,T=A.X-L.X,A.Y-L.Y,A.Z-L.Z v[m][C]=math.max(math.sqrt((i*i+s*s)+T*T),.01)end end local function L(m)local C,A=0,0 for O=1,#m,1 do C=C+v[A][m[O]]A=m[O]end return C end local i,s,T={},{},0 for m=1,A,1 do local C,O=nil,math.huge for m=1,A,1 do if not s[m]and v[T][m]<O then O=v[T][m]C=m end end s[C]=true i[#i+1]=C T=C end local a=L(i)local z=1/((A*a))local k={}for m=0,A,1 do k[m]={}for C=0,A,1 do k[m][C]=z end end local S,j,I,n=1,3,.2,.9 local F=math.min(20,A+5)local w=A<=8 and 40 or(A<=20 and 30 or 15)for m=1,w,1 do for m=1,F,1 do local C,O,s={},{},0 for m=1,A,1 do local L if math.random()<n then local m=-1 for A=1,A,1 do if not C[A]then local C=k[s][A]^S*((1/v[s][A]))^j if C>m then m=C L=A end end end else local m,O=0,{}for A=1,A,1 do if not C[A]then O[A]=k[s][A]^S*((1/v[s][A]))^j m=m+O[A]end end local i=math.random()*m for m=1,A,1 do if O[m]then i=i-O[m]if i<=0 then L=m break end end end if not L then for m=1,A,1 do if not C[m]then L=m break end end end end k[s][L]=((1-I))*k[s][L]+I*z C[L]=true O[#O+1]=L s=L end local T=L(O)if T<a then a=T i=O end end local C=0 for m=1,#i,1 do local A=i[m]k[C][A]=((1-I))*k[C][A]+I/a C=A end end return i,a end function T.routeStart(m)local C,A=T.char()if not A or not m or#m==0 then return false end local O,v={},{}for C=1,#m,1 do local A,L=pcall(m[C].get)if A and L then O[#O+1]=L v[#v+1]=m[C]end end if#O==0 then return false end local L,s=T.acoPath(A.Position,O)local a={}for m=1,#L,1 do a[m]=v[L[m]]end i.route={list=a;i=1,t=os.clock();tDown=false,nextT=0}T.notify(string.format("boss drops: %d, path %.0f studs",#a,s or 0),3)return true end function T.routeStop()local m=i.route i.route=nil if m and m.tDown then pcall(function()keyrelease(84)end)end end function T.routeStep(m)local C=i.route if not C then return false end local A,O=T.char()if not O then return true end if T.focused(m)and m>=C.nextT then C.nextT=m+i.RouteTap C.tDown=not C.tDown pcall(function()if C.tDown then keypress(84)else keyrelease(84)end end)end local v=C.list[C.i]if not v then T.routeStop()return false end local L if not pcall(function()L=v.get()end)or not L then C.i=C.i+1 C.t=m C.arrive=nil return true end local s=O.Position local a,z,k=L.X-s.X,((L.Y+2.5))-s.Y,L.Z-s.Z local S=math.sqrt((a*a+z*z)+k*k)if S<=3 then C.i=C.i+1 C.t=m if not C.list[C.i]then pcall(function()O.AssemblyLinearVelocity=Vector3.new(0,0,0)end)end return true end if S>i.WarpAbove then pcall(function()O.CFrame=CFrame.new(L.X,L.Y+3,L.Z)O.AssemblyLinearVelocity=Vector3.new(0,0,0)end)else local m=i.MoveSpeed if not C.list[C.i+1]then m=math.min(S*5.0,i.MoveSpeed)end local A=m/S pcall(function()O.AssemblyLinearVelocity=Vector3.new(a*A,z*A,k*A)end)end if m-C.t>5 then C.i=C.i+1 C.t=m end return true end function T.activeQuest()local m=C:FindFirstChild("Player_Service")local A=m and m:FindFirstChild("Data")local O=A and A:FindFirstChild(v.Name)if not O then return nil end local L=O:FindFirstChild("slotEquipped")L=L and L.Value or 1 local i=O:FindFirstChild("slots")local s=i and i:FindFirstChild("Slot"..tostring(math.floor(L)))local T=s and s:FindFirstChild("Quests")local a=T and T:FindFirstChild("Holder")if not a then return nil end local z=nil local k=a:GetChildren()for m=1,#k,1 do local C=k[m]:FindFirstChild("Tasks")if C then local A,O={},true local v=C:GetChildren()for m=1,#v,1 do local C=v[m]:FindFirstChild("Value")local L=v[m]:FindFirstChild("Max")local i local s=v[m]:FindFirstChild("Code")if s then local m=s.Value if type(m)=="string"and string.match(m,"^[%w ]+$")then i=m end end A[#A+1]={Name=v[m].Name,Value=C and C.Value or 0,Max=L and L.Value or 1,Code=i}if((C and C.Value or 0))<((L and L.Value or 1))then O=false end end local L=k[m]:FindFirstChild("QuestString")local i=nil if L then local m=L.Value if type(m)=="string"and#m>0 then local C=true for A=1,#m,1 do local O=string.byte(m,A)if O<32 or O>126 then C=fals