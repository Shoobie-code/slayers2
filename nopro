-- auto fish
----------------------------------------------------------------------
-- Casting is SignalEvent ToServer("Tool_Mouse", "Up", <world point>) with the
-- rod equipped; the bobber lands there as Debree."FishingLine_N". A bite opens
-- the BarKeepup minigame in PlayerGui.Misc: "tracker" drifts on its own and
-- "Bar" rises while the mouse is held. The verdict goes back with a token
-- Matcha cannot read, so the minigame itself is played. A catch then hangs off
-- the rod as Debree."FishingCatch_N" with a T prompt; casting again before it
-- is picked up throws it away.
local VK_DIGIT = { One = 49, Two = 50, Three = 51, Four = 52, Five = 53,
                   Six = 54, Seven = 55, Eight = 56, Nine = 57, Zero = 48 }

-- true while any macro here holds a synthetic mouse button
-- True while the pointer is sitting on the open menu. Everything this script
-- presses lands wherever the cursor happens to be, so a press made here would
-- hit the menu - and the menu is told to ignore the mouse while the script
-- holds a button (inputGuard), which together is what made the menu feel dead
-- while a farm was running. So: hands off the mouse while the pointer is on it.
function F.onMenu()
    if not S.win then return false end
    local ok, vis = pcall(function() return S.win:IsVisible() end)
    if not ok or not vis then return false end
    return Lib ~= nil and Lib._overUI == true
end

function F.inputHeld()
    return S.lmbDown == true or S.rmbDown == true or S.dlgUp ~= nil or S.dlgClick ~= nil
        or (S.fish ~= nil and S.fish.lmb == true)
        or (S.bar ~= nil and S.bar.lmb == true)
end

-- Auto train in a build with no remote cannot finish a station with
-- training_signaler, so the bar minigame (Squat) is played by hand instead.
function F.trainBar()
    return S.AutoTrain == true and not F.remote
end

-- The menu blocks game input while the cursor is over it (captureInput).
-- Auto fish asks for a short window of game input before each synthetic
-- press, and waits until the menu has actually handed it over.
function F.fishWantsInput()
    local b = S.bar
    if b and (b.active or b.lmb) then return true end
    local f = S.fish
    if not S.AutoFish or not f then return false end
    return f.lmb == true or f.keyUp ~= nil or f.phase == "game" or os.clock() < (f.inputUntil or 0)
end

-- The menu blocks game input only while nothing here is driving the game:
-- farming, looting, training and fishing all send real input.
function F.wantsGameInput()
    return F.fishWantsInput() or S.dlg ~= nil or S.Mode ~= "off" or S.collect ~= nil or S.route ~= nil or S.AutoTrain == true
end

function F.fishInputReady(now)
    local f = S.fish
    f.inputUntil = now + 0.6
    return not (Lib and Lib._inputSent == false)
end

-- Water bodies are WatersFunctions.WaterPorted models; each one's TouchPart
-- gives the surface height and the area it covers. That is enough to aim a
-- cast from wherever the player happens to stand, with nothing remembered.
function F.waterAreas(now)
    local c = S.waterC
    if c and now - c.t < 5 then return c.list end
    local list = {}
    local map = WS:FindFirstChild("Map")
    map = map and map:FindFirstChild("Map")
    local wf = map and map:FindFirstChild("WatersFunctions")
    local function walk(node, d)
        if d > 3 then return end
        for _, ch in ipairs(node:GetChildren()) do
            if ch.Name == "TouchPart" then
                local p, sz
                pcall(function() p = ch.Position sz = ch.Size end)
                if p and sz and sz.X > 4 then
                    list[#list + 1] = {
                        top = p.Y + sz.Y * 0.5,
                        x1 = p.X - sz.X * 0.5, x2 = p.X + sz.X * 0.5,
                        z1 = p.Z - sz.Z * 0.5, z2 = p.Z + sz.Z * 0.5,
                    }
                end
            end
            walk(ch, d + 1)
        end
    end
    if wf then walk(wf, 0) end
    S.waterC = { t = now, list = list }
    return list
end

-- A spot on the water to cast at, from where the player stands right now.
-- step rotates the direction, so a blocked cast can try elsewhere next time.
function F.waterPoint(now, step)
    local _, hrp = F.char()
    if not hrp then return nil end
    local me = hrp.Position
    local areas = F.waterAreas(now)
    local lv
    pcall(function() lv = hrp.CFrame.LookVector end)
    local dirs = {}
    if lv then
        local h = math.sqrt(lv.X * lv.X + lv.Z * lv.Z)
        if h > 0.01 then dirs[1] = { lv.X / h, lv.Z / h } end
    end
    for i = 0, 7 do
        local a = i * math.pi / 4
        dirs[#dirs + 1] = { math.cos(a), math.sin(a) }
    end
    local shift = (step or 0) % #dirs
    for di = 1, #dirs do
        local d = dirs[((di - 1 + shift) % #dirs) + 1]
        for _, dist in ipairs({ 10, 16, 22 }) do
            local x, z = me.X + d[1] * dist, me.Z + d[2] * dist
            for _, a in ipairs(areas) do
                local drop = me.Y - a.top
                if x > a.x1 and x < a.x2 and z > a.z1 and z < a.z2 and drop > -4 and drop < 45 then
                    return Vector3.new(x, a.top, z)
                end
            end
        end
    end
    -- nothing mapped nearby: cast in front anyway and let the game decide
    local d = dirs[(shift % #dirs) + 1]
    return Vector3.new(me.X + d[1] * 16, me.Y - 2, me.Z + d[2] * 16)
end

function F.fishRod(now)
    local c = S.fishRodC
    if now and c and now - c.t < 0.5 then return c.v end
    local v = F.fishRodScan()
    if now then S.fishRodC = { t = now, v = v } end
    return v
end

function F.fishRodScan()
    local ch = lp.Character
    local ta = ch and ch:FindFirstChild("Tool_Accessories")
    if not ta then return nil end
    for _, c in ipairs(ta:GetChildren()) do
        if string.find(c.Name, "Fishing Rod", 1, true) then return c end
    end
    return nil
end

-- hotbar key holding a fishing rod, from the saved toolbar ids
function F.fishRodKey()
    local mine = nil
    if not mine then
        local ps = RS:FindFirstChild("Player_Service")
        local data = ps and ps:FindFirstChild("Data")
        mine = data and data:FindFirstChild(lp.Name)
        local se = mine and mine:FindFirstChild("slotEquipped")
        local slots = mine and mine:FindFirstChild("slots")
        mine = slots and slots:FindFirstChild("Slot" .. tostring(math.floor(se and se.Value or 1)))
    end
    local inv = mine and mine:FindFirstChild("Inventory")
    local tb = inv and inv:FindFirstChild("Toolbar")
    local items = inv and inv:FindFirstChild("Inventory")
    if not tb or not items then return nil end
    local ids = {}
    for _, it in ipairs(items:GetChildren()) do
        if string.find(it.Name, "Fishing Rod", 1, true) then
            local id = it:FindFirstChild("Id")
            if id then ids[id.Value] = true end
        end
    end
    for _, sl in ipairs(tb:GetChildren()) do
        if ids[sl.Value] and VK_DIGIT[sl.Name] then return VK_DIGIT[sl.Name] end
    end
    return nil
end

-- tracker, bar, column - resolved fresh every call: the gui is destroyed when
-- the minigame ends and a cached reference would read freed memory
function F.fishGame(now)
    -- Resolved fresh every call on purpose: the minigame gui is destroyed when
    -- the bite ends, and a reference kept from the previous frame would read
    -- freed memory, which kills the whole executor rather than erroring.
    local pg = lp:FindFirstChild("PlayerGui")
    local misc = pg and pg:FindFirstChild("Misc")
    if not misc then return nil end
    local kids = misc:GetChildren()
    if #kids == 0 then return nil end
    for _, cg in ipairs(kids) do
        for _, col in ipairs(cg:GetChildren()) do
            local tr = col:FindFirstChild("tracker")
            if tr then
                local bar = col:FindFirstChild("Bar")
                if bar then return tr, bar, col end
            end
        end
    end
    return nil
end

-- the nearest Debree child whose name starts with prefix
function F.barMouse(down)
    local b = S.bar
    if down and F.onMenu() then down = false end
    if not b or b.lmb == down then return end
    b.lmb = down
    pcall(function()
        if down then mouse1press() else mouse1release() end
    end)
end

-- Plays the BarKeepup minigame (fishing bites, the Squat station) with real
-- mouse holds. Returns true while one is on screen.
function F.barStep(now, dt)
    local b = S.bar
    if not b then b = { lmb = false } S.bar = b end
    local tr, bar, col
    if b.active or now - (b.chk or 0) >= 0.1 then
        b.chk = now
        tr, bar, col = F.fishGame(now)
    end
    if not tr then
        if b.active then
            b.active = false
            F.barMouse(false)
        end
        return false
    end
    if not b.active then
        b.active = true
        b.prevBy = nil
        b.games = (b.games or 0) + 1
        -- the minigame's own frame covers the screen, so the click lands
        -- wherever the cursor already is: fishing never moves the mouse
    end
    if not F.focused(now) then F.barMouse(false) return true end
    local ty, by
    pcall(function()
        ty = tr.AbsolutePosition.Y + absSize(tr).Y * 0.5
        by = bar.AbsolutePosition.Y + absSize(bar).Y * 0.5
    end)
    if ty and by then
        local vy = 0
        if b.prevBy and dt > 0 then vy = (by - b.prevBy) / dt end
        b.prevBy = by
        -- screen y grows downward: a bar below its target needs the button
        F.barMouse((by + vy * S.FishLead) > ty and not (Lib and Lib._inputSent == false))
    end
    return true
end

function F.fishFind(prefix, maxd)
    local deb = WS:FindFirstChild("Debree")
    local _, hrp = F.char()
    if not deb or not hrp then return nil end
    local n = #prefix
    local best, bd = nil, maxd
    for _, c in ipairs(deb:GetChildren()) do
        if string.sub(c.Name, 1, n) == prefix then
            local r = c
            if c.ClassName ~= "Part" and c.ClassName ~= "MeshPart" then r = c:FindFirstChildWhichIsA("BasePart") end
            local ok, pos = pcall(function() return r.Position end)
            if ok and pos then
                local d = (pos - hrp.Position).Magnitude
                if d < bd then bd = d best = pos end
            end
        end
    end
    return best, bd
end

-- the fishing / bar-minigame loop, connected once at load (see F.connectLoops)
function F.fishFrame()
    if not S.fishLive then return end
    local okAll, errAll = pcall(function()
        if not S.Running or not (S.AutoFish or F.trainBar()) then return end
        local now = os.clock()
        local f = S.fish
        if f and f.mouseUp and now >= f.mouseUp then
            f.mouseUp = nil
            F.fishMouse(false)
        end
        if f and f.keyUp and now >= f.keyUp.t then
            local vk = f.keyUp.vk
            f.keyUp = nil
            pcall(function() keyrelease(vk) end)
        end
        if now - (S.fishRunT or 0) < 0.0166 then return end   -- 60 Hz is plenty
        S.fishRunT = now
        local dt = now - (S.fishStepT or now)
        S.fishStepT = now
        local ok, err
        if S.AutoFish then
            F.mark("fish/" .. tostring(S.fish and S.fish.phase or "?"))
            F.markWrite(now)
            ok, err = pcall(F.fishStep, now)
        else
            F.mark("barminigame")
            F.markWrite(now)
            ok, err = pcall(F.barStep, now, dt)
        end
        if not ok and now - (S.fishErrT or 0) > 5 then
            S.fishErrT = now
            F.logErr("fish", err)
        end
    end)
    if not okAll then F.logErr("fish loop", errAll) end
end

function F.fishMouse(down)
    local f = S.fish
    if down and F.onMenu() then down = false end
    if not f or f.lmb == down then return end
    f.lmb = down
    pcall(function()
        if down then
            mouse1press()
        else
            mouse1release()
        end
    end)
end

-- true once the cast went out (the click build may need a frame or two first)
function F.fishCast(target)
    -- a real click on the water: the rod's own client sends the cast
    local f = S.fish
    if not f then return false end
    if F.onMenu() then return false end   -- never grab the mouse off the menu
    local now = os.clock()
    local m = lp:GetMouse()
    -- offset between mousemoveabs and Mouse.X/Y (window chrome), once
    if not f.offX then
        if not f.calT then
            f.calT = now
            f.mx0, f.my0 = m.X, m.Y
            pcall(function() mousemoveabs(700, 450) end)
            return false
        end
        if now - f.calT < 0.12 then return false end
        f.offX, f.offY = 700 - m.X, 450 - m.Y
        return false
    end
    if not F.focused(now) then return false end
    if not F.fishInputReady(now) then return false end
    local sp, vis = WorldToScreen(target)
    if not vis or not sp then
        if now - (f.warn or 0) > 8 then
            f.warn = now
            F.notify("auto fish: the water spot is off screen - turn the camera to it", 5)
        end
        return false
    end
    pcall(function() mousemoveabs(sp.X + f.offX, sp.Y + f.offY) end)
    F.fishMouse(true)
    f.mouseUp = now + 0.08
    return true
end

function F.fishStep(now)
    local f = S.fish
    if not f then return end
    if not S.AutoFish then return end
    local dt = now - (f.last or now)
    f.last = now

    -- 1. the minigame wins over everything else
    if F.barStep(now, dt) then
        f.phase = "game"
        return
    end
    if f.phase == "game" then
        f.badCasts = 0
        f.phase = "catch"
        f.t = now
        f.tries = 0
        f.bites = (f.bites or 0) + 1
        f.holdAt = nil
        return
    end

    -- everything else runs at 10 Hz
    if now - (f.slow or 0) < 0.1 then return end
    f.slow = now
    local _, hrp = F.char()
    if not hrp then return end

    -- 3. rod in hand
    if not F.fishRod(now) then
        if now - (f.eqT or 0) > 3 then
            f.eqT = now
            local vk = F.fishRodKey()
            if vk and F.focused(now) and not F.fishInputReady(now) then
                f.eqT = now - 2.8      -- try again as soon as the menu lets go
            elseif vk and F.focused(now) then
                pcall(function()
                    keypress(vk)
                end)
                f.keyUp = { vk = vk, t = now + 0.08 }
            elseif now - (f.warn or 0) > 10 then
                f.warn = now
                F.notify("auto fish: put a fishing rod on the hotbar", 5)
            end
        end
        f.phase = "cast"
        f.t = now
        return
    end

    -- 4. collect the catch hanging off the rod. Its prompt wants a real hold,
    -- the same as a soul: "hold T for" is usually set far too short for it, so
    -- the hold has its own floor and is repeated until the catch is gone.
    if f.phase == "catch" then
        if f.keyUp then return end           -- still holding T
        if now - (f.catchChk or 0) < 0.4 then return end
        f.catchChk = now
        local cpos = F.fishFind("FishingCatch_", 14)
        if not cpos then
            if now - f.t > 2.5 or f.tries > 0 then
                if f.tries > 0 then f.caught = (f.caught or 0) + 1 end
                f.phase = "cast"
                f.t = now
            end
            return
        end
        if now < (f.holdAt or 0) or not F.focused(now) then return end
        if f.tries >= 6 then
            F.notify("auto fish: could not pick up the catch", 4)
            f.phase = "cast"
            f.t = now
            return
        end
        if not F.fishInputReady(now) then return end
        f.tries = f.tries + 1
        local hold = math.max(S.HoldT or 3, 3)
        pcall(function() keypress(84) end)
        f.keyUp = { vk = 84, t = now + hold }
        f.holdAt = now + hold + 0.4
        return
    end

    -- 5. cast at whatever water is in front of you
    if f.phase == "cast" then
        if now - f.t < S.FishPause then return end
        if F.fishFind("FishingCatch_", 12) then f.phase = "catch" f.t = now f.tries = 0 f.holdAt = nil return end
        local spot = F.waterPoint(now, f.dir or 0)
        if not spot then return end
        f.water = spot
        if F.fishCast(spot) == false then return end
        f.phase = "wait"
        f.t = now
        return
    end

    -- 6. waiting for a bite; a cast with no bobber, or no bite for too long,
    -- is reeled in (a second Up while cast) and thrown again
    if f.phase == "wait" then
        if now - (f.bobChk or 0) < 1 then return end
        f.bobChk = now
        local bob = F.fishFind("FishingLine_", 120)
        if bob then f.sawBob = true end
        if (not bob and now - f.t > 4) or now - f.t > S.FishTimeout then
            -- the line went out and came straight back: aim somewhere else
            if f.sawBob and not bob and now - f.t < 8 then
                f.badCasts = (f.badCasts or 0) + 1
                f.dir = (f.dir or 0) + 1
                if f.badCasts % 6 == 0 then
                    F.notify("auto fish: casts keep coming back - move closer to open water", 6)
                end
            else
                f.badCasts = 0
            end
            if bob then F.fishCast(f.water) end
            f.phase = "cast"
            f.t = now
            f.sawBob = false
        end
        return
    end
    if f.phase ~= "idle" then
        f.phase = "cast"
        f.t = now
    end
end

function F.fishSync()
    if S.AutoFish or F.trainBar() then
        if S.AutoFish and not S.fish then
            S.fish = { phase = "cast", t = os.clock(), lmb = false }
        end
        if not S.fishLive then S.fishStepT = os.clock() end
        S.fishLive = true
    else
        S.fishLive = false
        if S.fish then
            F.fishMouse(false)
            if S.fish.keyUp then pcall(function() keyrelease(S.fish.keyUp.vk) end) S.fish.keyUp = nil end
            S.fish.phase = "cast"
        end
        if S.bar then
            F.barMouse(false)
            S.bar.active = false
        end
    end
end

