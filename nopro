-- Every preset the game actually ships: each one owns an "<name>_Combat_Anims"
-- set, which is how the game itself resolves a style. This picks up the ones
-- the list above never had - Axe and Mace, Cutlass, Reaper, Obi Manipulation
-- and any added later - so no weapon family is left out.
do
    local anims = RS:FindFirstChild("Assets")
    anims = anims and anims:FindFirstChild("Animations")
    for _, c in ipairs(anims and anims:GetChildren() or {}) do
        local n = string.match(c.Name, "^(.*)_Combat_Anims$")
        if n and n ~= "" then DB.Presets[n] = true end
    end
end

