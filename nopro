function F.chests()
    local out = {}
    local folder = WS:FindFirstChild("Chests")
    if not folder then return out end
    local kids = folder:GetChildren()
    for i = 1, #kids do
        local c = kids[i]
        local p
        if c.ClassName == "Part" or c.ClassName == "MeshPart" then
            p = c
        else
            p = c:FindFirstChild("RootPart") or c:FindFirstChildWhichIsA("BasePart")
        end
        if p then out[#out + 1] = { Name = c.Name, Pos = p.Position } end
    end
    return out
end

