-- Errors go to workspace/slayers2_errors.txt as well as the console: a tester
-- can send the file, and a thrown error no longer takes the loop down with it.
function F.logErr(where, err)
    local line = os.date("%H:%M:%S") .. " " .. tostring(where) .. ": " .. tostring(err)
    warn("[Slayers 2] " .. line)
    if (os.clock() - (S.errT or 0)) < 1 then return end
    S.errT = os.clock()
    pcall(function() appendfile("slayers2_errors.txt", line .. string.char(10)) end)
end

-- Widget callbacks are run by the menu library, inside its own loop. Anything
-- that goes wrong in there takes the menu with it - and a bad Drawing write
-- cannot be caught, it just ends the running chunk, which is what left people
-- with a menu that no longer responds. So a callback only queues the work and
-- this script runs it on its own frame, where a failure costs at most a log
-- line.
local deferQ = {}

function F.defer(fn, a, b)
    if type(fn) ~= "function" then return end
    deferQ[#deferQ + 1] = { fn, a, b }
end

-- The one place this script starts or stops a connection, driven by the one
-- permanent connection made at the end of the load.
--
-- Nothing may drop the connection whose callback it is running in: Matcha does
-- not survive it, the whole process goes. That is what "crashes when I turn on
-- autofarm" was - this queue used to be connected on demand and disconnected
-- itself from inside its own callback, and the toggle it was running then
-- connected the tick in that same dispatch. The trail stopped dead on
-- "autofarm on", one statement before F.sync. The same shape was in the panic
-- key (tick -> F.panic -> F.sync -> disconnect the tick, from inside the tick)
-- and in the Black Marketer walk, and both now come through here instead.
function F.deferRun()
    if #deferQ > 0 then
        local q = deferQ
        deferQ = {}
        if S.Running then
            for i = 1, #q do
                local ok, err = pcall(q[i][1], q[i][2], q[i][3])
                if not ok then F.logErr("ui", err) end
            end
        end
    end
    if S.syncWant then
        S.syncWant = nil
        local ok, err = pcall(F.syncNow)
        if not ok then F.logErr("sync", err) end
    end
end

-- a group whose widgets get their callbacks queued instead of run in place
function F.guard(g)
    if type(g) ~= "table" and type(g) ~= "userdata" then return g end
    return setmetatable({}, { __index = function(_, k)
        local v = g[k]
        if type(v) ~= "function" then return v end
        return function(_, cfg, ...)
            if type(cfg) == "table" and type(cfg.callback) == "function" then
                local inner = cfg.callback
                cfg.callback = function(x, w) F.defer(inner, x, w) end
            end
            return v(g, cfg, ...)
        end
    end })
end

-- A crash that takes Matcha (or Roblox) down leaves nothing behind: no error,
-- no stack, nothing in the log. So the job the script is in the middle of is
-- written to a file once a second, and the next load reports what the run that
-- died was doing. A clean unload deletes the file, so only a real crash is ever
-- reported.
-- Every job the script passes through, appended to a file five times a second.
-- The first version of this wrote the *current* mark once a second from the top
-- of the tick, where the mark had just been set to "tick" - so every crash
-- reported "tick" and pointed at nothing. Now the marks pile up in memory and
-- the whole trail is flushed, so the last line names the job that was running
-- when the process died. Repeats collapse, or a 60 Hz loop fills the file.
local trail = {}

function F.mark(w)
    S.where = w
    -- A crash that takes the process down loses whatever has not reached the
    -- disk. For the first seconds of a farm - where the crash happens - every
    -- mark is written on its own line as it happens, so the last line names the
    -- exact job even when nothing else survives.
    if S.markBurst then
        local bnow = os.clock()
        if bnow < S.markBurst then
            pcall(function() appendfile("slayers2_trail.txt", "! " .. tostring(w) .. string.char(10)) end)
        else
            S.markBurst = nil
            pcall(function() appendfile("slayers2_trail.txt", "-- burst over" .. string.char(10)) end)
        end
    end
    local last = trail[#trail]
    if last and last.w == w then
        last.n = last.n + 1
    else
        trail[#trail + 1] = { w = w, n = 1 }
        if #trail > 60 then table.remove(trail, 1) end
    end
end

function F.markWrite(now)
    if #trail == 0 then return end
    if now - (S.markT or 0) < 0.2 then return end
    S.markT = now
    local parts = {}
    for i = 1, #trail do
        local e = trail[i]
        parts[#parts + 1] = e.n > 1 and (e.w .. " x" .. e.n) or e.w
    end
    trail = {}
    local line = os.date("%H:%M:%S") .. " " .. table.concat(parts, " > ")
    pcall(function() appendfile("slayers2_trail.txt", line .. string.char(10)) end)
end

function F.markPrev()
    local prev
    pcall(function()
        if isfile("slayers2_trail.txt") then prev = readfile("slayers2_trail.txt") end
    end)
    -- a trail left behind means the run that wrote it never unloaded cleanly
    if type(prev) == "string" and #prev > 0 then
        local last = prev
        for line in string.gmatch(prev, "[^" .. string.char(10) .. "]+") do
            if #line > 0 then last = line end
        end
        pcall(function()
            appendfile("slayers2_errors.txt",
                os.date("%H:%M:%S") .. " previous run ended at: " .. last .. string.char(10))
        end)
        warn("[Slayers 2] previous run ended at: " .. last)
    end
    pcall(function() delfile("slayers2_trail.txt") end)
    pcall(function() delfile("slayers2_where.txt") end)   -- from the old scheme
end

function F.notify(text, secs)
    -- A toast can wake the menu's RenderStepped loop, which connects it; sent
    -- from one of our RenderStepped loops (fishing, esp) that would be a
    -- connect while RenderStepped is dispatching. So it goes out from the queue,
