-- teardown of a previous run (drawings first, handle nulled before removal)
----------------------------------------------------------------------
if _G.Slayers2C then
    local old = _G.Slayers2C
    _G.Slayers2C = nil
    old.Running = false
    pcall(function() if old.drawConn then old.drawConn:Disconnect() end end)
    pcall(function() if old.tickConn then old.tickConn:Disconnect() end end)
    -- a leftover loop from the previous run would keep touching dead state
    pcall(function() if old.fishConn then old.fishConn:Disconnect() end end)
    pcall(function() if old.bmConn then old.bmConn:Disconnect() end end)
    pcall(function() if old.deferConn then old.deferConn:Disconnect() end end)
    old.fishConn, old.tickConn, old.drawConn, old.bmConn = nil, nil, nil, nil
    old.deferConn = nil
    old.fish, old.bar, old.route, old.collect, old.follow = nil, nil, nil, nil, nil
    old.soul, old.dlg, old.dlgClick, old.crow, old.lootPhase = nil, nil, nil, nil, nil
    pcall(function() mouse1release() end)
    pcall(function() mouse2release() end)
    pcall(function() keyrelease(84) end)
    -- The drawings are NOT removed here. A Drawing error cannot be caught and
    -- kills the whole chunk, which is what left people unable to inject again
    -- after a crash; the next run reuses the same objects instead (_G.__s2pool).
    old.pool = nil
    if true then
    end
    pcall(function() if old.win then old.win:Destroy() end end)
end

----------------------------------------------------------------------
-- UI library
----------------------------------------------------------------------
local Lib
do
    -- The menu library keeps one copy per Matcha session and every script
    -- shares it - including its render loop, which belongs to whichever run
    -- first loaded it. If that run is gone the loop is gone with it: the menu
    -- is still on screen but nothing responds, and re-injecting hands you the
    -- same dead copy, which is why the only way out was restarting the loader.
    -- The library stamps _now every frame, so a stale stamp means it stopped.
    local prev = rawget(_G, "UILib")
    if type(prev) == "table" then
        -- no stamp at all means an older library that cannot be judged: only a
        -- stamp that has stopped moving proves the copy in memory is dead.
        -- 1.4.0 and up reconnect their own loops to the newest run (_rehome), so
        -- a frozen copy there fixes itself - forcing a reload would take every
        -- other script's menu down with it, which is worse.
        local beat = tonumber(rawget(prev, "_now"))
        if beat and (tick() - beat) > 3 and type(rawget(prev, "_rehome")) ~= "function" then
            _G.UI_RELOAD = true       -- an old copy that cannot recover itself
        end
    end

    -- The copy in the workspace folder wins: it is the one that is kept up to
    -- date. Downloading over it is what left people with a menu that does not
    -- match this script.
    local src
    pcall(function() src = readfile("UILib.lua") end)
    if type(src) ~= "string" or #src < 1000 then
        src = nil
        pcall(function()
            src = game:HttpGet("https://raw.githubusercontent.com/Shoobie-code/linoria-inspired/refs/heads/main/main")
        end)
        if type(src) == "string" and #src > 1000 then pcall(writefile, "UILib.lua", src) else src = nil end
    end
    if type(src) == "string" then pcall(function() loadstring(src)() end) end
    _G.UI_RELOAD = nil
    Lib = _G.UILib
end
if not Lib then
    notify("UILib not found in workspace", "Slayers 2", 6)
    return
end

