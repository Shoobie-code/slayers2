local POOL_KEY = "__s2pool_slayers2click"
local POOL = 48
do
    -- One set of drawings per Matcha session, reused by every reload. Writing to
    -- a Drawing that is no longer valid cannot be caught: it ends the chunk on
    -- the spot, so the load never finishes and the script cannot be injected
    -- again. The pool is therefore unlinked from _G *before* anything touches
    -- it, and one entry is written to as a probe: if that kills this load, the
    -- next injection finds no pool and simply builds a fresh one.
    local kept = rawget(_G, POOL_KEY)
    _G[POOL_KEY] = nil
    local adopt
    if type(kept) == "table" and #kept == POOL and type(kept[1]) == "table" and kept[1].box and kept[1].tag then
        kept[1].box.Visible = false
        kept[1].tag.Visible = false
        adopt = kept
    end
    if adopt then
        S.pool = adopt
        for i = 1, POOL do
            local e = adopt[i]
            e.vis = false
            e.box.Visible = false
            e.tag.Visible = false
        end
        _G[POOL_KEY] = adopt
    else
        for i = 1, POOL do
            local box = Drawing.new("Square")
            box.Thickness = 1
            box.Filled = false
            box.Visible = false
            local tag = Drawing.new("Text")
            tag.Size = 13
            tag.Center = true
            tag.Outline = true
            tag.Visible = false
            S.pool[i] = { box = box, tag = tag }
        end
        _G[POOL_KEY] = S.pool
    end
end

local espList = {}
S.espList = function() return espList end   -- for profiling

-- colours referenced by index so the draw loop can skip unchanged writes
local PAL = {
    Color3.fromRGB(230, 230, 230),  -- 1 mob
    Color3.fromRGB(255, 90, 90),    -- 2 boss
    Color3.fromRGB(255, 215, 90),   -- 3 chest
    Color3.fromRGB(255, 130, 200),  -- 4 spider lily
    Color3.fromRGB(170, 130, 255),  -- 5 spawn crystal
    Color3.fromRGB(140, 255, 200),  -- 6 horse
    Color3.fromRGB(255, 240, 90),   -- 7 lever
    Color3.fromRGB(255, 40, 70),    -- 8 muzan
    Color3.fromRGB(120, 255, 80),   -- 9 fruit
    Color3.fromRGB(60, 255, 150),   -- 10 plant / clover
}

function F.espOn()
    return S.EspMobs or S.EspBosses or S.EspChests or S.EspCrystals or S.EspLily
        or S.EspHorses or S.EspLevers or S.EspMuzan or S.EspFruits or S.EspPlants
end

function F.espClear()
    local pool = S.pool
    if not pool then return end
    for i = 1, #pool do
        local e = pool[i]
        e.box.Visible = false
        e.tag.Visible = false
        -- drop the write cache too, or nothing redraws when esp comes back
        e.vis, e.bx, e.by, e.bw, e.bh, e.tx, e.ty, e.text, e.col = false, nil, nil, nil, nil, nil, nil, nil, nil
    end
    espList = {}
    F.npcCache = nil   -- its handles go unwatched while esp is off
end

function F.espBuild()
    local _, hrp = F.char()
    if not hrp then espList = {} return end
    local me = hrp.Position
    local max = S.EspDist
    local out = {}

    -- One pass over the npcs for both mob and boss ESP; the old code walked
    -- the whole tree twice per refresh, which is what ate the frame budget.
    -- The full walk is ~50ms, so it only runs every espFull seconds: the draw
    -- loop reads Position off the cached roots every frame, so movement stays
    -- live and only spawns/deaths wait for the next walk.
    if S.EspMobs or S.EspBosses then
        local now = os.clock()
        if not F.npcCache or (now - F.npcCacheT) > 2.0 then
            F.npcCache = F.scan(nil, nil)
            F.npcCacheT = now
        end
        local all = F.npcCache
        for i = 1, #all do
            if #out >= POOL then break end
            local t = all[i]
            local showIt = (t.Boss and S.EspBosses) or ((not t.Boss) and S.EspMobs)
            -- cache is up to 2s old: a model that despawned since is skipped
            -- without reading through it (see F.npcAlive)
            if showIt and F.npcAlive(t, 0.6) then
                local d, hp = nil, 0
                pcall(function()
                    hp = t.Hum.Health
                    d = (t.Root.Position - me).Magnitude
                end)
                if d and hp > 0 and d <= max then
                    out[#out + 1] = {
                        kind = "m", npc = t, root = t.Root,
                        text = t.Boss and (t.Name .. " " .. math.floor(hp) .. "hp")
                                      or (t.Name .. " " .. math.floor(d) .. "m"),
                        col = t.Boss and 2 or 1,
                    }
                end
            end
        end
    end

    if S.EspChests then
        local cs = F.chests()
        for i = 1, #cs do
            if #out >= POOL then break end
            local d = (cs[i].Pos - me).Magnitude
            if d <= max then
                out[#out + 1] = { kind = "p", pos = cs[i].Pos, text = cs[i].Name, col = 3 }
            end
        end
    end

    if S.EspCrystals or S.EspLily then
        local deb = WS:FindFirstChild("Debree")
        if deb then
            if S.EspLily then
                local kids = deb:GetChildren()
                for i = 1, #kids do
                    if #out >= POOL then break end
                    if string.find(string.lower(kids[i].Name), "spider lily", 1, true) then
                        local p = kids[i]:FindFirstChildWhichIsA("BasePart")
                        if p then
                            local d = (p.Position - me).Magnitude
                            if d <= max then
                                out[#out + 1] = { kind = "p", pos = p.Position, text = "Spider Lily", col = 4 }
                            end
                        end
                    end
                end
            end
            local reg = deb:FindFirstChild("Regions")
            if S.EspCrystals and reg then
                local regs = reg:GetChildren()
                for i = 1, #regs do
                    if #out >= POOL then break end
                    local ch2 = regs[i]:GetChildren()
                    for j = 1, #ch2 do
                        if string.find(string.lower(ch2[j].Name), "spawncrystal", 1, true) then
                            local p = ch2[j]:FindFirstChild("Root") or ch2[j]:FindFirstChildWhichIsA("BasePart")
                            if p then
                                local d = (p.Position - me).Magnitude
                                if d <= max then
                                    out[#out + 1] = { kind = "p", pos = p.Position, text = regs[i].Name, col = 5 }
                                end
                            end
                            break
                        end
                    end
                end
            end
        end
    end

    if S.EspHorses then
        local hs = F.scan("horse", false)
        for i = 1, #hs do
            if #out >= POOL then break end
            local d = (hs[i].Root.Position - me).Magnitude
            if d <= max then
                out[#out + 1] = { kind = "p", pos = hs[i].Root.Position, text = "Horse", col = 6 }
            end
        end
    end

    -- Map.Puzzles holds the LeverMain parts; only 2 exist, so this is cheap
    if S.EspLevers and #out < POOL then
        local map = WS:FindFirstChild("Map")
        local puz = map and map:FindFirstChild("Puzzles")
        if puz then
            for _, d in ipairs(puz:GetDescendants()) do
                if #out >= POOL then break end
                if (d.ClassName == "MeshPart" or d.ClassName == "Part")
                   and string.find(string.lower(d.Name), "lever", 1, true) then
                    local dist = (d.Position - me).Magnitude
                    if dist <= max then
                        out[#out + 1] = { kind = "p", pos = d.Position,
                            text = "LEVER " .. math.floor(dist) .. "m", col = 7 }
                    end
                end
            end
        end
    end

    -- Muzan himself, once he has streamed in near you
    if S.EspMuzan and #out < POOL then
        local buckets = {}
        for _, hroot in ipairs({ WS:FindFirstChild("Humanoids"), WS:FindFirstChild("Debree") }) do
            local regs = hroot and hroot:FindFirstChild("Regions")
            for _, r in ipairs(regs and regs:GetChildren() or {}) do
                buckets[#buckets + 1] = r:FindFirstChild("ActiveNpcs")
                buckets[#buckets + 1] = r:FindFirstChild("StationaryNpcs")
            end
        end
        for _, act in ipairs(buckets) do
            if #out >= POOL then break end
            for _, f in ipairs(act and act:GetChildren() or {}) do
                if #out >= POOL then break end
                if string.find(string.lower(f.Name), "muzan", 1, true) then
                    local m = f:FindFirstChild(f.Name) or f:FindFirstChildOfClass("Model")
                    local root = f:FindFirstChild("HumanoidRootPart")
                                 or (m and m:FindFirstChild("HumanoidRootPart"))
                                 or f:FindFirstChildWhichIsA("BasePart")
                    local hum = f:FindFirstChildOfClass("Humanoid") or (m and m:FindFirstChildOfClass("Humanoid"))
                    if root then
                        local dist = (root.Position - me).Magnitude
                        if dist <= max then
                            local hp = ""
                            if hum then hp = " " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) end
                            out[#out + 1] = { kind = "p", pos = root.Position,
                                text = f.Name .. hp .. " " .. math.floor(dist) .. "m", col = 8 }
                        end
                    end
                end
            end
        end
    end

    -- flowers and herbs in Debree, and the clovers placed around the map
    if S.EspPlants and #out < POOL then
        local deb = WS:FindFirstChild("Debree")
        for _, item in ipairs(deb and deb:GetChildren() or {}) do
            if #out >= POOL then break end
            local low = string.lower(item.Name)
            -- spider lilies have a toggle of their own
            if (string.find(low, "flower", 1, true) or string.find(low, "herb", 1, true))
               and not string.find(low, "spider lily", 1, true) then
                local p = item
                if item.ClassName ~= "Part" and item.ClassName ~= "MeshPart" then
                    p = item:FindFirstChildWhichIsA("BasePart")
                end
                if p then
                    local dist = (p.Position - me).Magnitude
                    if dist <= max then
                        out[#out + 1] = { kind = "p", pos = p.Position,
                            text = item.Name .. " " .. math.floor(dist) .. "m", col = 10 }
                    end
                end
            end
        end
        local map = WS:FindFirstChild("Map")
        map = map and map:FindFirstChild("Map")
        local assets = map and map:FindFirstChild("Assets")
        local clovers = assets and assets:FindFirstChild("Clovers")
        for _, c in ipairs(clovers and clovers:GetChildren() or {}) do
            if #out >= POOL then break end
            local p = c
            if c.ClassName ~= "MeshPart" then p = c:FindFirstChildWhichIsA("BasePart") end
            if p then
                local dist = (p.Position - me).Magnitude
                if dist <= max then
                    out[#out + 1] = { kind = "p", pos = p.Position,
                        text = "Clover " .. math.floor(dist) .. "m", col = 10 }
                end
            end
        end
    end

    -- Final Selection fruit: loose parts parented straight to workspace
    if S.EspFruits and #out < POOL then
        local words = { "apple", "banana", "grape", "fruit", "peach", "mango", "melon",
                        "berry", "cherry", "kiwi", "orange", "pineapple", "coconut" }
        for _, item in ipairs(WS:GetChildren()) do
            if #out >= POOL then break end
            local ln = string.lower(item.Name)
            local hit = false
            for _, w in ipairs(words) do
                if string.find(ln, w, 1, true) then hit = true break end
            end
            if hit then
                local r = item
                if item.ClassName ~= "Part" and item.ClassName ~= "MeshPart" then
                    r = item:FindFirstChildWhichIsA("BasePart")
                end
                if r then
                    local dist = (r.Position - me).Magnitude
                    if dist <= max then
                        out[#out + 1] = { kind = "p", pos = r.Position,
                            text = item.Name .. " " .. math.floor(dist) .. "m", col = 9 }
                    end
                end
            end
        end
    end

    espList = out
end

-- Every Drawing write crosses into the host, so nothing is written twice.

-- Roblox moved the GUI layout fields (2026-09-24). Matcha's AbsoluteSize property now reads
-- Vector2(0, 0) for every GuiObject, so anything measured from it comes out as nothing. The
-- real size sits in memory next to AbsolutePosition. The offset is measured, not hardcoded:
-- a full-screen ScreenGui's AbsoluteSize is the viewport minus the topbar, so the right
-- offset is the float pair that matches the screen. It re-measures if sizes read zero again.
local GUISIZE = { off = 0x104, at = 0 }

function GUISIZE.calibrate()
    GUISIZE.at = tick()
    local okV, vp = pcall(function() return workspace.CurrentCamera.ViewportSize end)
    if not (okV and vp and vp.X > 1) then return end
    local okP, guis = pcall(function()
        return game:GetService("Players").LocalPlayer.PlayerGui:GetChildren()
    end)
    for _, g in ipairs(okP and guis or {}) do
        local okA, addr = pcall(function() return g.Address end)
        if okA and type(addr) == "number" and addr > 0 then
            for o = 0x80, 0x200, 4 do
                local okX, x = pcall(memory_read, "float", addr + o)
                local okY, y = pcall(memory_read, "float", addr + o + 4)
                if okX and okY and type(x) == "number" and type(y) == "number"
                    and math.abs(x - vp.X) < 1 and y > vp.Y - 120 and y <= vp.Y then
                    GUISIZE.off = o
                    return
                end
            end
        end
    end
end

-- the element's real AbsoluteSize, as a { X, Y } table
local function absSize(inst)
    local ok, s = pcall(function() return inst.AbsoluteSize end)
    -- half a pixel, not "> 0": a wrong offset often holds a denormal like 1.4e-45
    if ok and s and (s.X >= 0.5 or s.Y >= 0.5) then return s end -- a fixed Matcha build needs none of this
    local okA, addr = pcall(function() return inst.Address end)
    if not (okA and type(addr) == "number" and addr > 0) then return s end
    local function readPair()
        local okX, sx = pcall(memory_read, "float", addr + GUISIZE.off)
        local okY, sy = pcall(memory_read, "float", addr + GUISIZE.off + 4)
        if okX and okY and type(sx) == "number" and type(sy) == "number"
            and sx == sx and sy == sy and sx >= 0 and sy >= 0 and sx < 1e5 and sy < 1e5 then
            return { X = sx, Y = sy }
        end
    end
    local got = readPair()
    if got and (got.X >= 0.5 or got.Y >= 0.5) then return got end
    if tick() - GUISIZE.at > 1 then -- the offset moved again: measure it and retry
        pcall(GUISIZE.calibrate)
        return readPair() or s
    end
    return got or s
end

F.absSize = absSize   -- the crow menu measures its cards with it

local function paint(e, bx, by, bw, bh, tx, ty, text, col)
    if e.bx ~= bx or e.by ~= by then
        e.bx, e.by = bx, by
        e.box.Position = Vector2.new(bx, by)
    end
    if e.bw ~= bw or e.bh ~= bh then
        e.bw, e.bh = bw, bh
        e.box.Size = Vector2.new(bw, bh)
    end
    if e.col ~= col then
        e.col = col
        local c = PAL[col] or PAL[1]
        e.box.Color = c
        e.tag.Color = c
    end
    if e.tx ~= tx or e.ty ~= ty then
        e.tx, e.ty = tx, ty
        e.tag.Position = Vector2.new(tx, ty)
    end
    if e.text ~= text then
        e.text = text
        e.tag.Text = text
    end
    if not e.vis then
        e.vis = true
        e.box.Visible = true
        e.tag.Visible = true
    end
end

function F.espDraw()
    local pool = S.pool
    if not pool then return end
    local n = 0
    for i = 1, #espList do
        if n >= POOL then break end
        local t = espList[i]
        if t.kind == "m" then
            -- checked every frame it is drawn, so a mob that dies between two
            -- builds is dropped the moment its model goes
            local rp = F.npcAlive(t.npc, 0.6) and t.root.Position
            local top, v1, bot, v2
            if rp then
                top, v1 = WorldToScreen(rp + Vector3.new(0, 2.8, 0))
                bot, v2 = WorldToScreen(rp - Vector3.new(0, 3.2, 0))
            end
            if v1 and v2 then
                n = n + 1
                local h = bot.Y - top.Y
                local w = h * 0.5
                paint(pool[n], top.X - w * 0.5, top.Y, w, h, top.X, top.Y - 15, t.text, t.col)
            end
        else
            local sp, v = WorldToScreen(t.pos)
            if v then
                n = n + 1
                paint(pool[n], sp.X - 7, sp.Y - 7, 14, 14, sp.X, sp.Y - 17, t.text, t.col)
            end
        end
    end
    for i = n + 1, POOL do
        local e = pool[i]
        if e.vis then
            e.vis = false
            e.box.Visible = false
            e.tag.Visible = false
        end
    end
end

-- The draw loop is connected once, at load, and only switched on and off here
-- (see F.connectLoops for why nothing connects after the load).
function F.espSync()
    local on = F.espOn() and true or false
    if S.espLive and not on then F.espClear() end
    S.espLive = on
end

-- RenderStepped fires thousands of times a second in Matcha and a full repaint
-- is ~1.6ms, so the draw is capped at 60 Hz.
function F.drawFrame()
    if not S.espLive or not S.Running or not S.pool then return end
    local now = os.clock()
    if now - (S.lastDraw or 0) < 0.0166 then return end
    S.lastDraw = now
    F.mark("espdraw")
    local ok, err = pcall(F.espDraw)
    if not ok and now - (S.drawErrT or 0) > 5 then
        S.drawErrT = now
        F.logErr("esp", err)
    end
end

