        if a and b and a ~= b then
            label = k .. " (Lv " .. math.min(a, b) .. "/" .. math.max(a, b) .. ")"
        elseif a or b then
            label = k .. " (Lv " .. (a or b) .. ")"
        end
        lv = math.min(a or 999, b or 999)
    end
    qnames[#qnames + 1] = label
    qByLabel[label] = k
    qLevel[label] = info.Auto and -1 or lv
end
table.sort(qnames, function(x, y)
    if qLevel[x] ~= qLevel[y] then return qLevel[x] < qLevel[y] end
    return x < y
