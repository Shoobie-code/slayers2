-- Mirrors CU.Combat.get_equipped_Combat + punch()'s preset resolution.
-- Costs ~8 tree lookups, so the answer is reused until the tool changes.
local styleC = { t = -99, style = "Combat", item = nil }
function F.style()
    local now = os.clock()
    if now - styleC.t < 2.0 then return styleC.style, styleC.item end
    styleC.t = now
    local s, i = F.styleRaw()
    styleC.style, styleC.item = s, i
    return s, i
end

function F.styleRaw()
    local ch = lp.Character
    if not ch then return "Combat", nil end
    local anims = RS:FindFirstChild("Assets")
    anims = anims and anims:FindFirstChild("Animations")

    -- this game equips weapons as models under Character.Tool_Accessories,
    -- not as Tool instances, so check both
    local tool = nil
    local kids = ch:GetChildren()
    for i = 1, #kids do
        if kids[i].ClassName == "Tool" then tool = kids[i] break end
    end
    if not tool then
        local ta = ch:FindFirstChild("Tool_Accessories")
        if ta then tool = ta:GetChildren()[1] end
    end

    local name = nil
    local cam = RS:FindFirstChild("CAM")
    local cp = cam and cam.Client and cam.Client.Controllers
    cp = cp and cp:FindFirstChild("Skills_Provider")
    cp = cp and cp:FindFirstChild("CurPower")
    if cp and type(cp.Value) == "string" and cp.Value ~= "" and anims then
        for pw in string.gmatch(cp.Value, "[^,]+") do
            if anims:FindFirstChild(pw .. "_Combat_Anims") then name = pw break end
        end
    end
    if not name and tool and anims and anims:FindFirstChild(tool.Name .. "_Combat_Anims") then
        name = tool.Name
    end
    if not name and tool then name = tool.Name end
    if not name then name = "Combat" end

    if DB.Presets[name] then return name, nil end

    -- the catalog knows this weapon by name: no guessing needed
    local named = DB.StyleMap[string.lower(name)]
    if named then return named, nil end

    -- Weapon variants share one preset: "Damascus Sickles", "Blood Sickles"
    -- and "Nightfall Sickles" all fight as "Sickles", and the same holds for
    -- the katana and fan families. Take the longest preset the name contains.
    local low = string.lower(name)
    local best
    for word, preset in pairs(DB.StyleWords) do
        if string.find(low, word, 1, true) and DB.Presets[preset] then return preset, nil end
    end
    for preset in pairs(DB.Presets) do
        if preset ~= "Combat" then
            local pl = string.lower(preset)
            local hit = string.find(low, pl, 1, true) ~= nil
            if not hit and string.sub(pl, -1) == "s" then
                hit = (low == string.sub(pl, 1, -2)) or string.find(low, string.sub(pl, 1, -2), 1, true) ~= nil
            end
            if not hit then hit = (low .. "s" == pl) end
            if hit and (not best or #preset > #best) then best = preset end
        end
    end
    if best then return best, nil end

    return "Regular Katana", name
end

-- Swings with the real mouse button. The game's combat client picks up the
-- press, resolves the style and combo itself and fires the remote.
function F.targetBlocking()
    if not S.SkipBlocking then return false end
    local cur = S.cur
    if not cur or not cur.Model or not F.curAlive(cur) then return false end
    local b
    local ok = pcall(function() b = cur.Model:FindFirstChild("Blocking") end)
    return ok and b ~= nil
end

-- is the current target guarding right now (whatever "skip blocking" says)
function F.curBlocking()
    local cur = S.cur
    if not cur or not cur.Model or not F.curAlive(cur) then return false end
    local b
    local ok = pcall(function() b = cur.Model:FindFirstChild("Blocking") end)
    return ok and b ~= nil
end

function F.attack(now)
    local ch = lp.Character
    if not ch then return end
    now = now or os.clock()

    -- the pointer is on the open menu: let the user click the menu instead of
    -- swinging, or every other click of theirs is swallowed by the guard
    if F.onMenu() then
        F.clickRelease()
        return
    end


    -- release a press whose hold has elapsed, then wait out the gap
    if S.lmbDown then
        if now >= S.lmbRelease then
            pcall(function() mouse1release() end)
            S.lmbDown = false
            S.atkNext = now + S.AttackDelay
        end
        return
    end

    if now < (S.atkNext or 0) then return end
    if not F.focused(now) then return end

    local cur = S.cur
    if cur and S.Reach > 0 then
        local d
        local okd = pcall(function()
            d = (cur.Root.Position - ch.HumanoidRootPart.Position).Magnitude
        end)
        if okd and d and d > S.Reach then return end
    end

    if F.targetBlocking() then
        S.blockedT = now
        if S.cur then S.cur.t = now end   -- being blocked is not a stall
        return
    end

    -- a dungeon card offer is on screen: this press is a real click and would
    -- pick whatever card the cursor sits on, so no swing until it is taken
    if S.Mode == "dungeon" and F.dungeonCardsShown() then return end

    S.lmbDown = true
    S.lmbRelease = now + S.ClickHold
    S.atkCount = (S.atkCount or 0) + 1
    pcall(function() mouse1press() end)
end

-- Releases only the press F.attack made. It runs every idle frame, so it must
-- never touch a button it does not own: that used to release the player's own
-- clicks and auto fish's minigame hold.
function F.clickRelease()
    if S.lmbDown then pcall(function() mouse1release() end) end
    S.lmbDown = false
end

-- where we want to be, relative to the target, for the chosen stance
function F.goalFor(root)
    local p = root.Position
    local off = S.Offset
    if S.Stance == "On Top" then
        return p + Vector3.new(0, off, 0)
    elseif S.Stance == "Above (Hover)" then
        return p + Vector3.new(0, off + 4, 0)
    elseif S.Stance == "Behind" then
        -- CFrame multiplication is unreliable here (cf * CFrame.new(0,0,n)
        -- came back with the front point's X and the behind point's Z), so
        -- step backwards along the look vector by hand.
        local lv
        if pcall(function() lv = root.CFrame.LookVector end) and lv then
            local fx, fz = lv.X, lv.Z
            local m = math.sqrt(fx * fx + fz * fz)
            if m > 0.001 then
                return Vector3.new(p.X - fx / m * off, p.Y + 0.8, p.Z - fz / m * off)
            end
        end
        return p + Vector3.new(0, 0.8, off)
    end
    return p - Vector3.new(0, off, 0)   -- Under Target
end

-- Velocity steering, driven every heartbeat. A single write gets overwritten
-- before the physics step, but writing each frame holds: measured 61.9 studs
-- in 2.5s at a commanded 25 studs/s. Long gaps still warp once, because
-- crossing 300 studs at walking pace would stall the farm.
function F.steer()
    local cur = S.cur
    if not cur or not F.curAlive(cur) then return end
    local _, hrp = F.char()
    if not hrp then return end

    local goal, tpos
    local ok = pcall(function()
        tpos = cur.Root.Position
        goal = F.goalFor(cur.Root)
    end)
    if not ok or not goal then return end

    local pos = hrp.Position
    local dx, dy, dz = goal.X - pos.X, goal.Y - pos.Y, goal.Z - pos.Z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)

    if S.Smooth and dist > S.WarpAbove then
        -- close the long gap once, then steer the rest
        pcall(function()
            hrp.CFrame = CFrame.new(goal.X, goal.Y + 2, goal.Z)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)
        return
    end
    if not S.Smooth then
        pcall(function()
            hrp.CFrame = CFrame.lookAt(goal, tpos)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)
        return
    end

    if dist < 0.4 then
        -- settled: hold position and face the target, because the server falls
        -- back to lookVector for the hitbox once velocity drops off
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
        if tpos then
            local fx, fz = tpos.X - pos.X, tpos.Z - pos.Z
            if (fx * fx + fz * fz) > 0.02 then
                pcall(function()
                    hrp.CFrame = CFrame.lookAt(pos, Vector3.new(tpos.X, pos.Y, tpos.Z))
                end)
            end
        end
        return
    end

    -- proportional approach, capped, so it eases in instead of snapping
    local sp = dist * 5.0
    if sp > S.MoveSpeed then sp = S.MoveSpeed end
    local k = sp / dist
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.new(dx * k, dy * k, dz * k)
    end)
end

-- Camera.CFrame writes are accepted but the engine owns the camera and
-- discards them, so the camera is turned the same way a player turns it:
-- right button held while the mouse moves. Measured 0.001747 rad per count.
-- MouseButton2 is unbound in this game (only MouseButton1 is), so holding it
-- rotates the camera and nothing else.
local RAD_PER_COUNT = 0.001747

function F.camYaw()
    local cam = WS.CurrentCamera
    if not cam then return nil end
    local lv
    local ok = pcall(function() lv = cam.CFrame.LookVector end)
    if not ok or not lv then return nil end
    return math.atan2(-lv.X, -lv.Z)
end

-- Signed, measured live: +X counts turn yaw negative, +Y counts pitch down.
local YAW_PER_COUNT = -0.001747
local PITCH_PER_COUNT = -0.001345

-- Lets go of the right button - but only a press this script made. It used to
-- also release the button whenever it read as down, as a guard against a stuck
-- flag; since this runs every frame the script is not aiming, that released the
-- player's own right-drag within a frame, and the camera could barely be moved.
function F.aimRelease()
    if S.rmbDown then
        pcall(function() mouse2release() end)
        S.rmbRelT = os.clock()
    end
    S.rmbDown = false
    S.aimActive = false
end

-- Continuous aimlock: right button stays held so the camera can be driven
-- every frame, instead of tapping it for one nudge at a time.
-- force = aim even with the aimlock toggle off (quest givers)
function F.aimStep(targetPos, force)
    if (not S.AimLock and not force) or not targetPos then return F.aimRelease() end
    if S.win and S.win:IsVisible() then return F.aimRelease() end   -- give the mouse back
    if isrbxactive then
        local okf, act = pcall(isrbxactive)
        if okf and not act then return F.aimRelease() end
    end

    -- The player turning the camera themselves wins: their own right button
    -- (down while this script is not holding it) hands the camera over, for as
    -- long as they hold it and a moment after.
    local now = os.clock()
    if not S.rmbDown and ismouse2pressed and now - (S.rmbRelT or 0) > 0.15 then
        local okm, down = pcall(ismouse2pressed)
        if okm and down then S.aimYieldUntil = now + 1.5 end
    end
    if now < (S.aimYieldUntil or 0) then return F.aimRelease() end

    local cam = WS.CurrentCamera
    if not cam then return F.aimRelease() end
    local cf
    if not pcall(function() cf = cam.CFrame end) or not cf then return end
    local cpos, lv = cf.Position, cf.LookVector

    local dx = targetPos.X - cpos.X
    local dy = targetPos.Y - cpos.Y
    local dz = targetPos.Z - cpos.Z
    local horiz = math.sqrt(dx * dx + dz * dz)
    if horiz < 0.01 then return end

    local ey = math.atan2(-dx, -dz) - math.atan2(-lv.X, -lv.Z)
    while ey > math.pi do ey = ey - 2 * math.pi end
    while ey < -math.pi do ey = ey + 2 * math.pi end
    local ep = math.atan2(dy, horiz) - math.asin(lv.Y)

    -- A target roughly in view is left alone, right button up, so the camera
    -- stays where the player put it. Only once it drifts well off-centre (about
    -- 9 degrees) is it brought back, and only until it is close again - it used
    -- to be held dead-centre every frame with the button down, which undid any
    -- drag the moment it happened.
    local off = math.max(math.abs(ey), math.abs(ep))
    if S.aimActive then
        if off < 0.03 then return F.aimRelease() end
    elseif off < 0.15 then
        return F.aimRelease()
    else
        S.aimActive = true
    end

    if not S.rmbDown then
        pcall(function()
            mouse2press()
        end)
        S.rmbDown = true
    end

    local cx = ey / YAW_PER_COUNT * S.AimGain
    local cy = ep / PITCH_PER_COUNT * S.AimGain
    if cx > 900 then cx = 900 elseif cx < -900 then cx = -900 end
    if cy > 600 then cy = 600 elseif cy < -600 then cy = -600 end
    pcall(function() mousemoverel(cx, cy) end)
end

-- The toggles are the source of truth. Mirroring them into sk.on let the
-- two drift apart, so they get re-read rather than trusted.
function F.syncSkills()
    if not S.Skills or not S.win then return end
    for i = 1, #S.Skills do
        local sk = S.Skills[i]
        local v
        if pcall(function() v = S.win:GetValue("sk_" .. sk.name .. "_on") end) and v ~= nil then
            sk.on = v and true or false
        end
    end
end

function F.skillsRelease()
    for i = 1, #(S.Skills or {}) do
        local sk = S.Skills[i]
        if sk.vk and sk.vk > 0 then
            pcall(function() keyrelease(sk.vk) end)
        end
        sk.rel = 0
    end
end

-- Plain spam: every enabled key presses on its own repeating gap whenever the
-- target is inside that key's range. No rotation, no cast checking - the game
-- swallows a press for a skill that is not ready and that is fine.
function F.skillStep(now, dist)
    if not S.Skills then return end
    if (now - (S.skillSyncT or 0)) > 1.0 then
        S.skillSyncT = now
        pcall(F.syncSkills)
    end
    local blocking   -- looked up at most once per call, and only if needed
    for i = 1, #S.Skills do
        local sk = S.Skills[i]
        if sk.rel > 0 then
            if now >= sk.rel then
                pcall(function() keyrelease(sk.vk) end)
                sk.rel = 0
                sk.next = now + S.SkillGap
            end
        elseif sk.on and dist and dist <= sk.dist and now >= (sk.next or 0)
           and (not sk.breaker or (function()
                if blocking == nil then
                    local ok, b = pcall(F.curBlocking)
                    blocking = ok and b == true
                end
                return blocking
            end)()) then
            sk.rel = now + sk.hold
            pcall(function()
                keypress(sk.vk)
            end)
        end
    end
end


----------------------------------------------------------------------
-- loot: caches and boss drops
----------------------------------------------------------------------
-- ProximityPrompt properties all read nil through Matcha and
-- fireproximityprompt does not exist, so every pickup is "stand on it and
-- hold T". Positions are re-read each tick because drops settle after spawning.

-- warp the long gap, steer the short one
function F.travelTo(pos, now)
    local _, hrp = F.char()
    if not hrp then return end
    local p = hrp.Position
    local dx, dy, dz = pos.X - p.X, (pos.Y + 3) - p.Y, pos.Z - p.Z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
    if dist > S.WarpAbove or not S.Smooth then
        pcall(function()
            hrp.CFrame = CFrame.new(pos.X, pos.Y + 3, pos.Z)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)
        return
    end
    if dist < 1 then return end
    local sp = dist * 5.0
    if sp > S.MoveSpeed then sp = S.MoveSpeed end
    local k = sp / dist
    pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(dx * k, dy * k, dz * k) end)
end

-- keypress and mouse input go nowhere while roblox is in the background
function F.focused(now)
    if not isrbxactive then return true end
    local okf, act = pcall(isrbxactive)
    if not okf then return true end
    if act then return true end
    if now and (now - (S.warnedFocus or 0)) > 15 then
        S.warnedFocus = now
        F.notify("roblox not focused - T pickups paused", 4)
    end
    return false
end

-- Snow mounds sit in the same folder but are not boss loot: tapping them
-- drags the sweeper across Iceveil for nothing.
local function isMound(name)
    local low = string.lower(name)
    return string.find(low, "mound", 1, true) ~= nil or string.find(low, "snow", 1, true) ~= nil
end

function F.openChests()
    local out = {}
    local folder = WS:FindFirstChild("Chests")
    if not folder then return out end
    for _, c in ipairs(folder:GetChildren()) do
        if not c:FindFirstChild("SealVFX") and not isMound(c.Name) then
            local r = c
            if c.ClassName ~= "Part" and c.ClassName ~= "MeshPart" then
                r = c:FindFirstChild("RootPart") or c:FindFirstChildWhichIsA("BasePart")
            end
            if r then out[#out + 1] = { Name = c.Name, Root = r, Node = c } end
        end
    end
    return out
end

function F.collectStart(items, label)
    if not items or #items == 0 then return false end
    S.collect = { list = items, i = 1, phase = "move", t = os.clock() }
    F.notify((label or "collecting") .. ": " .. #items .. " item(s)", 3)
    return true
end

function F.collectStop()
    S.collect = nil
    F.aimRelease()
    pcall(function() keyrelease(84) end)
end

-- returns true while it still owns the character
function F.collectStep(now)
    local c = S.collect
    if not c then return false end
    local _, hrp = F.char()
    if not hrp then return true end

    if not F.focused(now) then
        c.blocked = c.blocked or now
        if (now - c.blocked) > 6 then
            F.collectStop()
                    return false          -- hand the tick back to the farm
        end
        return true
    end
    c.blocked = nil

    local item = c.list[c.i]
    if not item then
        F.collectStop()
        F.notify("loot collected", 2)
        return false
    end

    local pos
    if not pcall(function() pos = item.get() end) or not pos then
        c.i = c.i + 1 c.phase = "move" c.t = now
        pcall(function() keyrelease(84) end)
        return true
    end

    -- face what is being collected, so the chest is in view while T is pressed
    pcall(F.aimStep, Vector3.new(pos.X, pos.Y + 1.5, pos.Z), true)

    -- warping into a chest mesh gets the character ejected (measured 43
    -- studs away), so chests are approached from beside them
    local gx, gy, gz = pos.X, pos.Y + (item.lift or 2.5), pos.Z
    if item.side then gx = gx + 6 gy = pos.Y + 3 end
    local p = hrp.Position
    local dx, dy, dz = gx - p.X, gy - p.Y, gz - p.Z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)

    if c.phase == "move" then
        if dist > S.WarpAbove then
            pcall(function()
                hrp.CFrame = CFrame.new(pos.X, pos.Y + 3, pos.Z)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end)
        elseif dist > (item.reach or 3.5) then
            local sp = dist * 5.0
            if sp > S.MoveSpeed then sp = S.MoveSpeed end
            local k = sp / dist
            pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(dx * k, dy * k, dz * k) end)
        else
            pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
            -- stand still long enough for the warp to reach the server before
            -- interacting, or a client-side prompt's progress gets rejected
            c.settle = c.settle or (now + S.SettleT)
            if now < c.settle then return true end
            c.settle = nil
            c.phase = "hold"
            c.t = now
            pcall(function()
                keypress(84)
            end)
        end
        if now - c.t > 10 then     -- unreachable, skip it
            c.i = c.i + 1 c.phase = "move" c.t = now c.settle = nil
        end
    else
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
        -- you press T on a chest, but hold it on what the chest spits out
        local want = item.hold or (item.tap and 0.2 or S.HoldT)
        if now - c.t >= want then
            pcall(function() keyrelease(84) end)
            -- a soul expires quickly and the hold does not always take, so try
            -- again while it is still there
            local again = false
            if item.soul and (item.tries or 0) < 2 then
                local p2
                if pcall(function() p2 = item.get() end) and p2 then
                    local d2 = (p2 - hrp.Position).Magnitude
                    if d2 < (item.reach or 6) + 3 then
                        item.tries = (item.tries or 0) + 1
                        again = true
                    end
                end
            end
            if not again then c.i = c.i + 1 end
            c.phase = "move" c.t = now c.settle = nil
        end
    end
    return true
end

-- everything a dead boss left behind, near where it fell
-- Souls drop as models in Debree with a SoulPrompt on their Root; they are
-- claimed the same way as ground loot, by standing on one and holding T.
function F.soulsNear(pos, radius)
    local out = {}
    local deb = WS:FindFirstChild("Debree")
    if not deb then return out end
    local function consider(c)
        local low = string.lower(c.Name)
        -- "<X> Soul" only: the SoulGroundHost part and the grab vfx also carry
        -- the word and were being queued as extra pickups
        if not string.match(low, "soul$") then return end
        if string.find(low, "host", 1, true) or string.find(low, "grab", 1, true) then return end
        local r = c
        if c.ClassName ~= "Part" and c.ClassName ~= "MeshPart" then
            r = c:FindFirstChild("Root") or c:FindFirstChildWhichIsA("BasePart")
        end
        if not r then return end
        for i = 1, #out do if out[i].root == r then return end end
        local dist
        if pcall(function() dist = (r.Position - pos).Magnitude end) and dist and dist <= radius then
            out[#out + 1] = {
                root = r,
                get = function() return r.Position end,
                soul = true,
                -- a soul hovers above the ground, so aim at the soul itself and
                -- press from inside prompt range instead of walking onto a spot
                -- 2.5 studs above it, which never got close enough
                hold = math.max(S.HoldT or 2, 2.5),
                lift = 0,
                reach = 6,
            }
        end
    end
    for _, c in ipairs(deb:GetChildren()) do
        consider(c)
        -- some spawn inside a holder folder rather than directly in Debree
        if c.ClassName == "Folder" or c.ClassName == "Model" then
            for _, d in ipairs(c:GetChildren()) do consider(d) end
        end
    end
    return out
end

-- Souls expire, so they get their own step rather than a place in the loot
-- queue: walk onto the nearest one and hold T over and over until it is gone.
function F.soulStep(now)
    if not S.AutoSouls then return false end
    local _, hrp = F.char()
    if not hrp then return false end
    local st = S.soul
    if now - (st and st.chk or 0) < 0.25 then
        -- keep the current claim running between checks
        if not st or not st.pos then return false end
    end

    local near = F.soulsNear(hrp.Position, S.LootRange)
    if #near == 0 then
        if st then
            if st.held then pcall(function() keyrelease(84) end) end
            S.soul = nil
        end
        return false
    end
    -- nearest one first
    local best, bd
    for i = 1, #near do
        local p
        if pcall(function() p = near[i].get() end) and p then
            local d = (p - hrp.Position).Magnitude
            if not bd or d < bd then best, bd = p, d end
        end
    end
    if not best then return false end
    if not st then st = { t = now, tries = 0 } S.soul = st end
    st.chk = now
    st.pos = best

    if bd > 6 then
        st.held = false
        pcall(function() keyrelease(84) end)
        F.travelTo(Vector3.new(best.X, best.Y - 3, best.Z), now)   -- travelTo adds 3
        if now - st.t > 20 then S.soul = nil end                   -- unreachable
        return true
    end

    pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
    pcall(F.aimStep, best, true)
    if not F.focused(now) then return true end
    -- hold T, release briefly, hold again: one press is not always taken
    local hold = math.max(S.HoldT or 2, 2.5)
    if not st.held then
        if now - (st.rel or 0) < 0.15 then return true end
        st.held = true
        st.pressT = now
        pcall(function() keypress(84) end)
    elseif now - (st.pressT or now) > hold then
        st.held = false
        st.rel = now
        st.tries = st.tries + 1
        pcall(function() keyrelease(84) end)
        if st.tries >= 6 then S.soul = nil end       -- give up on this one
    end
    return true
end

-- the part to stand on for a pickup node (a Part itself, or the one inside it)
function F.partOf(node, prefer)
    local cls = node.ClassName
    if cls == "Part" or cls == "MeshPart" then return node end
    return (prefer and node:FindFirstChild(prefer)) or node:FindFirstChildWhichIsA("BasePart")
end

-- a child of folder with this address, looked up fresh (nil once it is gone)
function F.refind(folder, addr)
    if not folder or not addr then return nil end
    local kids = folder:GetChildren()
    for i = 1, #kids do
        if F.addr(kids[i]) == addr then return kids[i] end
    end
    return nil
end

-- A pickup (drop, chest, quest prop) waits in a list and is walked to one at a
-- time, which takes seconds - by then someone else may have picked it up and
-- Roblox freed it. So its handle is only read while it is watched (the current
-- item, every frame). After a longer gap it is found again by address in a
-- fresh listing of its folder, and one that is no longer there is skipped
-- without touching the old handle.
-- folderFn returns the folder, looked up fresh; extra holds the item's flags.
function F.pickup(folder, folderFn, node, part, prefer, extra)
    local it = extra or {}
    it.folderFn, it.prefer = folderFn, prefer
    it.node, it.part = node, part
    it.addr, it.pAddr = F.addr(node), F.addr(folder)
    it.seen = os.clock()
    it.get = function() return F.pickupPos(it) end
    return it
end

function F.pickupPos(it)
    if it.gone then return nil end
    local now = os.clock()
    -- The old handle is never asked whether it is still there. Reading .Parent
    -- on a drop that was taken and freed in the same instant is itself a read
    -- into freed memory, and the game gives no grace frame - that is a crash
    -- that takes Matcha with it, on any pickup, which is why it looked like
    -- "turning autofarm on crashes" (see the "instant" case in
    -- tests/test_s2_handles.py). So it is found again by address in a fresh
    -- listing, once a frame, and the position comes off that fresh handle.
    if now - (it.seen or 0) > 0.016 then
        local folder = it.folderFn()
        local node = F.refind(folder, it.addr)
        local part = node and F.partOf(node, it.prefer)
        if not part then it.gone = true return nil end
        it.node, it.part, it.pAddr = node, part, F.addr(folder)
        it.seen = now
    end
    local ok, p = pcall(function() return it.part.Position end)
    if ok and p then return p end
    return nil
end

local function lootFolder() return WS:FindFirstChild("LootDrops") end
local function chestFolder() return WS:FindFirstChild("Chests") end

function F.lootNear(pos, radius)
    local items = {}
    local now = os.clock()

    local ld = lootFolder()
    if ld then
        for _, d in ipairs(ld:GetChildren()) do
            local r = F.partOf(d)
            if r then
                local dist
                if pcall(function() dist = (r.Position - pos).Magnitude end) and dist and dist <= radius then
                    items[#items + 1] = F.pickup(ld, lootFolder, d, r)
                end
            end
        end
    end
    local cf = chestFolder()
    for _, c in ipairs(F.openChests()) do
        local dist
        if pcall(function() dist = (c.Root.Position - pos).Magnitude end)
           and dist and dist <= radius then
            local p2 = c.Root.Position
            local key = c.Name .. "@" .. math.floor(p2.X) .. "," .. math.floor(p2.Z)
            local last = S.chestTap[key]
            if not last or (now - last) > 45 then
                S.chestTap[key] = now
                -- the chest first, so its contents are on the ground before
                -- the sweep finishes
                table.insert(items, 1, F.pickup(cf, chestFolder, c.Node, c.Root, "RootPart",
                    { tap = true, side = true }))
            end
        end
    end
    return items
end




----------------------------------------------------------------------
-- auto dungeon (Ouwigahara)
----------------------------------------------------------------------
-- A run is waves of npcs under Regions.Ouwigahara, plus summoned extras under
-- Regions.Temporary that carry an OuwigaharaMark, and between floors an offer
-- of upgrade cards. Player.OuwigaharaOffers holds the offers as objects with
-- Title / Description / Type / Stat / Rarity attributes (and "Picked" on the
-- holder); the cards themselves are clicked in
-- ComponentsHolder.MainNotificationFrame.OuwigaharaOffers. Layout and card
-- scoring come from the reference hub the user supplied.
function F.dAttr(obj, name, fallback)
    local ok, v = pcall(function() return obj:GetAttribute(name) end)
    if ok and v ~= nil then return v end
    return fallback
end

-- a points/score multiplier printed on the card (1.2 = +20%), or nil
function F.dungeonMult(card, allText)
    for _, an in ipairs({ "PointMultiplier", "PointsMultiplier", "ScoreMultiplier" }) do
        local v = tonumber(F.dAttr(card, an, nil))
        if v and v > 0 then
            if v > 100 then return v / 100 end
            if v > 10 then return 1 + v / 100 end
            return v
        end
    end
    if not string.find(allText, "point", 1, true) and not string.find(allText, "score", 1, true) then
        return nil
    end
    local t = string.gsub(allText, "\195\151", "x")    -- the multiplication sign
    local m = tonumber(string.match(t, "x%s*(%d+%.?%d*)")) or tonumber(string.match(t, "(%d+%.?%d*)%s*x"))
    if m then return m end
    local pct = tonumber(string.match(t, "(%d+%.?%d*)%s*%%"))
    if pct then return 1 + pct / 100 end
    return nil
end

-- Higher is better. Points multipliers first (by value), then boss rush,
-- ascension and lucky draw, then high-rarity damage/health/attack-speed buffs;
-- anything that takes something away (no dash, less health, slower) sinks.
-- Second Wind is avoided unless health has been low recently.
function F.dungeonScore(card, wantSecondWind)
    local title = tostring(F.dAttr(card, "Title", card.Name) or "")
    local desc = tostring(F.dAttr(card, "Description", "") or "")
    local ctype = tostring(F.dAttr(card, "Type", "") or "")
    local stat = tostring(F.dAttr(card, "Stat", "") or "")
    local all = string.lower(title .. " " .. desc .. " " .. ctype .. " " .. stat)
    local compact = string.gsub(all, "[%s_%-]", "")

    if string.find(compact, "secondwind", 1, true) then
        return wantSecondWind and 2000000 or -50000
    end
    local mult = F.dungeonMult(card, all)
    if mult then return 1000000 + math.min(math.max(mult, 0), 9) * 100000 end
    if string.find(compact, "bossrush", 1, true) then return 960000 end
    if string.find(all, "ascension", 1, true) then return 950000 end
    if string.find(compact, "luckydraw", 1, true) then return 900000 end

    local rv = F.dAttr(card, "Rarity", 1)
    local rarity = tonumber(rv) or 1
    local rname = string.lower(tostring(rv))
    -- the game's rarity table: 3 Rare (blue), 5 Legendary, 6 Mythic (red)
    local legendary = string.find(all, "legendary", 1, true) ~= nil or rarity == 5
        or string.find(rname, "legendary", 1, true) ~= nil
    local red = rarity == 6 or string.find(rname, "mythic", 1, true) ~= nil or rname == "red"
    local blue = rarity == 3 or string.find(rname, "rare", 1, true) ~= nil or rname == "blue"

    local harmful = false
    for _, phrase in ipairs(DB.DungeonBad) do
        if string.find(all, phrase, 1, true) then harmful = true break end
    end
    if not harmful and (red or legendary or blue) then
        local dmg = string.find(all, "damage", 1, true) or string.find(all, "dmg", 1, true)
        local hp = string.find(all, "health", 1, true) or string.find(all, "heal", 1, true)
            or string.find(all, "hp", 1, true) or string.find(all, "life", 1, true)
        local aspd = string.find(compact, "attackspeed", 1, true) or string.find(all, "faster attacks", 1, true)
        if dmg or hp or aspd then
            return red and 880000 or (legendary and 870000 or 860000)
        end
    end
    local score = 0
    if red then score = score + 70000
    elseif legendary then score = score + 60000
    elseif blue then score = score + 50000 end
    if harmful then
        score = score - 100000
    else
        score = score + 10000
        if string.find(all, "heal", 1, true) or string.find(all, "health", 1, true)
           or string.find(all, "regen", 1, true) or string.find(all, "points", 1, true) then
            score = score + 10000
        end
    end
    return score
end

DB.DungeonBad = {
    "cannot dash", "can't dash", "no dash", "double jump", "no jumping",
    "cannot jump", "less health", "reduced health", "max health reduced",
    "lose health", "health is reduced", "take more damage", "damage taken",
    "slower", "reduced damage", "less damage", "enemies deal more",
    "reduced attack speed", "less attack speed", "slower attacks",
}

-- the clickable part of one offered card, or nil while it is not on screen
function F.dungeonOfferButton(cardName)
    local pg = lp:FindFirstChild("PlayerGui")
    local ch = pg and pg:FindFirstChild("ComponentsHolder")
    local main = ch and ch:FindFirstChild("MainNotificationFrame")
    local gui = main and main:FindFirstChild("OuwigaharaOffers")
    if not gui then return nil end
    local card = gui:FindFirstChild(cardName)
    if not card then
        for _, o in ipairs(gui:GetDescendants()) do
            if o.Name == cardName and o.ClassName == "Frame" then card = o break end
        end
    end
    if not card then return nil end
    for _, o in ipairs(card:GetDescendants()) do
        if o.ClassName == "TextButton" or o.ClassName == "ImageButton" then return o end
    end
    return card
end

-- An unpicked offer is on screen right now, looked up fresh. The click build
-- asks this right before each swing: a swing there is a real click, and one
-- landing while the cards are up picks whichever card the cursor is over. A
-- flag set by the 4x-a-second card check left a gap a swing got through.
function F.dungeonCardsShown()
    local offers = lp:FindFirstChild("OuwigaharaOffers")
    if not offers or #offers:GetChildren() == 0 then return false end
    if F.dAttr(offers, "Picked", false) == true then return false end
    local pg = lp:FindFirstChild("PlayerGui")
    local ch = pg and pg:FindFirstChild("ComponentsHolder")
    local main = ch and ch:FindFirstChild("MainNotificationFrame")
    local gui = main and main:FindFirstChild("OuwigaharaOffers")
    return gui ~= nil and #gui:GetChildren() > 0
end

-- Picks a card when an offer is up. True on the frame it clicks, so the fight
-- steps aside for that moment and nothing else.
function F.dungeonCard(now)
    local d = S.dungeon
    if now < (d.cardAt or 0) then return false end
    d.cardAt = now + 0.25                  -- GetAttribute is 1.6ms a call: look 4x a second
    local offers = lp:FindFirstChild("OuwigaharaOffers")
    if not offers then return false end
    -- Picked is a plain boolean; false must not pause the fight
    if F.dAttr(offers, "Picked", false) == true then return false end
    local kids = offers:GetChildren()
    if #kids == 0 then return false end
    if not F.focused(now) or not F.scrOffset(now) then return false end
    local best, bestScore
    for _, o in ipairs(kids) do
        local title = tostring(F.dAttr(o, "Title", o.Name) or o.Name)
        local desc = tostring(F.dAttr(o, "Description", "") or "")
        local low = string.lower(o.Name .. " " .. title .. " " .. desc)
        if not string.find(low, "mother bear", 1, true) and not string.find(low, "reroll", 1, true) then
            local sc = F.dungeonScore(o, (d.swRounds or 0) > 0)
            if not bestScore or sc > bestScore then best, bestScore = o, sc end
        end
    end
    if not best then return false end
    local btn = F.dungeonOfferButton(best.Name)
    if not btn then return false end
    local ap
    pcall(function() ap = btn.AbsolutePosition end)
    if not ap then return false end
    local sz = F.absSize and F.absSize(btn)
    local w, h = sz and tonumber(sz.X) or 0, sz and tonumber(sz.Y) or 0
    F.dlgClickAt(ap.X + (w > 4 and w * 0.5 or 40), ap.Y + (h > 4 and h * 0.5 or 14))
    d.cardAt = now + 0.75
    if (d.swRounds or 0) > 0 then d.swRounds = d.swRounds - 1 end
    F.notify("dungeon: took " .. tostring(F.dAttr(best, "Title", best.Name) or best.Name), 3)
    return true
end

-- Health watch, then the card. True while the fight should step aside.
function F.dungeonStep(now)
    local d = S.dungeon
    if not d then d = {} S.dungeon = d end
    local _, _, hum = F.char()
    if hum then
        local hp, mx = 0, 0
        pcall(function() hp = hum.Health mx = hum.MaxHealth end)
        if mx > 0 and hp > 0 then
            local r = hp / mx
            if d.lowHp then
                if r >= 0.85 then d.lowHp = false end
            elseif r <= 0.75 then
                d.lowHp = true
                d.swRounds = 2
                F.notify("dungeon: health low - taking Second Wind for the next 2 picks", 4)
            end
        end
    end
    return F.dungeonCard(now)
end

-- names allowed from Regions.Temporary without the dungeon's mark
function F.dungeonNames()
    if DB.DungeonNames then return DB.DungeonNames end
    local set = { ["cache trainee"] = true }
    for _, n in ipairs(DB.Mobs) do if not string.find(n, "^All ") then set[string.lower(n)] = true end end
    for _, n in ipairs(DB.Bosses) do if not string.find(n, "^All ") then set[string.lower(n)] = true end end
    DB.DungeonNames = set
    return set
end

-- Every live dungeon npc, in the same shape F.scan returns, so the farm's own
-- lock, steer, aim and swing all apply (and F.curAlive can find each again).
function F.dungeonTargets(now)
    local d = S.dungeon
    if not d then d = {} S.dungeon = d end
    if d.listAt and now - d.listAt < 0.3 then return d.list or {} end
    d.listAt = now
    local out = {}
    local allowed = F.dungeonNames()
    for _, src in ipairs({ "Humanoids", "Debree" }) do
        local root = WS:FindFirstChild(src)
        local regs = root and root:FindFirstChild("Regions")
        for _, rn in ipairs({ "Ouwigahara", "Temporary" }) do
            local reg = regs and regs:FindFirstChild(rn)
            local act = reg and reg:FindFirstChild("ActiveNpcs")
            for _, item in ipairs(act and act:GetChildren() or {}) do
                local nm = item.Name
                if not playerNames[nm] then
                    local model = item:FindFirstChildOfClass("Model")
                    if not model and item.ClassName == "Model" then model = item end
                    if model then
                        local ok = rn ~= "Temporary" or allowed[string.lower(nm)] == true
                        if not ok then
                            ok = (model:FindFirstChild("OuwigaharaMark") or item:FindFirstChild("OuwigaharaMark")) ~= nil
                        end
                        local hum = ok and model:FindFirstChildOfClass("Humanoid")
                        local hrp = hum and model:FindFirstChild("HumanoidRootPart")
                        local alive = false
                        if hrp then pcall(function() alive = hum.Health > 0 end) end
                        if alive then
                            local e = { Model = model, Hum = hum, Root = hrp, Name = nm, Boss = F.isBoss(item) }
                            e.PAddr = F.addr(item)
                            e.IAddr = e.PAddr
                            e.MAddr = F.addr(model)
                            e.Src, e.Region, e.chkT = src, rn, now
                            out[#out + 1] = e
                        end
                    end
                end
            end
        end
    end
    d.list = out
    return out
end

----------------------------------------------------------------------
-- crow farm: let the crow hand out a boss hunt, then fight it
----------------------------------------------------------------------
-- The crow is used from the hotbar (slot key, then a click). Its mission list
-- is a set of cards reading "Defeat <boss>"; clicking one starts that boss's
-- quest. Mother Bear is skipped. Once the quest is in, the normal boss
-- machinery does the fighting, so stances, skills and travel all apply.
-- The whole name after "Defeat", matched exactly. It used to find a boss name
-- anywhere in the text, so "Defeat Reaper Trainee Kuzan" read as the boss Reaper:
-- a different npc, and a hunt the game refuses above its level range.
function F.crowBossFromText(txt)
    local low = string.lower(tostring(txt or ""))
    local who = string.match(low, "defeat%s+(.-)%s*$")
    if not who or who == "" or who == "mother bear" then return nil end
    for _, name in ipairs(DB.Bosses) do
        if name ~= "All Bosses" and name ~= "Mother Bear" and string.lower(name) == who then
            return name
        end
    end
    return nil
end

-- the crow's mission cards: { x, y, boss }, topmost first
function F.crowChoices()
    -- The walk below covers the whole PlayerGui, so it is worth real time; the
    -- offers do not move, and every phase of the crow asks for them, so the
    -- answer is held for a third of a second.
    local nowC = os.clock()
    local cache = S.crowPicks
    if cache and (nowC - cache.t) < 0.35 then return cache.list end
    local out = {}
    local pg = lp:FindFirstChild("PlayerGui")
    if not pg then S.crowPicks = { t = nowC, list = out } return out end
    local function walk(node, depth)
        if depth > 8 then return end
        for _, c in ipairs(node:GetChildren()) do
            local cls = c.ClassName
            if cls == "TextButton" or cls == "TextLabel" or cls == "ImageButton" then
                local txt
                pcall(function() txt = c.Text end)
                local boss = F.crowBossFromText(txt)
                if boss then
                    -- The offer's own label usually reports a real position; only
                    -- when it does not (a centred label reads nonsense) climb to
                    -- the button holding it. Climbing blindly landed on a
                    -- full-screen frame at 0,0 and every offer was discarded.
                    local ap
                    pcall(function() ap = c.AbsolutePosition end)
                    if not (ap and ap.X > 0 and ap.Y > 0) then
                        local p2 = c.Parent
                        for _ = 1, 4 do
                            if not p2 then break end
                            local pp
                            pcall(function() pp = p2.AbsolutePosition end)
                            if pp and pp.X > 0 and pp.Y > 0 then ap = pp break end
                            p2 = p2.Parent
                        end
                    end
                    if ap and ap.X > 0 and ap.Y > 0 then
                        -- the card's own size, plus the button holding it: a
                        -- click into the middle of either is far more likely to
                        -- land than a fixed offset from the text's corner
                        local w, h = 0, 0
                        local sz = F.absSize and F.absSize(c)
                        if sz then w = tonumber(sz.X) or 0 h = tonumber(sz.Y) or 0 end
                        local bx, by, bw, bh
                        local p3 = c.Parent
                        for _ = 1, 4 do
                            if not p3 then break end
                            local cls3 = p3.ClassName
                            if cls3 == "TextButton" or cls3 == "ImageButton" then
                                local pp
                                pcall(function() pp = p3.AbsolutePosition end)
                                local ps = F.absSize and F.absSize(p3)
                                if pp and pp.X > 0 and pp.Y > 0 then
                                    bx, by = pp.X, pp.Y
                                    bw = ps and tonumber(ps.X) or 0
                                    bh = ps and tonumber(ps.Y) or 0
                                end
                                break
                            end
                            p3 = p3.Parent
                        end
                        out[#out + 1] = { x = ap.X, y = ap.Y, w = w, h = h,
                                          bx = bx, by = by, bw = bw, bh = bh, boss = boss }
                    end
                end
            end
            walk(c, depth + 1)
        end
    end
    walk(pg, 0)
    table.sort(out, function(a2, b2) return a2.y < b2.y end)
    -- the same offer can be found through several nested labels
    local seen, uniq = {}, {}
    for _, o in ipairs(out) do
        local key = o.boss .. ":" .. math.floor(o.y / 20)
        if not seen[key] then seen[key] = true uniq[#uniq + 1] = o end
    end
    S.crowPicks = { t = nowC, list = uniq }
    return uniq
end

-- Written once per run when a click on an offer does not take: the card's whole
-- neighbourhood, so the layout can be read back afterwards instead of guessed.
function F.crowDump()
    if S.crowDumped then return end
    S.crowDumped = true
    local lines = { os.date("%H:%M:%S") .. " crow menu dump" }
    local function desc(el, indent)
        local nm, cls, txt, ap, vis, act = "?", "?", nil, nil, nil, nil
        pcall(function() nm = el.Name cls = el.ClassName end)
        pcall(function() txt = el.Text end)
        pcall(function() ap = el.AbsolutePosition end)
        pcall(function() vis = el.Visible act = el.Active end)
        local sz = F.absSize and F.absSize(el)
        lines[#lines + 1] = string.rep(" ", indent) .. cls .. " " .. nm
            .. " pos=" .. (ap and (math.floor(ap.X) .. "," .. math.floor(ap.Y)) or "?")
            .. " size=" .. (sz and (math.floor(tonumber(sz.X) or 0) .. "x" .. math.floor(tonumber(sz.Y) or 0)) or "?")
            .. " vis=" .. tostring(vis) .. " active=" .. tostring(act)
            .. (txt and txt ~= "" and (" text=" .. string.sub(tostring(txt), 1, 40)) or "")
    end
    local pg = lp:FindFirstChild("PlayerGui")
    local function walk(node, depth)
        if depth > 9 then return end
        for _, c in ipairs(node:GetChildren()) do
            local txt
            pcall(function() txt = c.Text end)
            if F.crowBossFromText(txt) then
                -- the card, its ancestors and everything inside it
                local chain, p = {}, c
                for _ = 1, 6 do
                    if not p then break end
                    chain[#chain + 1] = p
                    p = p.Parent
                end
                lines[#lines + 1] = "--- offer: " .. tostring(txt)
                for i = #chain, 1, -1 do desc(chain[i], (#chain - i) * 2) end
                for _, k in ipairs(c.Parent and c.Parent:GetChildren() or {}) do
                    desc(k, 14)
                end
            end
            walk(c, depth + 1)
        end
    end
    if pg then pcall(walk, pg, 0) end
    pcall(function() writefile("crow_ui.txt", table.concat(lines, string.char(10))) end)
    F.notify("crow: wrote crow_ui.txt", 4)
end

-- Where to click an offer. The first try aims at the middle of the card, which
-- is what a player does; the rest are fallbacks for when the card's own size or
-- position reads badly, so a menu that ignored one click still gets taken.
function F.crowPoint(p, attempt)
    attempt = attempt or 1
    if attempt <= 1 and (p.w or 0) > 4 and (p.h or 0) > 4 then
        return p.x + p.w * 0.5, p.y + p.h * 0.5
    end
    if attempt <= 2 then return p.x + 40, p.y + 14 end
    if attempt <= 3 and p.bx and (p.bw or 0) > 4 then
        return p.bx + p.bw * 0.5, p.by + (p.bh or 20) * 0.5
    end
    if attempt <= 4 then return p.x + 120, p.y + 14 end
    return p.x + 8, p.y + 8
end

-- Presses a hotbar slot. The key is released a moment later by whichever loop
-- is running, so the press never sticks.
function F.equipSlot(slot, now)
    local vk = 48 + math.max(1, math.min(5, math.floor(slot or 1)))
    pcall(function() keypress(vk) end)
    S.crowKeyUp = { vk = vk, t = now + 0.15 }
end

-- What is in the player's hands right now, by name.
function F.heldItem()
    local ch = lp.Character
    if not ch then return nil end
    local kids = ch:GetChildren()
    for i = 1, #kids do
        if kids[i].ClassName == "Tool" then return kids[i].Name end
    end
    local ta = ch:FindFirstChild("Tool_Accessories")
    local first = ta and ta:GetChildren()[1]
    return first and first.Name or nil
end

-- True while something that can actually fight is held. The crow is a tool like
-- any other, so holding it means the swing goes nowhere.
function F.weaponHeld()
    local nm = F.heldItem()
    if not nm then return false end
    local low = string.lower(nm)
    if DB.StyleMap[low] then return true end
    if DB.Presets[nm] and nm ~= "Combat" then return true end
    for word in pairs(DB.StyleWords) do
        if string.find(low, word, 1, true) then return true end
    end
    return string.find(low, "katana", 1, true) ~= nil
end

-- Switching to the weapon is also how the crow's menu is dismissed: the quest
-- is taken, so the crow has no further use until the next one.
function F.crowClose(now)
    F.equipSlot(S.WeapSlot or 1, now)
end

function F.crowUse(now)
    F.equipSlot(S.CrowSlot or 2, now)
    S.crow.clickAt = now + 0.6      -- equip first, then use it
end

-- returns the boss to fight, or nil while it is still working the menu
function F.crowStep(now)
    local c = S.crow
    if not c then c = { phase = "idle", t = now } S.crow = c end
    if not F.focused(now) then return nil end
    if not F.scrOffset(now) then return nil end

    if S.crowKeyUp and now >= S.crowKeyUp.t then
        local vk = S.crowKeyUp.vk
        S.crowKeyUp = nil
        pcall(function() keyrelease(vk) end)
    end
    if c.clickAt and now >= c.clickAt then
        c.clickAt = nil
        F.dlgClickAt((S.crowClickX or 960) - (S.scrOffX or 0), (S.crowClickY or 540) - (S.scrOffY or 0))
    end

    local q = F.activeQuest()

    -- A boss quest you already hold is the job: fight that instead of asking
    -- the crow for another one (the crow will not hand one out anyway).
    if q and not q.Complete and c.phase ~= "fight" then
        local boss = F.questTarget(q)
        if not boss then
            for i = 1, #(q.Tasks or {}) do
                boss = boss or F.codeToMob(q.Tasks[i].Code)
            end
        end
        if boss and DB.BossNames[string.lower(boss)] then
            c.target = boss
            c.quest = q.Name
            c.phase = "fight"
            c.lastAlive = now
            F.notify("crow: already on " .. q.Name .. " - hunting " .. boss, 4)
            return boss
        end
    end

    if c.phase == "idle" then
        if now < (c.nextAt or 0) then return nil end
        c.prevQuest = q and q.Name or nil
        F.crowUse(now)
        c.phase = "menu"
        c.menuAt = now + 3.5
        c.deadline = now + 10
        return nil
    end

    if c.phase == "menu" then
        if now < (c.menuAt or 0) then return nil end
        -- the topmost offer that has not already been refused: one the game
        -- will not give (above your level range, say) is set aside for ten
        -- minutes instead of being clicked again every cycle
        c.skip = c.skip or {}
        local p
        for _, o in ipairs(F.crowChoices()) do
            if now >= (c.skip[o.boss] or 0) then p = o break end
        end
        if p then
            -- the aim that worked last time is tried first on every later cycle
            c.aim = (c.aim or (S.crowAim or 1))
            local cx, cy = F.crowPoint(p, c.aim)
            F.dlgClickAt(cx, cy)
            c.pick = p
            c.target = p.boss
            c.phase = "quest"
            c.deadline = now + 5      -- the quest lands within a second if it took
            c.sawBoss = false
            -- a normal click is not an error: it goes on the trail, not in the log
            F.mark("crow click " .. p.boss .. " aim " .. tostring(c.aim)
                .. " at " .. math.floor(cx) .. "," .. math.floor(cy))
            F.notify("crow: taking " .. p.boss, 3)
        elseif now >= (c.deadline or 0) then
            c.phase = "idle"
            c.nextAt = now + 2
            F.notify("crow: no boss offer found, retrying", 4)
        end
        return nil
    end

    if c.phase == "quest" then
        local fresh = q and q.Name ~= c.prevQuest
        if q and not q.Complete and (fresh or (c.target and F.questMatchesEntry(q.Name, c.target))) then
            S.crowAim = c.aim or 1          -- that point works: use it from now on
            c.tries = 0
            c.quest = q.Name
            c.phase = "fight"
            c.lastAlive = now
            c.eqT = 0                       -- weapon back in hand right away
            -- some cards leave the menu up after the quest is taken
            if #F.crowChoices() > 0 then F.crowClose(now) end
            F.notify("crow: hunting " .. tostring(c.target), 3)
        elseif now >= (c.deadline or 0) then
            -- No quest: the click missed. While the offers are still on screen
            -- the card is worth another try at a different point - calling the
            -- crow again only leaves the same menu open.
            -- One more try at a second point, in case the click missed; after
            -- that the game is refusing this hunt, so take the next offer.
            if #F.crowChoices() > 0 then
                local tries = (c.tries or 0) + 1
                c.tries = tries
                if tries < 2 then
                    c.aim = (c.aim or 1) % 5 + 1
                else
                    c.skip = c.skip or {}
                    if c.target then c.skip[c.target] = now + 600 end
                    F.notify("crow: " .. tostring(c.target) .. " was refused - taking another hunt", 4)
                    c.tries, c.aim = 0, S.crowAim
                end
                c.phase = "menu"
                c.menuAt = now + 0.4
                c.deadline = now + 8
                return nil
            end
            F.crowClose(now)
            c.aim = nil
            c.target = nil
            c.phase = "idle"
            c.nextAt = now + 3
        end
        return nil
    end

    -- fighting: the crow was only needed for the offer, so the weapon goes back
    -- in hand - a boss quest swung at with a crow equipped lands nothing
    if not F.weaponHeld() and now - (c.eqT or 0) > 1.5 then
        c.eqT = now
        F.equipSlot(S.WeapSlot or 1, now)
    end

    -- fight: the quest ending (or vanishing) starts the next crow cycle
    if not q or (q.Name == c.quest and q.Complete) then
        c.target, c.quest, c.phase, c.nextAt = nil, nil, "idle", now + 1
        F.notify("crow: boss quest done, next one", 3)
        return nil
    end
    return c.target
end


----------------------------------------------------------------------
-- unlock all locations: visit every spawn crystal and activate it
----------------------------------------------------------------------
-- Each crystal sits in Debree.Regions.<region>; standing beside it and
-- holding T activates it, which unlocks that fast-travel point. Run as a
-- step of the tick, not a spawned loop (those die unpredictably in Matcha).
DB.Crystals = {
    { Region = "Mistfall Harbor", Name = "Mistfall Harbor", Pos = Vector3.new(135.8, 873.7, 734.1) },
    { Region = "Windy Peak", Name = "Windy Peak", Pos = Vector3.new(-650, 1245, -1100) },
    { Region = "Bamboo Grove", Name = "Bamboo Grove Sanctuary", Pos = Vector3.new(540, 1122, -1023) },
    { Region = "Bamboo Grove", Name = "Bamboo Grove", Pos = Vector3.new(657.4, 1021.2, 139.7) },
    { Region = "Butterfly Estate", Name = "Butterfly Estate", Pos = Vector3.new(-1767.39, 314.51, -121.67) },
    { Region = "Hidden Mist Village", Name = "Hidden Mist Village", Pos = Vector3.new(-263.1, 1043.5, -1150.5) },
    { Region = "Iceveil Valley", Name = "Iceveil Settlement", Pos = Vector3.new(485.3, 1222.9, -1813.4) },
    { Region = "Final Selection Plains", Name = "Final Selection", Pos = Vector3.new(-2626.7, 284, -191.2) },
}

function F.unlockStart()
    if S.unlock then F.notify("already unlocking locations", 3) return end
    S.unlock = { i = 1, phase = "go", t = os.clock() }
    F.notify("unlocking " .. #DB.Crystals .. " locations - panic key stops it", 4)
    F.sync()
end

function F.unlockStop()
    if S.unlock and S.unlock.held then pcall(function() keyrelease(84) end) end
    S.unlock = nil
end

-- the crystal part inside the region, found fresh
function F.crystalPart(region)
    local deb = WS:FindFirstChild("Debree")
    local regs = deb and deb:FindFirstChild("Regions")
    local reg = regs and regs:FindFirstChild(region)
    for _, c in ipairs(reg and reg:GetChildren() or {}) do
        local low = string.lower(c.Name)
        if string.find(low, "crystal", 1, true) or string.find(low, "spawn", 1, true) then
            local p = c:FindFirstChild("Root") or c:FindFirstChild("Cube") or c:FindFirstChildWhichIsA("BasePart")
            if c.ClassName == "Part" or c.ClassName == "MeshPart" then p = c end
            if p then return p end
        end
    end
    return nil
end

-- true while it owns the character
function F.unlockStep(now)
    local u = S.unlock
    if not u then return false end
    local e = DB.Crystals[u.i]
    if not e then
        F.unlockStop()
        F.notify("every location visited", 4)
        F.sync()
        return false
    end
    if not F.focused(now) then return true end
    if u.phase == "go" then
        if now < u.t then return true end
        F.notify("unlocking " .. u.i .. "/" .. #DB.Crystals .. ": " .. e.Name, 2)
        F.tpTo(e.Pos, 3)
        u.phase, u.t = "find", now
    elseif u.phase == "find" then
        if now - u.t < 1.0 then return true end   -- let the region stream in
        local p = F.crystalPart(e.Region)
        local pos
        if p then pcall(function() pos = p.Position end) end
        if pos then F.tpTo(Vector3.new(pos.X, pos.Y, pos.Z + 2.5), 1.5) end
        u.phase, u.t = "hold", now
    elseif u.phase == "hold" then
        if not u.held then
            if now - u.t < 0.3 then return true end
            pcall(function() keypress(84) end)
            u.held, u.t = true, now
        elseif now - u.t >= 1.5 then
            pcall(function() keyrelease(84) end)
            u.held = false
            u.i = u.i + 1
            u.phase, u.t = "go", now + 0.5
        end
    end
    return true
end

----------------------------------------------------------------------
-- talking to an npc by hand (click build: no remote is ever fired)
----------------------------------------------------------------------
-- The game's dialogue is PlayerGui.<gui>.DialogueContent; the answers are
-- TextButtons inside it. Pressing T opens it, clicking a line answers it. Used
-- where the main build would fire AddQuest or QuestProgress.
function F.scrOffset(now)
    -- one-off offset between mousemoveabs and Mouse.X/Y (window chrome)
    if S.scrOffX then return true end
    local m = lp:GetMouse()
    if not S.scrCalT then
        S.scrMx, S.scrMy = m.X, m.Y
        pcall(function() mousemoveabs(700, 450) end)
        S.scrCalT = now
        return false
    end
    if now - S.scrCalT < 0.12 then return false end
    S.scrOffX, S.scrOffY = 700 - m.X, 450 - m.Y
    pcall(function() mousemoveabs(S.scrMx + S.scrOffX, S.scrMy + S.scrOffY) end)
    return true
end

-- The dialogue lives in PlayerGui.ComponentsHolder.DialogueFrame (its sibling
-- DialogueContent is always empty), and its text arrives split into fragments
-- by the textplus library, so only the shallowest label of each node carries
-- the whole line.
function F.dlgRoot()
    local pg = lp:FindFirstChild("PlayerGui")
    local ch = pg and pg:FindFirstChild("ComponentsHolder")
    return ch and ch:FindFirstChild("DialogueFrame") or nil
end

local function firstText(node, depth)
    depth = depth or 0
    if depth > 6 then return nil end
    for _, c in ipairs(node:GetChildren()) do
        local txt, ap
        pcall(function() txt = c.Text end)
        pcall(function() ap = c.AbsolutePosition end)
        if txt and txt ~= "" and ap then return txt, ap end
        local t, p2 = firstText(c, depth + 1)
        if t then return t, p2 end
    end
    return nil
end

-- the answers on screen: { text, x, y }
function F.dlgAnswers(root)
    local out = {}
    local holder = root and root:FindFirstChild("ButtonHolder", true)
    if not holder then
        -- FindFirstChild's recursive form is not available here, so walk it
        local function find(node, depth)
            if depth > 5 then return nil end
            for _, c in ipairs(node:GetChildren()) do
                if c.Name == "ButtonHolder" then return c end
                local r = find(c, depth + 1)
                if r then return r end
            end
        end
        holder = root and find(root, 0) or nil
    end
    if not holder then return out end
    for _, frame in ipairs(holder:GetChildren()) do
        -- Click the button, never its label: a centred TextLabel reports a
        -- nonsense AbsolutePosition (x = -649 for a button at x = 1206), which
        -- put the cursor off the left edge of the screen.
        local txt = firstText(frame, 0)
        local ap
        pcall(function() ap = frame.AbsolutePosition end)
        if ap and (ap.X > 0 or ap.Y > 0) then
            out[#out + 1] = { text = txt or frame.Name, x = ap.X, y = ap.Y }
        end
    end
    return out
end

-- where to click to advance to the next line
function F.dlgContinue(root)
    local holder
    local function find(node, depth)
        if depth > 5 then return nil end
        for _, c in ipairs(node:GetChildren()) do
            if c.Name == "DialogueHolder" then return c end
            local r = find(c, depth + 1)
            if r then return r end
        end
    end
    holder = root and find(root, 0) or nil
    if not holder then return nil end
    local txt, ap = firstText(holder, 0)
    if ap and ap.X < 0 then return nil end
    return ap
end

-- A Roblox button only takes the click if the cursor was already over it when
-- the button went down, so the move, the press and the release are three
-- separate frames.
function F.dlgClickAt(x, y)
    S.crowPicks = nil
    S.dlgClick = { x = x + (S.scrOffX or 0), y = y + (S.scrOffY or 0), st = "move", t = os.clock() }
end

-- Drives one npc conversation. want = the answer to click (nil: just open it,
-- which is enough for hand-ins the game credits on sight, like Noote's notes).
-- Returns "done", "working" or "failed".
function F.dlgTalk(want, now)
    local d = S.dlg
    if not d or d.want ~= want then d = { want = want, t = now, tries = 0 } S.dlg = d end
    if not F.focused(now) then return "working" end
    if not F.scrOffset(now) then return "working" end

    local root = F.dlgRoot()
    if not root then
        if d.opened then S.dlg = nil return "done" end      -- it closed: finished
        if now - d.t > 20 then S.dlg = nil return "failed" end
        if now - (d.openT or 0) > 2.5 then
            d.openT = now
            d.tries = d.tries + 1
            pcall(function() keypress(84) end)
            S.dlgKeyUp = now + 0.15
        end
        return "working"
    end
    d.opened = true
    if not want then return "done" end                      -- opening it was enough
    if now - (d.clickT or 0) < 0.8 then return "working" end
    d.clickT = now
    for _, a in ipairs(F.dlgAnswers(root)) do
        if a.text == want then
            F.dlgClickAt(a.x + 40, a.y + 14)
            d.clicked = true
            return "working"                                -- confirmed when it closes
        end
    end
    local ap = F.dlgContinue(root)
    if ap then F.dlgClickAt(ap.X + 12, ap.Y + 8) end
    if now - d.t > 25 then S.dlg = nil return "failed" end
    return "working"
end

function F.dlgRelease(now)
    local c = S.dlgClick
    if c then
        if c.st == "move" then
            pcall(function() mousemoveabs(c.x, c.y) end)
            c.st, c.t = "press", now
        elseif c.st == "press" and now - c.t > 0.1 then
            pcall(function() mouse1press() end)
            S.dlgUp = now + 0.08
            c.st, c.t = "down", now
        elseif c.st == "down" and now - c.t > 0.3 then
            S.dlgClick = nil
        end
    end
    if S.dlgUp and now >= S.dlgUp then
        S.dlgUp = nil
        pcall(function() mouse1release() end)
    end
    if S.crowKeyUp and now >= S.crowKeyUp.t then
        local vk = S.crowKeyUp.vk
        S.crowKeyUp = nil
        pcall(function() keyrelease(vk) end)
    end
    if S.dlgKeyUp and now >= S.dlgKeyUp then
        S.dlgKeyUp = nil
        pcall(function() keyrelease(84) end)
    end
end

----------------------------------------------------------------------
-- boss chest route: ACO path over the drops, T spammed along it
----------------------------------------------------------------------
-- Used ONLY for what a boss chest spits out. Every drop is plotted, an ant
-- colony picks the visiting order (an open path from where the player
-- stands), and the character runs it tapping T the whole way.
function F.acoPath(start, pts)
    local n = #pts
    if n == 0 then return {} end
    if n == 1 then return { 1 } end
    -- node 0 is the start, 1..n the drops
    local nodes = { [0] = start }
    for i = 1, n do nodes[i] = pts[i] end
    local d = {}
    for i = 0, n do
        d[i] = {}
        for j = 0, n do
            local a, b = nodes[i], nodes[j]
            local dx, dy, dz = a.X - b.X, a.Y - b.Y, a.Z - b.Z
            d[i][j] = math.max(math.sqrt(dx * dx + dy * dy + dz * dz), 0.01)
        end
    end
    local function pathLen(p)
        local L, prev = 0, 0
        for k = 1, #p do L = L + d[prev][p[k]] prev = p[k] end
        return L
    end
    -- nearest neighbour seeds the best tour and the pheromone level
    local best, used, cur = {}, {}, 0
    for _ = 1, n do
        local nx, nd = nil, math.huge
        for j = 1, n do
            if not used[j] and d[cur][j] < nd then nd = d[cur][j] nx = j end
        end
        used[nx] = true
        best[#best + 1] = nx
        cur = nx
    end
    local bestLen = pathLen(best)
    local tau0 = 1 / (n * bestLen)
    local tau = {}
    for i = 0, n do
        tau[i] = {}
        for j = 0, n do tau[i][j] = tau0 end
    end
    local ALPHA, BETA, RHO, Q0 = 1, 3, 0.2, 0.9
    local ants = math.min(20, n + 5)
    local iters = n <= 8 and 40 or (n <= 20 and 30 or 15)
    for _ = 1, iters do
        for _ = 1, ants do
            local seen, path, at = {}, {}, 0
            for _ = 1, n do
                -- ACS rule: exploit the best edge with q0, else roulette
                local pick
                if math.random() < Q0 then
                    local bv = -1
                    for j = 1, n do
                        if not seen[j] then
                            local v = tau[at][j] ^ ALPHA * (1 / d[at][j]) ^ BETA
                            if v > bv then bv = v pick = j end
                        end
                    end
                else
                    local total, w = 0, {}
                    for j = 1, n do
                        if not seen[j] then
                            w[j] = tau[at][j] ^ ALPHA * (1 / d[at][j]) ^ BETA
                            total = total + w[j]
                        end
                    end
                    local r = math.random() * total
                    for j = 1, n do
                        if w[j] then
                            r = r - w[j]
                            if r <= 0 then pick = j break end
                        end
                    end
                    if not pick then
                        for j = 1, n do if not seen[j] then pick = j break end end
                    end
                end
                -- local pheromone update
                tau[at][pick] = (1 - RHO) * tau[at][pick] + RHO * tau0
                seen[pick] = true
                path[#path + 1] = pick
                at = pick
            end
            local L = pathLen(path)
            if L < bestLen then bestLen = L best = path end
        end
        -- global update on the best path so far
        local prev = 0
        for k = 1, #best do
            local j = best[k]
            tau[prev][j] = (1 - RHO) * tau[prev][j] + RHO / bestLen
            prev = j
        end
    end
    return best, bestLen
end

function F.routeStart(items)
    local _, hrp = F.char()
    if not hrp or not items or #items == 0 then return false end
    local pts, keep = {}, {}
    for i = 1, #items do
        local ok, p = pcall(items[i].get)
        if ok and p then pts[#pts + 1] = p keep[#keep + 1] = items[i] end
    end
    if #pts == 0 then return false end
    local order, len = F.acoPath(hrp.Position, pts)
    local list = {}
    for k = 1, #order do list[k] = keep[order[k]] end
    S.route = { list = list, i = 1, t = os.clock(), tDown = false, nextT = 0 }
    F.notify(string.format("boss drops: %d, path %.0f studs", #list, len or 0), 3)
    return true
end

function F.routeStop()
    local r = S.route
    S.route = nil
    if r and r.tDown then pcall(function() keyrelease(84) end) end
end

-- true while it still owns the character
function F.routeStep(now)
    local r = S.route
    if not r then return false end
    local _, hrp = F.char()
    if not hrp then return true end

    -- T spam the whole way (needs the window focused)
    if F.focused(now) and now >= r.nextT then
        r.nextT = now + S.RouteTap
        r.tDown = not r.tDown
        pcall(function()
            if r.tDown then keypress(84) else keyrelease(84) end
        end)
    end

    local item = r.list[r.i]
    if not item then
        F.routeStop()
        return false
    end
    local pos
    if not pcall(function() pos = item.get() end) or not pos then
        r.i = r.i + 1 r.t = now r.arrive = nil
        return true
    end
    local p = hrp.Position
    local dx, dy, dz = pos.X - p.X, (pos.Y + 2.5) - p.Y, pos.Z - p.Z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
    -- no stopping: pass over the drop (T is being spammed) and head straight
    -- for the next one
    if dist <= 3 then
        r.i = r.i + 1 r.t = now
        if not r.list[r.i] then
            pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
        end
        return true
    end
    if dist > S.WarpAbove then
        pcall(function()
            hrp.CFrame = CFrame.new(pos.X, pos.Y + 3, pos.Z)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)
    else
        -- full speed the whole way; only the last drop is approached gently
        local sp = S.MoveSpeed
        if not r.list[r.i + 1] then sp = math.min(dist * 5.0, S.MoveSpeed) end
        local k = sp / dist
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(dx * k, dy * k, dz * k) end)
    end
    if now - r.t > 5 then r.i = r.i + 1 r.t = now end   -- unreachable, skip it
    return true
end

----------------------------------------------------------------------
-- quests
----------------------------------------------------------------------
function F.activeQuest()
    local ps = RS:FindFirstChild("Player_Service")
    local data = ps and ps:FindFirstChild("Data")
    local mine = data and data:FindFirstChild(lp.Name)
    if not mine then return nil end
    local slotNo = mine:FindFirstChild("slotEquipped")
    slotNo = slotNo and slotNo.Value or 1
    local slots = mine:FindFirstChild("slots")
    local slot = slots and slots:FindFirstChild("Slot" .. tostring(math.floor(slotNo)))
    local q = slot and slot:FindFirstChild("Quests")
    local holder = q and q:FindFirstChild("Holder")
    if not holder then return nil end
    local first = nil
    local qs = holder:GetChildren()
    for i = 1, #qs do
        local tf = qs[i]:FindFirstChild("Tasks")
        if tf then
            local tasks, done = {}, true
            local tl = tf:GetChildren()
            for j = 1, #tl do
                local v = tl[j]:FindFirstChild("Value")
                local mx = tl[j]:FindFirstChild("Max")
                -- the code names the mob ("BearCub", "HoyuzoSub"); it reads as
                -- garbage bytes for some pickup tasks, so keep it only if clean
                local code
                local cv = tl[j]:FindFirstChild("Code")
                if cv then
                    local raw = cv.Value
                    if type(raw) == "string" and string.match(raw, "^[%w ]+$") then code = raw end
                end
                tasks[#tasks + 1] = {
                    Name = tl[j].Name,
                    Value = v and v.Value or 0,
                    Max = mx and mx.Value or 1,
                    Code = code,
                }
                if (v and v.Value or 0) < (mx and mx.Value or 1) then done = false end
            end
            -- QuestString.Value comes back as non-printable bytes through
            -- Matcha, so the folder name is the source of truth and the
            -- string is only used when it reads clean.
            local qstr = qs[i]:FindFirstChild("QuestString")
            local desc = nil
            if qstr then
                local v = qstr.Value
                if type(v) == "string" and #v > 0 then
                    local printable = true
                    for b = 1, #v do
                        local c = string.byte(v, b)
                        if c < 32 or c > 126 then printable = false break end
                    end
                    if printable then desc = v end
                end
            end
            local entry = {
                Name = qs[i].Name,
                Desc = desc,
                Id = qs[i].Name,
                Tasks = tasks,
                Complete = done,
            }
            if not done then return entry end
            if not first then first = entry end
        end
    end
    return first
end

-- pick a farmable mob out of whatever the quest text says (longest name wins)
-- Quest text rarely contains a mob's full name: "Clear Hoyuzo's Guard" with
-- task "Guards defeated" has to resolve to "Hoyuzo Subordinate". So candidates
-- are scored on how many of their words appear in the text rather than needing
-- the whole name to appear verbatim.
local MINION_WORDS = { "guard", "guards", "subordinate", "subordinates",
                       "minion", "minions", "underling", "underlings", "escort" }

function F.questPickups()
    local out = {}
    for _, c in ipairs(WS:GetChildren()) do
        if string.match(c.Name, "%d+$") then
            local r
            if c.ClassName == "Part" or c.ClassName == "MeshPart" then
                r = c
            else
                r = c:FindFirstChildWhichIsA("BasePart")
            end
            if r then
                -- a prompt is what makes it a pickup rather than scenery
                local prompt = false
                for _, d in ipairs(c:GetDescendants()) do
                    if d.ClassName == "ProximityPrompt" then prompt = true break end
                end
                if prompt then out[#out + 1] = { Name = c.Name, Root = r, Node = c } end
            end
        end
    end
    return out
end

-- The dropdown's target must not be used for an unrelated quest: leaving it on
-- "5 Broken Blades" made every fetch quest fall back to killing Mizunoto.
-- Task names are worded consistently: "Guards defeated", "Bandits remaining"
-- are kills; "Jewelry Box found", "Pages found", "Return to Ginzo" are not.
-- A fetch task must never fall back to killing something.
local KILL_WORDS  = { "defeated", "remaining", "slain", "killed", "eliminated", "defeat",
                      "hunted", "fell " }
local FETCH_WORDS = { "found", "collected", "delivered", "escorted", "caught",
                      "return", "retrieve", "recovered", "gathered" }

function F.taskKind(name)
    if not name then return "unknown" end
    local low = " " .. string.lower(name) .. " "
    for _, w in ipairs(FETCH_WORDS) do
        if string.find(low, w, 1, true) then return "fetch" end
    end
    for _, w in ipairs(KILL_WORDS) do
        if string.find(low, w, 1, true) then return "kill" end
    end
    return "unknown"
end

function F.questMatchesEntry(questName, entryKey)
    if not questName or not entryKey then return false end
    local function words(str)
        local t = {}
        for w in string.gmatch(string.lower(str), "%a+") do
            if #w >= 4 then t[w] = true end
        end
        return t
    end
    local a, b = words(questName), words(entryKey)
    for w in pairs(a) do if b[w] then return true end end
    return false
end

-- "BearCub" -> "Bear Cub", "HoyuzoSub" -> "Hoyuzo Subordinate", matched
-- against the real mob and boss names
function F.codeToMob(code)
    if not code or code == "" then return nil end
    local spaced = string.gsub(code, "(%l)(%u)", "%1 %2")
    spaced = string.gsub(spaced, " Sub$", " Subordinate")
    local low = string.lower(spaced)
    local compact = string.gsub(low, " ", "")
    for _, pool in ipairs({ DB.Mobs, DB.Bosses }) do
        for i = 1, #pool do
            local n = string.lower(pool[i])
            if n == low or string.gsub(n, " ", "") == compact then return pool[i] end
        end
    end
    return nil
end

-- Quests.Completed records the option keys of finished one-off quests; the
-- server refuses to hand those out again (the client calls it
-- "QuestAlreadyCompleted"), so there is no point asking.
function F.questCompleted(opt)
    local ps = RS:FindFirstChild("Player_Service")
    local data = ps and ps:FindFirstChild("Data")
    local mine = data and data:FindFirstChild(lp.Name)
    if not mine then return false end
    local se = mine:FindFirstChild("slotEquipped")
    local slot = mine:FindFirstChild("slots")
    slot = slot and slot:FindFirstChild("Slot" .. tostring(math.floor(se and se.Value or 1)))
    local q = slot and slot:FindFirstChild("Quests")
    local done = q and q:FindFirstChild("Completed")
    return done ~= nil and done:FindFirstChild(opt) ~= nil
end

-- Seconds since the server last stamped Quests.LastTime (every accept), or nil
function F.questLastAge()
    local ps = RS:FindFirstChild("Player_Service")
    local data = ps and ps:FindFirstChild("Data")
    local mine = data and data:FindFirstChild(lp.Name)
    if not mine then return nil end
    local se = mine:FindFirstChild("slotEquipped")
    local slot = mine:FindFirstChild("slots")
    slot = slot and slot:FindFirstChild("Slot" .. tostring(math.floor(se and se.Value or 1)))
    local q = slot and slot:FindFirstChild("Quests")
    local lt = q and q:FindFirstChild("LastTime")
    if not lt then return nil end
    return os.time() - lt.Value
end

-- "(Lv 45)" out of a dialogue option, as a number
function F.optLevel(opt)
    if type(opt) ~= "string" then return nil end
    local n = string.match(opt, "%(Lv%s*(%d+)%)")
    return n and tonumber(n) or nil
end

-- the option this entry asks for, honouring "quest type" when it has both
function F.questOpt(info)
    if not info then return nil end
    if S.QuestPick == "boss" then return info.BossOption or info.QuestOption end
    return info.QuestOption or info.BossOption
end

-- Next ticked quest worth walking to: not completed, not recently refused.
-- Returns the registry entry and its key, or nil plus the soonest retry time.
function F.pickQuest(now)
    S.qBack = S.qBack or {}
    S.qSent = S.qSent or {}
    local soonest
    local sel = S.QuestSel or {}
    local n = #sel
    local start = 1
    if S.lastDoneKey then
        -- the finished quest's own entry, or the ticked entry that covers it
        -- (a delivery counts for "[Auto] All delivery quests")
        local doneInfo = DB.Quests[S.lastDoneKey]
        local doneOpt = doneInfo and (doneInfo.QuestOption or doneInfo.BossOption)
        for i = 1, n do
            local k = sel[i]
            local e = DB.Quests[k]
            local covers = k == S.lastDoneKey
            if not covers and e and e.AutoDeliver and doneOpt then
                for _, dg in ipairs(DB.DeliverGivers) do
                    if dg.QuestOption == doneOpt then covers = true break end
                end
            end
            if covers then start = i + 1 break end
        end
    end
    for step = 0, n - 1 do
        local key = sel[((start - 1 + step) % math.max(n, 1)) + 1]
        local info = DB.Quests[key]
        -- an accept that produced no quest: level, requirement or limit
        local sent = S.qSent[key]
        if sent and now - sent > 6 then
            S.qSent[key] = nil
            S.qBack[key] = now + 60
        end
        if info and info.AutoDeliver then
            local g, soon = F.pickDelivery(now)
            if g then return info, key end
            if soon and (not soonest or soon < soonest) then soonest = soon end
        elseif info and not info.Auto and info.Pos then
            local opt = F.questOpt(info)
            if opt and not F.questCompleted(opt) then
                local back = S.qBack[key]
                if not back or now >= back then return info, key end
                if not soonest or back < soonest then soonest = back end
            end
        end
    end
    return nil, soonest
end

-- the registry entry for the quest being done right now
function F.entryForQuest(q)
    if not q then return nil end
    if q.Desc then
        for key, info in pairs(DB.Quests) do
            if info.QuestOption == q.Desc or info.BossOption == q.Desc then return info, key end
        end
    end
    for _, key in ipairs(S.QuestSel or {}) do
        local info = DB.Quests[key]
        if info and not info.Auto and F.questMatchesEntry(q.Name, key) then return info, key end
    end
    return nil
end

-- Next delivery giver worth visiting, or nil when every one is done or cooling
-- down. An accept that produced no quest backs that giver off: the server
-- stamps Quests.LastTime on every AddQuest, so hammering it keeps the quest
-- cooldown from ever running out.
function F.pickDelivery(now)
    S.delivBack = S.delivBack or {}
    local soonest
    for _, g in ipairs(DB.DeliverGivers) do
        local opt = g.QuestOption
        local sent = S.delivSent and S.delivSent[opt]
        if sent and (now - sent) > 6 then
            S.delivSent[opt] = nil
            local n = (S.delivFails or {})[opt] or 0
            S.delivFails = S.delivFails or {}
            S.delivFails[opt] = n + 1
            S.delivBack[opt] = now + 8   -- refused: try again shortly
        end
        if not F.questCompleted(opt) then
            local back = S.delivBack[opt]
            if not back or now >= back then return g end
            if not soonest or back < soonest then soonest = back end
        end
    end
    return nil, soonest
end

-- Walk-in for a DB.Deliver task. Teleports only: flying there fought the warp.
function F.deliverStep(opt, taskName, dt, hrp, now)
    if S.cur then S.cur = nil F.aimRelease() pcall(F.skillsRelease) if F.clickRelease then pcall(F.clickRelease) end end
    local key = opt .. "|" .. taskName
    if S.deliverKey ~= key then
        S.deliverKey = key
        S.deliverTries = 0
        S.deliverAt = nil
    end
    local flat = F.followNpc(dt.npc, dt.pos, now)
    if flat > 8 then
        S.deliverAt = nil
        return
    end
    -- let the server see us standing there before handing in
    S.deliverAt = S.deliverAt or (now + S.SettleT)
    if now < S.deliverAt then return end
    if not F.remote then
        -- click build: talk to them; some hand-ins need an answer clicked,
        -- others (Noote's notes) are credited the moment the dialogue opens
        local st = F.dlgTalk(dt.answer, now)
        if st == "failed" and now - (S.deliverWarn or 0) > 12 then
            S.deliverWarn = now
            F.notify("could not hand '" .. taskName .. "' to " .. dt.npc .. " - do it by hand", 6)
        end
        return
    end
    if (now - (S.deliverT or 0)) < 3 then return end
    S.deliverT = now
    S.deliverTries = (S.deliverTries or 0) + 1
    if S.deliverTries > 4 then
        if now - (S.deliverWarn or 0) > 10 then
            S.deliverWarn = now
            F.notify("'" .. taskName .. "' not accepted - missing the item?", 6)
        end
        return
    end
    pcall(function() F.remote:FireServer("QuestProgress", opt, taskName) end)
    F.notify("handing in: " .. taskName, 3)
end

function F.questTarget(q)
    if not q then return nil end
    local hay = string.lower(q.Name or "")
    if q.Desc then hay = hay .. " " .. string.lower(q.Desc) end
    for i = 1, #q.Tasks do hay = hay .. " " .. string.lower(q.Tasks[i].Name) end
    -- punctuation to spaces so "hoyuzo's" yields the word "hoyuzo"
    hay = " " .. string.gsub(hay, "[^%a]+", " ") .. " "

    local wantsMinion = false
    for _, w in ipairs(MINION_WORDS) do
        if string.find(hay, " " .. w .. " ", 1, true) then wantsMinion = true break end
    end

    -- "Lost" is a real mob whose name is a common English word, so it matched
    -- any quest mentioning something lost ("Recover the Lost Pages",
    -- "Locate Ren's Lost Nichirin"). It can only be targeted deliberately.
    local AMBIGUOUS = { ["lost"] = true }

    local function scoreOf(name)
        local score, words = 0, 0
        for w in string.gmatch(string.lower(name), "%a+") do
            words = words + 1
            if #w >= 4 then
                -- whole word, or the word plus a plural s
                if string.find(hay, " " .. w .. " ", 1, true)
                   or string.find(hay, " " .. w .. "s ", 1, true) then
                    score = score + 1
                end
            end
        end
        return score, words
    end

    local best, bestScore, bestSpec = nil, 0, -1
    local pools = { DB.Mobs, DB.Bosses }
    for pi = 1, #pools do
        local pool = pools[pi]
        for i = 1, #pool do
            local m = pool[i]
            if m ~= "All Regular Mobs" and m ~= "All Bosses"
               and not AMBIGUOUS[string.lower(m)] then
                local score = scoreOf(m)
                if score > 0 then
                    -- a minion quest should land on the Subordinate, not the boss
                    local isMinion = string.find(string.lower(m), "subordinate", 1, true) ~= nil
                    local spec = score * 10
                    if wantsMinion and isMinion then spec = spec + 5 end
                    if (not wantsMinion) and (not isMinion) then spec = spec + 5 end
                    if score > bestScore or (score == bestScore and spec > bestSpec) then
                        best, bestScore, bestSpec = m, score, spec
                    end
                end
            end
        end
    end
    return best
end

