    ["wagasa"] = "Bladed Wagasa",
}

-- Every weapon the game ships, by name, mapped to the preset it fights as.
-- ItemAssets.Tools is sorted into "<family> Category" folders, so the family a
-- variant belongs to is stated rather than guessed: "Damascus Scythe" and
-- "Nightfall Scythe" are Scythe, "Reverb Cleavers" is Sound Katanas, "Cutlass"
-- is its own preset. Anything added later is picked up the same way.
DB.StyleMap = {}
do
    local ALIAS = {
        ["Gauntlets"] = "Gauntlet", ["Warfans"] = "War Fans",
        ["Axe & Mace"] = "Axe and Mace", ["Katanas"] = "Regular Katana",
    }
    local function family(catName)
        local n = string.gsub(catName, "%s*Category%s*$", "")
        n = string.gsub(n, "^%s*(.-)%s*$", "%1")
        n = ALIAS[n] or n
        if DB.Presets[n] then return n end
        return nil
    end
    local tools = RS:FindFirstChild("ItemAssets")
    tools = tools and tools:FindFirstChild("Tools")
    for _, cat in ipairs(tools and tools:GetChildren() or {}) do
        local base = family(cat.Name)
        for _, w in ipairs(cat:GetChildren()) do
            local nm = w.Name
            local low = string.lower(nm)
            local preset
            if DB.Presets[nm] then
                preset = nm
            elseif string.find(low, "sound", 1, true) or string.find(low, "cleaver", 1, true) then
                preset = "Sound Katanas"
            elseif string.find(low, "insect", 1, true) then
                preset = "Insect Katana"
            else
                -- "Combat-Reaper", "Fighting Style-Tai Chi", "Dream Orb"
                local tail = string.match(nm, "[-]%s*(.+)$")
                local orb = string.match(nm, "^(.+)%s+Orb$")
                if tail and DB.Presets[tail] then preset = tail
                elseif orb and DB.Presets[orb] then preset = orb
                else preset = base end
            end
            if preset and DB.Presets[preset] then DB.StyleMap[low] = preset end
        end
    end
end
-- Combat_presets also folds in every FightingStyles child (they map to the
-- Combat preset), so read those live rather than freezing today's list.
do
    local pw = RS:FindFirstChild("CAM")
    pw = pw and pw:FindFirstChild("Global")
    pw = pw and pw:FindFirstChild("Powers")
    pw = pw and pw:FindFirstChild("FightingStyles")
    if pw then
        for _, m in ipairs(pw:GetChildren()) do DB.Presets[m.Name] = true end
    end
end

