			eC.guard = Y;
			local v = X.wantSpawn(e);
			if v then
				X.tpTo(v, 3);
			elseif Y - ((eC.nodest or 0)) > 12 then
				eC.nodest = Y;
				local v = (type(e) == "table") and X.bossLabel() or tostring(e);
				X.notify("no known spot for " .. (v .. " - find it once and it is remembered"), 6);
			end;
		end;
		return;
	end;
	local A = X.nearest(V, c.Position);
	if not A then
		X.dropCache();
		return;
	end;
	A.want = e;
	A.wantKey = z;
	A.t = Y;
	if A.Head == nil then
		A.MAddr = X.addr(A.Model);
		pcall(function()
			A.Head = A.Model:FindFirstChild("Head") or false;
		end);
	end;
	L.cur = A;
	X.attack(Y);
end;
local function rC()
	if not L.Running then
		return;
	end;
	local Y = os.clock();
	X.mark("tick");
	X.markWrite(Y);
	if L.AutoSouls and (X.farming() and not L.route) then
		X.mark("souls");
		local v, c = pcall(X.soulStep, Y);
		if v and c then
			return;
		end;
	end;
	if L.route then
		X.mark("route");
		local v, c = pcall(X.routeStep, Y);
		if v and c then
			return;
		end;
		if not v then
			X.routeStop();
		end;
	end;
	if L.collect then
		X.mark("collect");
		if pcall(X.collectStep, Y) then
			return;
		end;
	end;
	if ((L.AutoLoot or L.AutoSouls)) and (X.farming() and (not L.collect and (not L.lootPhase and (not L.route and (Y - ((eC.loot or 0))) > 2.0)))) then
		eC.loot = Y;
		local v, c = X.char();
		if c then
			if L.AutoLoot then
				local Y = X.lootNear(c.Position, L.LootRange);
				if #Y > 0 then
					X.collectStart(Y, "loot");
				end;
			end;
		end;
	end;
	if L.pendingLoot and (Y - L.pendingLoot.t) > 1.0 then
		L.lootPhase = { pos = L.pendingLoot.pos, t0 = Y, last = Y };
		L.pendingLoot = nil;
		X.notify("boss down, collecting drops", 3);
	end;
	if L.lootPhase then
		X.mark("bossloot");
		local v = L.lootPhase;
		if Y - ((v.scanT or 0)) < .25 then
			X.travelTo(v.pos, Y);
			return;
		end;
		v.scanT = Y;
		local c = X.lootNear(v.pos, 90);
		local q, g = {}, {};
		for Y = 1, #c, 1 do
			if c[Y].tap then
				q[#q + 1] = c[Y];
			else
				g[#g + 1] = c[Y];
			end;
		end;
		if #q > 0 or #g > 0 then
			v.sawChest = true;
		end;
		if #q > 0 then
			v.last = Y;
			X.collectStart(q, "boss chest");
			return;
		end;
		if #g > 0 and ((v.passes or 0)) < 4 then
			v.last = Y;
			v.passes = ((v.passes or 0)) + 1;
			if X.routeStart(g) then
				return;
			end;
		end;
		local e = (Y - v.last) > L.LootWait;
		if not v.sawChest then
			e = (Y - v.t0) > 25;
		end;
		if (Y - v.t0) > 60 then
			e = true;
		end;
		if e then
			if not v.sawChest then
				X.notify("no boss chest appeared, moving on", 4);
			end;
			L.lootPhase = nil;
			X.notify("drops done, next boss", 2);
		else
			X.travelTo(v.pos, Y);
			return;
		end;
	end;
	if Y - eC.key >= .1 then
		eC.key = Y;
		if iskeypressed and iskeypressed(L.PanicVK) then
			if L.Mode ~= "off" or L.AutoTrain or L.collect then
				X.panic();
			end;
		end;
	end;
	pcall(X.dlgRelease, Y);
	if L.follow and not L.cur then
		pcall(X.followStep, Y);
	end;
	if L.Mode ~= "off" and (L.cur and X.npcAlive(L.cur)) then
		pcall(X.steer);
		pcall(X.attack, Y);
		local v;
		pcall(function()
			local Y = L.cur;
			local c = Y.Head;
			if c and not X.attached(c, Y.MAddr) then
				c = nil;
				Y.Head = false;
			end;
			v = (c and c.Position) or Y.Root.Position;
		end);
		pcall(X.aimStep, v);
		local c, q = X.char();
		if q and v then
			local c = ((v - q.Position)).Magnitude;
			pcall(X.skillStep, Y, c);
		end;
	else
		X.aimRelease();
		pcall(X.clickRelease);
		pcall(X.skillsRelease);
	end;
	if Y - eC.farm >= L.AttackDelay then
		eC.farm = Y;
		X.mark("farm/" .. tostring(L.Mode));
		pcall(LC, Y);
	end;
	if X.espOn() and Y - eC.esp >= .35 then
		eC.esp = Y;
		X.mark("espbuild");
		pcall(X.espBuild);
	end;
	if L.AutoTrain and (not L.AutoFish and (not L.collect and Y - eC.train >= 1.5)) then
		eC.train = Y;
		pcall(function()
			local c = v:FindFirstChild("Player_Service");
			local q = c and c:FindFirstChild("Values");
			local e = q and q:FindFirstChild(g.Name);
			if not e then
				return;
			end;
			if e:FindFirstChild("Training") then
				if X.remote then
					X.remote:FireServer("training_signaler", "Stop", true);
				else
					L.trainSince = L.trainSince or Y;
					local v = L.bar;
					if not ((v and v.active)) and (Y - L.trainSince > 5 and Y - ((L.trainWarn or 0)) > 30) then
						L.trainWarn = Y;
						X.notify("click mode only plays the Squat bar - finish this station yourself", 6);
					end;
				end;
			else
				L.trainSince = nil;
			end;
		end);
	end;
	if L.NoClip and Y - eC.clip >= .25 then
		eC.clip = Y;
		pcall(function()
			local Y = g.Character;
			if not Y then
				return;
			end;
			local v = Y:GetChildren();
			for Y = 1, #v, 1 do
				local c = v[Y];
				if ((c.ClassName == "Part" or c.ClassName == "MeshPart")) and c.Name ~= "HumanoidRootPart" then
					c.CanCollide = false;
				end;
			end;
		end);
	end;
	if L.Mode ~= "off" and (Y - ((eC.survey or 0))) > 10 then
		eC.survey = Y;
		pcall(function()
			X.scan(nil, nil);
		end);
	end;
	pcall(X.seenSave, Y);
	if L.AntiAFK and Y - eC.afk >= 120 then
		eC.afk = Y;
		pcall(function()
			mousemoverel(2, 0);
			mousemoverel(-2, 0);
		end);
	end;
end;
function X.farming()
	return L.Mode ~= "off" or L.lootPhase ~= nil or L.pendingLoot ~= nil;
end;
function X.busy()
	return L.Mode ~= "off" or L.collect ~= nil or L.route ~= nil or L.lootPhase ~= nil or L.pendingLoot ~= nil or L.AutoTrain or L.NoClip or L.AntiAFK or X.espOn();
end;
function X.sync()
	X.espSync();
	pcall(X.fishSync);
	pcall(X.syncSkills);
	if X.busy() then
		if not L.tickConn then
			L.tickConn = c.Heartbeat:Connect(function()
					local Y, v = pcall(rC);
					if not Y then
						X.logErr("tick", v);
					end;
				end);
		end;
	elseif L.tickConn then
		pcall(function()
			L.tickConn:Disconnect();
		end);
		L.tickConn = nil;
		X.aimRelease();
		pcall(X.clickRelease);
		pcall(X.skillsRelease);
		L.cur = nil;
		X.dropCache();
	end;
end;
pcall(X.markPrev);
pcall(X.seenLoad);
pcall(function()
	a:LoadSettings();
end);
X.sync();
