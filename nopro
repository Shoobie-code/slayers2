-- Handles kept across frames. Once Roblox removes an instance it frees it a
-- little later, and a read through a freed handle can take Matcha down with it
-- - pcall does not help, it is not a Lua error. The odds per read are small,
-- which is why it shows up as a crash every few hours of farming rather than
-- straight away. So a kept handle is only read while it is watched: checked
-- (still under the parent it was found under, compared by address so a freed
-- block reused for something else fails too) every time it is used, and let go
-- without touching it again once it has gone unchecked for too long.
local WATCH_GAP = 0.25

function F.addr(inst)
    local ok, a = pcall(function() return inst.Address end)
    if ok and type(a) == "number" then return a end
    return nil
end

function F.attached(inst, parentAddr)
    if inst == nil then return false end
    local ok, yes = pcall(function()
        local p = inst.Parent
        if p == nil then return false end
        if parentAddr == nil then return true end
        return p.Address == parentAddr
    end)
    return ok and yes == true
end

-- A scan entry's model is still spawned. "dead" = seen removed, "stale" = not
-- watched for longer than maxGap, so it is not safe to look at any more.
function F.npcAlive(e, maxGap)
    if not e or e.dead or e.stale then return false end
    local now = os.clock()
    local gap = now - (e.chkT or 0)
    if gap < 0.005 then return true end             -- already checked this frame
    if gap > (maxGap or WATCH_GAP) then e.stale = true return false end
    if F.attached(e.Model, e.PAddr) then e.chkT = now return true end
    e.dead = true
    return false
end

-- The locked target is different from every other entry: it is steered at,
-- aimed at and swung at every single frame, so a handle that has been freed gets
-- read dozens of times rather than once. This is the strict check for it - the
-- model is found again by address in a listing walked fresh from the workspace,
-- and its parts are re-pointed at handles from that same walk. Nothing of the
-- old handle is read, not even .Parent, because that read is itself the one that
-- takes the process down (tests/test_s2_handles.py "instantnpc").
--
-- It costs about seven lookups and runs once a frame: holding the answer for
-- longer was measurably worse, because the reads it then allowed (Root.Position,
-- Head.Position, several per frame) went through the freed handle instead of the
-- single .Parent read it was replacing.
function F.curAlive(e)
    if not e or e.dead then return false end
    if not (e.Src and e.Region and e.IAddr and e.MAddr) then
        return F.npcAlive(e)        -- an entry from elsewhere: old rules
    end
    local now = os.clock()
    if now - (e.freshT or 0) < 0.005 then return true end   -- already this frame
    local root = WS:FindFirstChild(e.Src)
    local reg = root and root:FindFirstChild("Regions")
    local r = reg and reg:FindFirstChild(e.Region)
    local act = r and r:FindFirstChild("ActiveNpcs")
    local item = act and F.refind(act, e.IAddr)
    local model = item and ((e.IAddr == e.MAddr) and item or F.refind(item, e.MAddr))
    if not model then e.dead = true return false end
    e.freshT, e.chkT = now, now
    e.Model = model
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if hrp then e.Root = hrp end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then e.Hum = hum end
    e.Head = model:FindFirstChild("Head") or false
    return true
end

-- Matcha charges ~0.3ms per FindFirstChild, so the name test (free) runs
-- before anything is resolved. Only matching npcs cost tree lookups.
local playerNames = {}
function F.refreshPlayers()
    playerNames = {}
    local ps = Players:GetPlayers()
    for i = 1, #ps do playerNames[ps[i].Name] = true end
end
F.refreshPlayers()

function F.isBoss(item)
    if item:FindFirstChild("BossInfo") then return true end
    return DB.BossNames[string.lower(item.Name)] == true
end

-- every live npc: { Model, Hum, Root, Name, Boss }
function F.scan(want, wantBoss, exact)
    F.mark("scan/walk")
    local out = {}
    -- want may be a string, nil for "every npc", or a set of exact lowercase
    -- names when several targets are being hunted at once
    local wantSet = nil
    if type(want) == "table" then
        wantSet = want
        want = nil
    end
    local lowWant = want and string.lower(want) or nil
    local all = (not wantSet) and
        ((want == nil) or (want == "All Regular Mobs") or (want == "All Bosses"))
    local roots = { WS:FindFirstChild("Humanoids"), WS:FindFirstChild("Debree") }
    for ri = 1, #roots do
        local reg = roots[ri] and roots[ri]:FindFirstChild("Regions")
        if reg then
            local regs = reg:GetChildren()
            for i = 1, #regs do
                local act = regs[i]:FindFirstChild("ActiveNpcs")
                if act then
                    local items = act:GetChildren()
                    for j = 1, #items do
                        local item = items[j]
                        local nm = item.Name
                        -- free rejects first: player rigs and name mismatches
                        if not playerNames[nm] then
                            local hit = false
                            if wantSet then
                                hit = wantSet[string.lower(nm)] == true
                            elseif all then
                                hit = true
                            elseif lowWant then
                                local low = string.lower(nm)
                                if exact then
                                    -- boss mode: "Kaiden" must not pull in
                                    -- "Kaiden Guard" or "Kaiden Subordinate"
                                    hit = (low == lowWant)
                                else
                                    hit = (low == lowWant) or (string.find(low, lowWant, 1, true) ~= nil)
                                end
                            end
                            if hit then
                                local boss = F.isBoss(item)
                                if exact and wantBoss and not boss then hit = false end
                            end
                            if hit then
                                local boss = F.isBoss(item)
                                if wantBoss == nil or not all or wantBoss == boss then
                                    local m = item:FindFirstChild(nm) or item:FindFirstChildOfClass("Model")
                                    if m then
                                        local hum = m:FindFirstChildOfClass("Humanoid")
                                        local root = m:FindFirstChild("HumanoidRootPart")
                                        if hum and root and hum.Health > 0 then
                                            local e = { Model = m, Hum = hum, Root = root, Name = nm, Boss = boss }
                                            e.exactName = lowWant ~= nil and string.lower(nm) == lowWant
                                            -- see F.npcAlive: the folder the model hangs
                                            -- under, and when it was last seen there
                                            e.PAddr = F.addr(item)
                                            -- how F.curAlive finds this npc again
                                            -- without touching a stored handle
                                            e.IAddr = e.PAddr
                                            e.MAddr = F.addr(m)
                                            e.Src = roots[ri] and roots[ri].Name or nil
                                            e.Region = regs[i].Name
                                            e.chkT = os.clock()
                                            out[#out + 1] = e
                                            pcall(function() F.noteSeen(nm, root.Position) end)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    -- "Bandit" means the mobs actually called Bandit, not Karu Village Bandit
    -- or Iceveil Road Bandit: the loose match is only a fallback
    F.mark("scan/done")
    if lowWant and not exact then
        local same = {}
        for i = 1, #out do
            if out[i].exactName then same[#same + 1] = out[i] end
        end
        if #same > 0 then return same end
    end
    return out
end

-- one shared, time-boxed scan for every consumer
local sc = { key = "", t = -99, list = {} }
function F.setKey(t)
    local names = {}
    for k in pairs(t) do names[#names + 1] = k end
    table.sort(names)
    return table.concat(names, "|")
end

function F.scanCached(want, wantBoss, now, maxAge, exact)
    local key
    if type(want) == "table" then key = F.setKey(want) else key = tostring(want) end
    key = key .. tostring(wantBoss) .. tostring(exact)
    if sc.key == key and (now - sc.t) < (maxAge or 1.0) then return sc.list end
    sc.key = key
    sc.t = now
    sc.list = F.scan(want, wantBoss, exact)
    return sc.list
end

function F.dropCache()
    sc.key = ""
    sc.t = -99
end

-- The ticked bosses as a lowercase set. "All Bosses" expands to every boss
-- rather than being passed on as a name, which is what stopped it from
-- rotating between boss locations.
function F.bossSet()
    local sel = S.SelectedBoss
    local wantAll = false
    local out, n = {}, 0
    if type(sel) == "string" then
        if sel == "All Bosses" then wantAll = true
        else out[string.lower(sel)] = true n = 1 end
    else
        for name, on in pairs(sel or {}) do
            if on then
                if name == "All Bosses" then wantAll = true
                else out[string.lower(name)] = true n = n + 1 end
            end
        end
    end
    if wantAll then
        out, n = {}, 0
        for i = 1, #DB.Bosses do
            local b = DB.Bosses[i]
            if b ~= "All Bosses" then
                out[string.lower(b)] = true
                n = n + 1
            end
        end
    end
    if n == 0 then return nil, false end
    return out, wantAll
end

function F.updateBossOrder(v)
    local on = {}
    if type(v) == "table" then
        for k, x in pairs(v) do if x then on[k] = true end end
    elseif type(v) == "string" then
        on[v] = true
    end
    local order = {}
    if on["All Bosses"] then
        for _, b in ipairs(DB.Bosses) do
            if b ~= "All Bosses" then order[#order + 1] = b end
        end
    else
        for _, b in ipairs(S.BossOrder or {}) do
            if on[b] then order[#order + 1] = b on[b] = nil end
        end
        for _, b in ipairs(DB.Bosses) do          -- newly ticked go to the back
            if on[b] then order[#order + 1] = b end
        end
    end
    S.BossOrder = order
    S.spawnIdx = 0
end

function F.bossLabel()
    local set, wantAll = F.bossSet()
    if wantAll then return "all bosses" end
    if not set then return "none selected" end
    local names = {}
    for k in pairs(set) do names[#names + 1] = k end
    table.sort(names)
    return table.concat(names, ", ")
end

-- spawn point to travel to when nothing is up; rotates across a set
-- Several inherited coordinates are copy-paste guesses shared by different
-- bosses: Nezura carried Sumari's spot, and seven bosses shared one arena
-- coordinate that a learned Zentaro position later contradicted. A coordinate
-- claimed by more than one name is therefore not trusted for travel - a live
-- sighting is, and the script records those as it goes.
-- coordinates that really are one arena for several bosses
DB.SharedOK = { ["-2627,-192"] = true, ["485,-1814"] = true }

local shared = {}
do
    -- distinct NAMES per coordinate: the same boss listed in both tables at the
    -- same spot is not a conflict, two different bosses at one spot is
    local names = {}
    for _, t in ipairs({ DB.Spawns, DB.BossTP }) do
        for name, v in pairs(t) do
            local k = math.floor(v.X) .. "," .. math.floor(v.Z)
            names[k] = names[k] or {}
            names[k][string.lower(name)] = true
        end
    end
    for k, set in pairs(names) do
        local n = 0
        for _ in pairs(set) do n = n + 1 end
        if n > 1 and not DB.SharedOK[k] then
            for nm in pairs(set) do shared[nm] = true end
        end
    end
end

local function spawnFor(name)
    local low = string.lower(name)
    local e = S.seen[low]
    if e then return Vector3.new(e[1], e[2], e[3]) end
    if shared[low] then return nil end   -- ambiguous guess, wait to see it live
    -- boss-only arenas live in DB.BossTP; reading only DB.Spawns meant bosses
    -- like Domae or Hand Demon could never be travelled to
    for _, t in ipairs({ DB.Spawns, DB.BossTP }) do
        local v = t[name]
        if v then return v end
        -- callers may pass a lowercased name while the table keys are proper case
        for real, pos in pairs(t) do
            if string.lower(real) == low then return pos end
        end
    end
    return nil
end

function F.wantSpawn(want)
    if type(want) ~= "table" then return spawnFor(want) end
    local names = {}
    if S.Mode == "boss" and S.BossOrder then
        -- travel follows the queue order the bosses were ticked in
        for _, b in ipairs(S.BossOrder) do
            local k = string.lower(b)
            if want[k] and spawnFor(k) then names[#names + 1] = k end
        end
    end
    if #names == 0 then
        for k in pairs(want) do
            if spawnFor(k) then names[#names + 1] = k end   -- only ones we can reach
        end
        table.sort(names)
    end
    if #names == 0 then return nil end
    S.spawnIdx = (S.spawnIdx or 0) % #names + 1
    return spawnFor(names[S.spawnIdx])
end

local SEEN_FILE = "slayers2_seen.json"

function F.seenLoad()
    local raw
    if not pcall(function() raw = readfile(SEEN_FILE) end) or type(raw) ~= "string" then return end
    local ok, t = pcall(function()
        return game:GetService("HttpService"):JSONDecode(raw)
    end)
    if ok and type(t) == "table" then S.seen = t end
end

function F.seenSave(now)
    if not S.seenDirty then return end
    if now and (now - (S.seenT or 0)) < 30 then return end
    S.seenT = now or 0
    S.seenDirty = false
    pcall(function()
        writefile(SEEN_FILE, game:GetService("HttpService"):JSONEncode(S.seen))
    end)
end

function F.noteSeen(name, pos)
    local k = string.lower(name)
    local e = S.seen[k]
    if e and math.abs(e[1] - pos.X) < 8 and math.abs(e[3] - pos.Z) < 8 then return end
    S.seen[k] = { pos.X, pos.Y, pos.Z }
    S.seenDirty = true
end

-- list comes from F.scan, possibly cached: entries whose model has despawned
-- since are skipped without reading through them
function F.nearest(list, from)
    local best, bd = nil, 1e9
    for i = 1, #list do
        local e = list[i]
        if F.npcAlive(e, 0.6) then
            local ok, p = pcall(function() return e.Root.Position end)
            if ok and p then
                local d = (p - from).Magnitude
                if d < bd then bd = d best = e end
            end
        end
    end
    return best, bd
end

function F.tpTo(pos, yOff)
    local _, hrp = F.char()
    if not hrp or not pos then return false end
    pcall(function()
        hrp.CFrame = CFrame.new(pos.X, pos.Y + (yOff or 2.5), pos.Z)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end)
    return true
end

-- find a named thing live before falling back to a stored coordinate
-- where a named npc (quest giver, trainer, boss) currently stands, or nil
function F.findNamed(name)
    local low = string.lower(name or "")
    if low == "" then return nil end
    -- exact name first, then substring: "Tom" must not land on "Wounded Slayer Tomoi"
    local partial = nil
    local roots = { WS:FindFirstChild("Humanoids"), WS:FindFirstChild("Debree") }
    for ri = 1, #roots do
        local reg = roots[ri] and roots[ri]:FindFirstChild("Regions")
        if reg then
            for _, r in ipairs(reg:GetChildren()) do
                for _, bucket in ipairs({ r:FindFirstChild("ActiveNpcs"), r:FindFirstChild("StationaryNpcs") }) do
                    for _, item in ipairs(bucket and bucket:GetChildren() or {}) do
                        local ln = string.lower(item.Name)
                        local exact = (ln == low)
                        if exact or (not partial and string.find(ln, low, 1, true)) then
                            local m = item:FindFirstChildOfClass("Model") or item
                            local rp = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
                            if rp then
                                if exact then return rp.Position end
                                partial = rp.Position
                            end
                        end
                    end
                end
            end
        end
    end
    return partial
end

-- cached for a couple of seconds: the walk touches every npc folder
function F.npcPos(name, now, maxAge)
    local c = S.npcPosCache[name]
    if c and (now - c.t) < (maxAge or 2.0) then return c.pos end
    local pos = F.findNamed(name)
    S.npcPosCache[name] = { pos = pos, t = now }
    return pos
end

-- Ask to stand next to an npc. The heartbeat steers there every frame while
-- the request is fresh, so a giver who walks around (Niko, Ren) is followed
-- instead of re-teleported. Returns the flat distance to the npc right now.
function F.followNpc(name, fallback, now)
    local _, hrp = F.char()
    local pos = F.npcPos(name, now, 0.1) or fallback
    local fl = S.follow
    if fl and fl.name == name then
        fl.t = now fl.fb = fallback          -- keep the speed estimate
    else
        S.follow = { name = name, fb = fallback, t = now }
    end
    if not hrp or not pos then return math.huge end
    local p = hrp.Position
    local fx, fz = p.X - pos.X, p.Z - pos.Z
    local flat = math.sqrt(fx * fx + fz * fz)
    if math.abs(p.Y - pos.Y) > 15 then return math.max(flat, 99) end
    return flat
end

function F.followStep(now)
    local fl = S.follow
    if not fl then return end
    if now - fl.t > 0.6 then S.follow = nil return end   -- nobody asked lately
    local _, hrp = F.char()
    local pos = F.npcPos(fl.name, now, 0.1) or fl.fb
    if not hrp or not pos then return end
    -- the npc's walking velocity, from its last two sightings, so we keep
    -- pace instead of trailing behind
    if fl.lastPos and fl.lastPos ~= pos then
        local dt = now - (fl.lastT or now)
        if dt > 0.02 then
            local vx, vz = (pos.X - fl.lastPos.X) / dt, (pos.Z - fl.lastPos.Z) / dt
            if vx * vx + vz * vz < 900 then fl.vx, fl.vz = vx, vz end   -- ignore warps
            fl.lastPos, fl.lastT = pos, now
        end
    elseif not fl.lastPos then
        fl.lastPos, fl.lastT = pos, now
    end
    local vx, vz = fl.vx or 0, fl.vz or 0
    -- look at them on the way in (not during a conversation: aiming holds the
    -- right button, which hides the cursor and blocks the answer clicks)
    if S.dlg or (S.dlgClick ~= nil) then
        F.aimRelease()
    else
        pcall(F.aimStep, Vector3.new(pos.X, pos.Y + 2, pos.Z), true)
    end
    local p = hrp.Position
    local fx, fz = p.X - pos.X, p.Z - pos.Z
    local flat = math.sqrt(fx * fx + fz * fz)
    -- stand 2.5 studs off the npc on our side, a little ahead of where it walks
    local ux, uz = 1, 0
    if flat > 0.5 then ux, uz = fx / flat, fz / flat end
    local gx = pos.X + ux * 2.5 + vx * 0.2
    local gz = pos.Z + uz * 2.5 + vz * 0.2
    local dx, dy, dz = gx - p.X, pos.Y - p.Y, gz - p.Z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
    if dist > S.WarpAbove then
        F.travelTo(Vector3.new(gx, pos.Y - 3, gz), now)   -- travelTo adds 3
        return
    end
    -- match its pace, then close the gap
    local cx, cy, cz = vx + dx * 6, dy * 6, vz + dz * 6
    local sp = math.sqrt(cx * cx + cy * cy + cz * cz)
    if sp > S.MoveSpeed then
        local k = S.MoveSpeed / sp
        cx, cy, cz = cx * k, cy * k, cz * k
    end
    if dist < 0.6 and vx * vx + vz * vz < 1 then cx, cy, cz = 0, 0, 0 end
    pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(cx, cy, cz) end)
end

