-- Only the Muzan who walks the villages. The lair copy (Debree.MuzanLairModel)
-- is ignored: it is the lair entrance, not him on the map.
function F.muzanSpots()
    local out = {}
    for _, hroot in ipairs({ WS:FindFirstChild("Humanoids"), WS:FindFirstChild("Debree") }) do
        local regs = hroot and hroot:FindFirstChild("Regions")
        for _, r in ipairs(regs and regs:GetChildren() or {}) do
            for _, bucket in ipairs({ r:FindFirstChild("ActiveNpcs"), r:FindFirstChild("StationaryNpcs") }) do
                for _, f in ipairs(bucket and bucket:GetChildren() or {}) do
                    if string.find(string.lower(f.Name), "muzan", 1, true) then
                        -- his folder IS the body: root part sits on it directly
                        local m = f:FindFirstChild(f.Name) or f:FindFirstChildOfClass("Model")
                        local root = f:FindFirstChild("HumanoidRootPart")
                                     or (m and m:FindFirstChild("HumanoidRootPart"))
                                     or f:FindFirstChildWhichIsA("BasePart")
                        local pos
                        if root then pcall(function() pos = root.Position end) end
                        out[#out + 1] = { name = f.Name, pos = pos, region = r.Name, npc = true }
                    end
                end
            end
        end
    end
    return out
end

-- The walking Muzan is the target here; the lair statue is only mentioned.
function F.findMuzan(tp)
    local _, hrp = F.char()
    local best, bd
    for _, sp in ipairs(F.muzanSpots()) do
        local d = (hrp and sp.pos) and (sp.pos - hrp.Position).Magnitude or nil
        if not best or (d and bd and d < bd) then best, bd = sp, d end
    end
    if best and best.pos then
        if tp then
            F.tpTo(Vector3.new(best.pos.X + 5, best.pos.Y, best.pos.Z), 3)
            F.notify("at muzan" .. (best.region and " (" .. best.region .. ")" or ""), 4)
        else
            F.notify(string.format("muzan at %d, %d, %d - %d studs", best.pos.X, best.pos.Y, best.pos.Z, bd or 0), 6)
        end
        return best
    end
    if best then
        F.notify("muzan is walking in " .. tostring(best.region) .. " - travel there to see him", 6)
        return best
    end
    -- not walking anywhere: stand on his patrol and wait, and say where the
    -- lair copy is if it is up
    local near, nd
    for _, wp in ipairs(DB.MuzanRoute) do
        local d = hrp and (wp - hrp.Position).Magnitude or 0
        if not nd or d < nd then near, nd = wp, d end
    end
    if tp and near then F.tpTo(near, 3) end
    F.notify("muzan is not walking the map - waiting spot set on his patrol route", 6)
    return nil
end

-- The Black Marketer stands at one of two spawns (Npcs.Black Marketer) and
-- only streams in nearby: try each spawn, then stand next to him.
DB.BlackMarketer = { Vector3.new(-132.68, 804, 101.24), Vector3.new(2161.96, 823.46, -900.68) }
function F.bmBeside(pos)
    F.tpTo(Vector3.new(pos.X + 4, pos.Y, pos.Z), 2.5)
    F.notify("at the Black Marketer", 3)
end

-- Walks the spawns until he streams in. A step of the tick rather than a
-- connection of its own, so starting it never connects anything.
function F.tpBlackMarketer()
    local live = F.findNamed("Black Marketer")
    if live then F.bmBeside(live) return end
    S.bm = { i = 1, t = os.clock() }
    F.tpTo(DB.BlackMarketer[1], 3)
    F.sync()
end

function F.bmStep(now)
    local b = S.bm
    if not b then return end
    if now - b.t < 1.5 then return end        -- let the area stream in
    local pos = F.findNamed("Black Marketer")
    if pos then
        S.bm = nil
        F.bmBeside(pos)
        F.sync()
    elseif b.i < #DB.BlackMarketer then
        b.i = b.i + 1
        b.t = now
        F.tpTo(DB.BlackMarketer[b.i], 3)
    else
        S.bm = nil
        F.notify("Black Marketer not at either spawn", 4)
        F.sync()
    end
end

function F.tpNamed(name, fallback)
    local found = F.findNamed(name)
    local target = found or fallback
    if target then
        F.tpTo(target, 2.5)
        F.notify((found and "Reached " or "Teleported to ") .. name, 2)
    else
        F.notify("No location for " .. tostring(name), 2)
    end
end

