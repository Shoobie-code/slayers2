function F.panic()
    S.Mode = "off"
    S.AutoTrain = false
    S.AutoFish = false
    pcall(function()
        win:SetValue("autofarm", false)
        win:SetValue("autotrain", false)
        win:SetValue("autofish", false)
    end)
    pcall(F.fishSync)
    pcall(F.skillsRelease)
    pcall(function() keyrelease(84) end)
    S.cur = nil
    F.aimRelease()
    pcall(F.clickRelease)
    pcall(F.skillsRelease)
    S.pendingLoot = nil
    S.lootPhase = nil
    S.follow = nil
    S.dlg = nil
    S.soul = nil
    S.crow = nil
    S.dungeon = nil
    F.unlockStop()
    F.routeStop()
    F.collectStop()
    F.dropCache()
    F.sync()
    F.notify("stopped", 3)
end


----------------------------------------------------------------------
-- scheduler: one Heartbeat, every job gated on elapsed time
----------------------------------------------------------------------
local T = { farm = 0, esp = 0, chest = 0, train = 0, clip = 0, afk = 0, zx = 0, guard = 0, key = 0, soul = 0 }

local function farmStep(now)
    if S.Mode == "off" then return end
    local ch, hrp, hum = F.char()
    if not ch or hum.Health <= 0 then return end

    if S.HealthGuard and hum.Health < hum.MaxHealth * S.GuardPct then
        if now - T.guard > 1 then
            T.guard = now
            pcall(function()
                hrp.CFrame = hrp.CFrame + Vector3.new(0, 60, 0)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end)
        end
        return
    end

    local want, wantBoss
    if S.Mode == "mob" then
        want, wantBoss = S.SelectedMob, false
    elseif S.Mode == "crow" then
        local boss = F.crowStep(now)
        if not boss then
            if S.cur then S.cur = nil F.aimRelease() end
            return
        end
        want, wantBoss = boss, true
    elseif S.Mode == "boss" then
        local set = F.bossSet()
        want, wantBoss = (set or "All Bosses"), true
    elseif S.Mode == "dungeon" then
        F.mark("dungeon")
        if F.dungeonStep(now) then
            if S.cur then S.cur = nil F.aimRelease() end
            return
        end
        want, wantBoss = "__dungeon", nil
    else
        local q = F.activeQuest()
        if not q then
            -- No quest: walk to the giver and ask for it the way the game's own
            -- Dialogue module does, ToServer("AddQuest", <option text>).
            -- the quest that just ended goes to the back of the rotation
            if S.questInfoKey then
                S.lastDoneKey = S.questInfoKey
                S.questInfoKey = nil
            end
            local info, qkey = F.pickQuest(now)
            if not info then
                local _, soon = F.pickQuest(now)
                if S.cur then S.cur = nil F.aimRelease() end
                if now - (T.qwarn or 0) > 12 then
                    T.qwarn = now
                    if soon then
                        F.notify("ticked quests cooling down - retry in " .. math.ceil(soon - now) .. "s", 5)
                    else
                        F.notify("no quest to take - tick some in the quest list (or they are all done)", 6)
                    end
                end
                return
            end
            if S.acceptKey ~= qkey then
                S.acceptKey = qkey
                S.acceptTries = 0
                S.acceptAt = nil
                S.atGiver = false
            end
            if info and info.AutoDeliver then
                local g, soonest = F.pickDelivery(now)
                if not g then
                    if S.cur then S.cur = nil F.aimRelease() end
                    -- cooling down: keep walking with the next giver so the
                    -- accept goes out the moment the gap is over
                    if soonest then
                        for _, dg in ipairs(DB.DeliverGivers) do
                            if not F.questCompleted(dg.QuestOption) then
                                F.followNpc(dg.Npc, dg.Pos, now)
                                break
                            end
                        end
                    end
                    if now - (T.qwarn or 0) > 15 then
                        T.qwarn = now
                        if soonest then
                            F.notify("delivery quests cooling down - retry in " .. math.ceil(soonest - now) .. "s", 5)
                        else
                            F.notify("every delivery quest is done", 6)
                        end
                    end
                    return
                end
                if S.delivGiver ~= g.QuestOption then
                    S.delivGiver = g.QuestOption
                    S.acceptTries = 0
                    S.acceptAt = nil
                    S.atGiver = false
                end
                -- a fresh round after a backoff gets its full set of tries
                if not (S.delivSent and S.delivSent[g.QuestOption]) then S.acceptTries = 0 end
                info = g
            end
            if not (info and info.Pos) then
                if now - (T.qwarn or 0) > 8 then
                    T.qwarn = now
                    F.notify("no active quest - pick one in the quest list to accept it", 5)
                end
                return
            end
            -- drop the last farm target: the per-frame steer was still flying
            -- back to it while this warped to the giver, so it ping-ponged
            if S.cur then S.cur = nil F.aimRelease() pcall(F.skillsRelease) if F.clickRelease then pcall(F.clickRelease) end end
            -- walk up to the giver like a farm target, following it if it
            -- wanders; the heartbeat does the steering
            local flat = F.followNpc(info.Npc, info.Pos, now)
            local limit = S.atGiver and 12 or 8
            if flat > limit then
                S.atGiver = false
                S.acceptAt = nil
                return
            end
            S.atGiver = true
            local opt = F.questOpt(info)
            if not opt then
                if now - (T.qwarn or 0) > 8 then
                    T.qwarn = now
                    F.notify("at " .. tostring(info.Npc) .. ": this quest has no " .. S.QuestPick .. " option", 5)
                end
                return
            end
            if F.questCompleted(opt) then
                if now - (T.qwarn or 0) > 10 then
                    T.qwarn = now
                    F.notify("already completed: " .. opt .. " - pick another quest", 6)
                end
                return
            end
            -- let the server see us standing at the npc first
            S.acceptAt = S.acceptAt or (now + S.SettleT)
            if now < S.acceptAt then return end
            -- The cooldown runs between two accepts (~30s): timed from the
            -- moment the last quest showed up. LastTime is stamped by refused
            -- accepts too, so it is only the fallback.
            S.hadQuest = false
            local age = S.lastAcceptAt and (now - S.lastAcceptAt)
            if not age and info.QuestOption then
                local la = F.questLastAge()
                if la then age = la end
            end
            if age and age < S.QuestGap then
                if now - (T.qwarn or 0) > 10 then
                    T.qwarn = now
                    F.notify("next quest in " .. math.ceil(S.QuestGap - age) .. "s", 3)
                end
                return
            end
            if not F.remote then
                -- click build: open the npc's dialogue and click the option
                local st = F.dlgTalk(opt, now)
                if st == "failed" and now - (T.qwarn or 0) > 12 then
                    T.qwarn = now
                    F.notify("could not take '" .. opt .. "' from " .. tostring(info.Npc) .. " - do it by hand", 6)
                end
                return
            end
            if F.remote and (now - (T.accept or 0)) > 8 then
                T.accept = now
                S.acceptTries = (S.acceptTries or 0) + 1
                if S.acceptTries > 3 then
                    -- requirements, level or the quest limit: the server said
                    -- no, so move on to the next ticked quest for a while
                    if now - (T.qwarn or 0) > 10 then
                        T.qwarn = now
                        F.notify("server keeps refusing '" .. opt .. "' (level or quest limit?) - skipping it", 6)
                    end
                    if qkey then
                        S.qBack = S.qBack or {}
                        S.qBack[qkey] = now + 120
                    end
                    S.acceptTries = 0
                    return
                end
                pcall(function() F.remote:FireServer("AddQuest", opt) end)
                if qkey and not info.AutoDeliver then
                    S.qSent = S.qSent or {}
                    S.qSent[qkey] = S.qSent[qkey] or now
                end
                if info.QuestOption == opt and DB.DeliverGivers then
                    S.delivSent = S.delivSent or {}
                    S.delivSent[opt] = S.delivSent[opt] or now
                end
                F.notify("accepting: " .. opt, 3)
            end
            return
        end
        S.acceptAt = nil
        S.acceptTries = 0
        S.atGiver = false
        S.dlg = nil
        -- first sight of a new quest = the moment it was accepted
        if not S.hadQuest then S.lastAcceptAt = now end
        S.hadQuest = true
        if q.Desc and S.delivSent then
            S.delivSent[q.Desc] = nil
            if S.delivFails then S.delivFails[q.Desc] = nil end
        end
        local qinfo, qinfoKey = F.entryForQuest(q)
        S.questInfo = qinfo
        S.questDesc = q.Desc
        S.questInfoKey = qinfoKey
        if qinfoKey and S.qSent then S.qSent[qinfoKey] = nil end
        if qinfoKey and S.qBack then S.qBack[qinfoKey] = nil end
        if q.Complete then
            -- go hand it in once, then stay put rather than re-warping every tick
            if S.cur then S.cur = nil F.aimRelease() pcall(F.skillsRelease) if F.clickRelease then pcall(F.clickRelease) end end
            local info = qinfo
            if info and info.Pos then
                F.followNpc(info.Npc, info.Pos, now)
            end
            return
        end
        -- What the quest actually says beats whatever is picked in the
        -- dropdown, so leaving it on the wrong entry no longer farms the
        -- wrong mob. The registry is only a fallback for quests whose text
        -- names no mob.
        local info = qinfo

        -- what the outstanding task actually asks for
        local pending
        for i = 1, #q.Tasks do
            if (q.Tasks[i].Value or 0) < (q.Tasks[i].Max or 1) then
                pending = q.Tasks[i]
                break
            end
        end
        -- hand-in / delivery step: teleport beside the npc and send what the
        -- dialogue answer would
        local dq = DB.Deliver[q.Name]
        local dt = dq and pending and dq.tasks[pending.Name]
        if dt then
            F.deliverStep(dq.opt, pending.Name, dt, hrp, now)
            return
        end
        S.deliverKey = nil
        local kind = F.taskKind(pending and pending.Name)

        want = nil
        if kind ~= "fetch" then
            -- The quest's own code and the registry can name different mobs
            -- (Krue's "3 bandits" says KaruVillageBandit while plain Bandits
            -- stand right there), so hunt every candidate and take the nearest.
            local cands = {}
            local function addc(nm)
                if type(nm) == "string" and nm ~= "" then cands[string.lower(nm)] = true end
            end
            addc(F.codeToMob(pending and pending.Code))
            addc(F.questTarget(q))
            if kind == "kill" and info and not info.Auto then
                -- the target belonging to THIS option: the boss quest of an
                -- entry hunts its boss, never the normal quest's mob
                local boss = q.Desc and info.BossOption == q.Desc
                if boss == nil then boss = (S.QuestPick == "boss") end
                addc(boss and (info.BossTarget or info.Target) or info.Target)
            end
            local n = 0
            for _ in pairs(cands) do n = n + 1 end
            if n > 1 then want = cands elseif n == 1 then
                for k in pairs(cands) do want = k end
            end
        end
        if not want then
            -- a prop in the world beats any curated guess
            local ups = F.questPickups()
            if #ups > 0 then
                local items = {}
                for i = 1, #ups do
                    items[#items + 1] = F.pickup(WS, function() return WS end, ups[i].Node, ups[i].Root,
                        nil, { tap = true })
                end
                F.collectStart(items, "quest pickup: " .. ups[1].Name)
                return
            end
            -- the registry's targets are inherited guesses and are simply wrong
            -- for fetch quests, so it only applies to a genuine kill task
            if kind == "kill" and info and not info.Auto and info.Target then
                want = info.Target
            end
        end
        if not want and kind == "fetch" then
            if now - (T.qwarn or 0) > 10 then
                T.qwarn = now
                F.notify("'" .. tostring(pending and pending.Name) ..
                         "' is not a kill objective and no prop is spawned - nothing to farm", 6)
            end
            return
        end
        wantBoss = false
        if not want then
            if now - (T.qwarn or 0) > 8 then
                T.qwarn = now
                F.notify("nothing to farm or pick up in: " .. tostring(q.Name), 5)
            end
            return
        end
    end

    -- Steady state costs two property reads: the locked target is reused
    -- until it dies or the lock ages out, so no tree walk happens per tick.
    local wantKey = (type(want) == "table") and F.setKey(want) or tostring(want)
    local cur = S.cur
    if cur and cur.wantKey == wantKey then
        local hp = nil
        -- A dead boss despawns (or reads 0 health first). Its handle is not
        -- read once the model is gone: that read used to be how a kill was
        -- noticed, and it went through a model Roblox was about to free.
        local alive = F.curAlive(cur) and pcall(function() hp = cur.Hum.Health end)
        -- Either way the fight is over: queue its drops. A target that only
        -- went unwatched while loot or a soul was collected is not a kill; it
        -- is simply looked up again below.
        if not cur.stale and (not alive or not hp or hp <= 0)
           and S.LootBoss and cur.Boss and cur.lastPos and S.Mode ~= "dungeon" then
            S.pendingLoot = { pos = cur.lastPos, t = now }
        end
        if hp and hp > 0 then
            -- the lock holds as long as damage is landing; a target that
            -- stops losing health is unreachable, so let it go and re-pick
            if cur.lastHp == nil or hp < cur.lastHp then
                cur.lastHp = hp
                cur.t = now
            end
            pcall(function() cur.lastPos = cur.Root.Position end)
            if (now - cur.t) < 8.0 then
                F.attack(now)
                return
            end
            F.notify("target stuck, re-picking", 2)
        end
        S.cur = nil
        F.dropCache()
    end

    F.mark("farm/scan")
    local list
    if S.Mode == "dungeon" then
        list = F.dungeonTargets(now)
    else
        list = F.scanCached(want, wantBoss, now, 0.5, S.Mode == "boss" or S.Mode == "crow")
    end
    F.mark("farm/pick n=" .. #list)
    if #list == 0 and S.Mode == "quest" then
        -- the alternate is the normal quest's second-choice mob; a boss quest
        -- must never fall back onto it (Tom's cubs while felling the mother)
        local info = S.questInfo
        local isBossQuest = info and info.BossOption and S.questDesc == info.BossOption
        if info and info.Alt and not isBossQuest then list = F.scan(info.Alt, false) end
    end

    if #list == 0 then
        -- between waves, or a card offer: stay in the dungeon and wait
        if S.Mode == "dungeon" then return end
        if now - T.guard > S.Retarget * 3 then
            T.guard = now
            local dest = F.wantSpawn(want)
            if dest then
                F.tpTo(dest, 3)
            elseif now - (T.nodest or 0) > 12 then
                -- no trustworthy coordinate: say so rather than sitting silent
                T.nodest = now
                local label = (type(want) == "table") and F.bossLabel() or tostring(want)
                F.notify("no known spot for " .. label .. " - find it once and it is remembered", 6)
            end
        end
        return
    end

    local t = F.nearest(list, hrp.Position)
    if not t then
        F.dropCache()   -- everything cached has despawned: scan afresh next pass
        return
    end
    t.want = want
    t.wantKey = wantKey
    t.t = now
    -- the head is looked up once, here, while the model is known to be alive
    if t.Head == nil then
        t.MAddr = F.addr(t.Model)
        pcall(function() t.Head = t.Model:FindFirstChild("Head") or false end)
    end
    S.cur = t
    F.attack(now)
end

local function tick()
    if not S.Running then return end
    local now = os.clock()
    F.markWrite(now)          -- flush what the last tick reached before doing more
    F.mark("tick")
    F.deathCheck(now)

    if S.bm then
        F.mark("blackmarket")
        local ok, err = pcall(F.bmStep, now)
        if not ok then S.bm = nil F.logErr("black marketer", err) end
    end

    if S.unlock then
        F.mark("unlock")
        local ok, busy = pcall(F.unlockStep, now)
        if ok and busy then return end
        if not ok then F.unlockStop() end
    end

    -- a soul despawns fast: claim it before loot, farming or anything else
    if S.AutoSouls and F.farming() and not S.route then
        F.mark("souls")
        local ok, busy = pcall(F.soulStep, now)
        if ok and busy then return end
    end

    -- picking loot up takes priority over farming
    if S.route then
        F.mark("route")
        local ok, busy = pcall(F.routeStep, now)
        if ok and busy then return end
        if not ok then F.routeStop() end
    end
    if S.collect then
        F.mark("collect")
        if pcall(F.collectStep, now) then return end
    end

    -- Background sweep for anything lying around, whatever dropped it.
    if (S.AutoLoot or S.AutoSouls) and F.farming()
       and not S.collect and not S.lootPhase and not S.route
       and (now - (T.loot or 0)) > 2.0 then
        T.loot = now
        local _, hrp = F.char()
        if hrp then
            if S.AutoLoot then
                local items = F.lootNear(hrp.Position, S.LootRange)
                if #items > 0 then F.collectStart(items, "loot") end
            end
        end
    end

    -- A boss chest does not appear instantly, and tapping it produces more
    -- drops, so after a kill this parks at the kill site and keeps sweeping
    -- until nothing new has shown up for "loot wait" seconds. Farming is
    -- blocked for the duration, so it will not wander to the next boss.
    if S.pendingLoot and (now - S.pendingLoot.t) > 1.0 then
        S.lootPhase = { pos = S.pendingLoot.pos, t0 = now, last = now }
        S.pendingLoot = nil
        F.notify("boss down, collecting drops", 3)
    end
    if S.lootPhase then
        F.mark("bossloot")
        local ph = S.lootPhase
        -- The sweep lists two folders and looks inside every chest: run every
        -- frame it was several milliseconds a frame for the whole wait. Four
        -- times a second is plenty to notice a drop.
        if now - (ph.scanT or 0) < 0.25 then
            F.travelTo(ph.pos, now)   -- wait by the body
            return
        end
        ph.scanT = now
        local items = F.lootNear(ph.pos, 90)
        local chests, drops = {}, {}
        for i = 1, #items do
            if items[i].tap then chests[#chests + 1] = items[i] else drops[#drops + 1] = items[i] end
        end
        -- anything found here means the chest has already been and gone
        if #chests > 0 or #drops > 0 then ph.sawChest = true end
        if #chests > 0 then
            ph.last = now
            F.collectStart(chests, "boss chest")
            return
        end
        if #drops > 0 and (ph.passes or 0) < 4 then
            ph.last = now
            ph.passes = (ph.passes or 0) + 1
            if F.routeStart(drops) then return end
        end
        -- Normally this leaves "wait for drops" seconds after the last thing
        -- was picked up. The longer stop is only for a boss whose chest never
        -- showed up at all.
        local quit = (now - ph.last) > S.LootWait
        if not ph.sawChest then quit = (now - ph.t0) > 25 end
        if (now - ph.t0) > 60 then quit = true end
        if quit then
            if not ph.sawChest then F.notify("no boss chest appeared, moving on", 4) end
            S.lootPhase = nil
            F.notify("drops done, next boss", 2)
        else
            F.travelTo(ph.pos, now)   -- wait by the body
            return
        end
    end

    -- iskeypressed is a host round trip; 10 Hz is plenty for a panic key
    if now - T.key >= 0.1 then
        T.key = now
        if iskeypressed and iskeypressed(S.PanicVK) then
            if S.Mode ~= "off" or S.AutoTrain or S.collect then F.panic() end
        end
    end

    -- movement runs every heartbeat: velocity only holds if it is rewritten
    -- each frame, and the attack cadence is far too slow to steer on
    F.mark("dlg")
    pcall(F.dlgRelease, now)
    if S.follow and not S.cur then F.mark("follow") pcall(F.followStep, now) end
    -- A target that despawned is never read again: farmStep sees it gone on
    -- its next pass, queues the drops and picks the next one.
    if S.Mode ~= "off" and S.cur and F.curAlive(S.cur) then
        F.mark("steer")
        pcall(F.steer)
        F.mark("attack")
        pcall(F.attack, now)   -- per frame, so a hold is released on time
        -- aim at the head when there is one, else the root. The head was found
        -- once when the target was picked: looking it up on the model every
        -- frame walked the children of a model that might be gone.
        local tp
        pcall(function()
            local cur = S.cur
            -- head and root were re-pointed by F.curAlive a moment ago
            local h = cur.Head
            tp = (h and h.Position) or cur.Root.Position
        end)
        F.mark("aim")
        pcall(F.aimStep, tp)
        -- skills fire off the same locked target
        local _, myHrp = F.char()
        if myHrp and tp then
            local d = (tp - myHrp.Position).Magnitude
            F.mark("skills")
            pcall(F.skillStep, now, d)
        end
    else
        F.aimRelease()
        pcall(F.clickRelease)
        pcall(F.skillsRelease)
    end

    if now - T.farm >= S.AttackDelay then
        T.farm = now
        F.mark("farm/" .. tostring(S.Mode))
        pcall(farmStep, now)
        F.mark("farm/done")
    end


    if F.espOn() and now - T.esp >= 0.35 then
        T.esp = now
        F.mark("espbuild")
        pcall(F.espBuild)
    end


    if S.AutoTrain and not S.AutoFish and not S.collect and now - T.train >= 1.5 then
        T.train = now
        pcall(function()
            local ps = RS:FindFirstChild("Player_Service")
            local vals = ps and ps:FindFirstChild("Values")
            local mine = vals and vals:FindFirstChild(lp.Name)
            if not mine then return end
            if mine:FindFirstChild("Training") then
                if F.remote then
                    F.remote:FireServer("training_signaler", "Stop", true)
                else
                    -- click mode: only the bar minigame (Squat) is played here
                    S.trainSince = S.trainSince or now
                    local b = S.bar
                    if not (b and b.active) and now - S.trainSince > 5 and now - (S.trainWarn or 0) > 30 then
                        S.trainWarn = now
                        F.notify("click mode only plays the Squat bar - finish this station yourself", 6)
                    end
                end
            else
                -- never presses T: you start a station yourself, auto train
                -- only finishes it
                S.trainSince = nil
            end
        end)
    end

    if S.NoClip and now - T.clip >= 0.25 then
        T.clip = now
        pcall(function()
            local ch = lp.Character
            if not ch then return end
            local kids = ch:GetChildren()
            for i = 1, #kids do
                local p = kids[i]
                if (p.ClassName == "Part" or p.ClassName == "MeshPart") and p.Name ~= "HumanoidRootPart" then
                    p.CanCollide = false
                end
            end
        end)
    end

    -- ~64ms per pass: only worth the hitch while something is being farmed
    if S.Mode ~= "off" and (now - (T.survey or 0)) > 10 then
        T.survey = now
        pcall(function() F.scan(nil, nil) end)   -- noteSeen runs per match
    end

    pcall(F.seenSave, now)

    if S.AntiAFK and now - T.afk >= 120 then
        T.afk = now
        pcall(function()
            mousemoverel(2, 0)
            mousemoverel(-2, 0)
        end)
    end
end

-- Nothing on means no per-frame callback at all: an idle menu costs zero.
-- Auto loot and auto souls are farm companions, not a vacuum that runs on its
-- own: a freshly loaded script has to sit still. Before this, loading with loot
-- pickup saved on started sweeping at once - taking the camera and walking the
-- character off to whatever was lying nearby.
-- Dying mid-fight used to leave keys held (a skill's 3 second hold, T from a
-- pickup, the aim's right button) into the respawn. Checked a few times a
-- second while anything is running; one release per death.
function F.deathCheck(now)
    if now - (S.deathT or 0) < 0.25 then return end
    S.deathT = now
    local _, _, hum = F.char()
    local dead = true
    if hum then pcall(function() dead = hum.Health <= 0 end) end
    if dead and not S.wasDead then
        S.wasDead = true
        pcall(function() mouse1release() end)
        pcall(function() mouse2release() end)
        for _, vk in ipairs({ 70, 84, 90, 88, 67, 86, 66, 78, 75 }) do
            pcall(function() keyrelease(vk) end)
        end
        S.rmbDown, S.lmbDown = false, false
        pcall(F.skillsRelease)
        S.cur, S.collect, S.route, S.soul = nil, nil, nil, nil
        if S.unlock then S.unlock.held = false end
        F.mark("died")
    elseif not dead and S.wasDead then
        S.wasDead = nil
    end
end

function F.farming()
    return S.Mode ~= "off" or S.lootPhase ~= nil or S.pendingLoot ~= nil
end

function F.busy()
    return S.Mode ~= "off" or S.collect ~= nil or S.route ~= nil or S.lootPhase ~= nil
        or S.unlock ~= nil or S.bm ~= nil
        or S.pendingLoot ~= nil or S.AutoTrain or S.NoClip
        or S.AntiAFK or F.espOn()
end

-- Anything may ask for a sync from anywhere; it is applied by F.deferRun.
function F.sync()
    S.syncWant = true
end

function F.syncNow()
    F.espSync()
    pcall(F.fishSync)
    pcall(F.syncSkills)
    if F.busy() then
        S.tickLive = true
    elseif S.tickLive then
        S.tickLive = false
        F.aimRelease()
        pcall(F.clickRelease)
        pcall(F.skillsRelease)
        S.cur = nil
        F.dropCache()
    end
end

-- Every loop this script has is connected here, once, from the body of the
-- load, and switched on and off with a flag after that. Connecting a handler to
-- a signal while that signal is dispatching is what took Matcha down when
-- autofarm was turned on: the toggle ran from the Heartbeat queue and connected
-- the tick to Heartbeat, adding to the very list being walked. Connecting on
-- demand made that possible from a dozen places; connecting nothing after the
-- load makes it impossible. The cost is a flag check per signal fire.
function F.connectLoops()
    S.tickConn = RunService.Heartbeat:Connect(function()
        if not S.tickLive then return end
        local ok, err = pcall(tick)
        if not ok then F.logErr("tick", err) end
    end)
    S.drawConn = RunService.RenderStepped:Connect(F.drawFrame)
    S.fishConn = RunService.RenderStepped:Connect(F.fishFrame)
    S.deferConn = RunService.Heartbeat:Connect(function()
        local ok, err = pcall(F.deferRun)
        if not ok then F.logErr("defer", err) end
    end)
end

-- applied only now: the toggle callbacks below reach F.sync, which is
-- defined above this point but not while the widgets were being built
pcall(F.markPrev)
pcall(F.seenLoad)
pcall(function() win:LoadSettings() end)

-- made here, in the body of the script, where no signal is dispatching; they
-- live for the whole run and are only dropped by the teardown or unload
F.connectLoops()

pcall(F.syncNow)
F.notify("loaded - rshift for the menu", 4)
print("[Slayers 2] loaded")
